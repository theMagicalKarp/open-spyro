/* PARKED 2026-08-19-1 at 1693/1696 insns, MISMATCH 89 over 50 regions with
 * registers anchored (compile-only shape diff -- it does not link, 3 insns short).
 *
 * Fully decoded; every arm is byte-plausible.  What is left is two allocation
 * rotations and three missing constant remats:
 *
 *  1. rec lands in $s3 / POS in $s4; the original has rec in $s4 and POS in $s3.
 *     Same shape one level up: step4 in $s8 / dir in $s7 where the original has
 *     step4 in $s7 and dir in $s8($fp).  Both are global.c allocno_compare ties.
 *  2. arm 0x8's two frame vectors land home->$s1 / bolt->$s0; the original has
 *     p->$s0 / v->$s1.  Shortening `home`'s live range (dropping the first
 *     `home = p`) costs more than it buys (95/52).  Swapping the declaration
 *     order does nothing -- the numbering is post-sched1 (cookbook D 2c).
 *  3. the original remats `li a3,3` about 8 times (arm 0x4 entry, both arms'
 *     colour-swap tails); ours does ~5.
 *
 * PROVEN HERE, do not re-derive:
 *  - loop.c HOISTS a stack vector's address into the preheader (and then spills
 *    it) as soon as the array NAME is used 3+ times in the loop; at <=2 uses it
 *    does not.  The original hoists exactly one address (arm 0x4's dv, $fp).
 *    Arm 0x8 uses its two vectors 6 times each, so the plain array form costs
 *    +4 preheader insns (2 addiu + 2 sw) and rotates the whole function.
 *    Block-scoping the arrays inside `case 0x8:` does NOT change this (93/54,
 *    identical to the function-scope form), so it is not a scope effect.
 *  - A MULTI-SET pointer carrier defeats it: `home` assigned twice is not a
 *    loop.c movable, and the preheader then comes out exactly right.  A
 *    SINGLE-set carrier is still hoisted (that was the first attempt).
 *  - `dir` is INERT in this variant (unlike level_15): with the local removed
 *    loop.c hoists &dv by itself and the output is byte-identical either way.
 *  - The shared constant 3 must be a NAMED local (`burst`, cookbook A100).
 *    Two arms compare/store `rec[0x1]` against 3 here; as a literal gcc folds it
 *    into per-site immediates and the function comes out 5 insns short
 *    (134/70 -> 89/50 with the local).  level_15 needs no such local because
 *    only one arm uses the constant.
 *
 * Arms 0x4 and 0x5 are lifted verbatim from the MATCHED func_level_15_80087B40,
 * so they are not suspect; 0x8 / 0x16 come from level_12 and 0x10 / 0x11 from
 * level_18.
 */
/* func_level_13_8008AF54 (0x8008af54, level_13_magic_crafters_alpine_ridge
 * overlay, 0x1a84 bytes).
 *
 * The emit-list ADVANCE pass -- the 1697-insn alpine-ridge variant of the walk
 * matched in level_10 / level_11 / level_5.  Walks the 0x20-byte record stream
 * at D_80075824 and ages one record per iteration: integrates its position,
 * fades its colour, ticks its life counter and, when the record has expired
 * (or its alive byte has been cleared), hands it back with func_80053608().
 * The walk stops at the terminator record, whose class byte at +0x01 is 0xFF.
 *
 * Only `rec` is a real induction variable; every field access is an ADDRESS
 * giv off it, which is how the whole record ends up addressed off `rec + 1`
 * with offsets 0x00..0x1D.
 *
 * Field map, in record-relative offsets:
 *   0x00  effect id                0x01  class / terminator
 *   0x02  age                      0x03  alive
 *   0x04/0x06/0x08  tail point     0x0A/0x0C/0x0E  head point (also the
 *                                  r/g/b triple for the fading classes)
 *   0x10..0x16  per-record velocity / colour bytes
 *   0x18  spin angle (a source pointer in classes 0x4 / 0x6, a byte angle
 *         pair in 0x15 / 0x4C)      0x1C  wrap count    0x1E  phase toggle
 *
 * It carries the two wizard classes 0x4 and 0x5 matched in level_15, plus
 * 0x8 (the homing bolt) and 0x16 from the level_12 body and the boss-ember
 * pair 0x10 / 0x11.
 *
 * SEVEN stack vectors, and the declaration order IS the frame order: arm 0x4
 * takes the first two, arm 0x5 the next two, arm 0x8 the fifth and sixth and
 * arm 0xA the seventh.  Arm 0x8's pair is CSE'd inside the arm, not hoisted,
 * so it reads `v` directly where level_12's copy reads `dv`.  `dv` names &dv for arm 0x4's five direction-vector calls (the
 * original hoists that address into $fp in the preheader); the arm's first
 * and last uses of the same vector read `dv` directly, which is the
 * single-use frame address reload rematerialises as `addiu ..,$sp,0x20`.
 */

#define HS(n) (*(short *)(rec + (n)))
#define HU(n) (*(unsigned short *)(rec + (n)))
#define W(n) (*(int *)(rec + (n)))
#define POS ((short *)(rec + 4))
#define VEL ((short *)(rec + 0x18))

extern void func_80017C84(short *dst, short *src, short *delta);
extern void func_80017BFC(short *dst, int *src);
extern void func_80017C24(int *dst, short *src);
extern void func_80017700(int *dst, int *src);       /* CopyVector */
extern void func_80017758(int *dst, int *a, int *b); /* AddVector */
extern void func_8001778C(int *dst, int *a, int *b); /* SubVector */
extern void func_800176C8(int *vec, int shift);      /* RShiftVector3 */
extern int func_800171FC(int *v, int mode);          /* VectorLength */
extern void func_800175B8(int *v, int len, int scale);
extern int func_80016C58(int a);         /* LookupSine */
extern int func_80016CB0(int a);         /* LookupCosine */
extern unsigned int func_8006272C(void); /* GetRandomU32 */
extern int abs(int n);
extern void func_80053608(unsigned char *rec); /* FreeEmitListRecord */

extern unsigned char *D_80075824; /* g_pEmitListBase */
extern char *D_80075828;          /* g_pActorListBase */
extern int D_80075814;            /* g_nSpyroDrawSuppressed */
extern int D_800756CC;            /* per-frame step count */
extern short D_8006CBF8[];        /* sine table */
extern short D_8006CC78[];        /* cosine table */
extern int D_80076DF8[];          /* the camera world position */
extern short D_80076E20;
extern int D_8007706C;
extern int D_80078AD0;
extern int D_80078BB8[]; /* [-0x58] is the Spyro world position (D_80078A58) */
extern int D_80078BBC;

void func_level_13_8008AF54(int step) {
  unsigned char *rec = D_80075824;
  int pt[3];
  int dv[3];
  int qa[3];
  int qb[3];
  int p[3];
  int v[3];
  int w[3];
  int burst;
  int c;
  int d;
  int step4;

  if (rec[1] == 0xFF) {
    return;
  }

  step4 = step * 4;
  burst = 3;

  do {
    switch (rec[0]) {
    case 0x0:  /* <- func_level_15_80087B40 */
    /* <- func_level_10_80084EF0 */
      func_80017C84(POS, POS, VEL);
      if (HS(0x1E) != 0) {
        HU(0x1C)++;
      }
      HS(0x1E) = 1 - HU(0x1E);
      rec[0xA] += step * 2;
      rec[0xC] -= step4;
      rec[0xD] -= step4;
      rec[0xE] -= step4;
      rec[0x2] += step;
      if (rec[0x2] >= 0x20 || rec[0x3] == 0) {
        func_80053608(rec);
      }
      break;

    case 0x1:  /* <- func_level_15_80087B40 */
    /* <- func_level_10_80084EF0 */
      func_80017C84(POS, POS, VEL);
      if (HS(0x1E) != 0) {
        HU(0x1C)++;
      }
      HS(0x1E) = 1 - HU(0x1E);
      rec[0xA] += step4;
      rec[0xC] -= step4;
      rec[0xD] -= step4;
      rec[0xE] -= step4;
      rec[0x2] += step;
      if (rec[0x2] >= 0x18 || rec[0x3] == 0) {
        func_80053608(rec);
      }
      break;

    case 0x2:  /* <- func_level_15_80087B40 */
    /* <- func_level_10_80084EF0 */
      func_80017C84(POS, POS, VEL);
      if (HS(0x1E) != 0) {
        HU(0x1C)++;
      }
      HS(0x1E) = 1 - HU(0x1E);
      rec[0xA] += step4;
      rec[0xC] -= step4;
      rec[0xD] -= step4;
      rec[0xE] -= step4;
      rec[0x2] += step;
      if (rec[0x2] >= 0x20 || rec[0x3] == 0) {
        func_80053608(rec);
      }
      break;

    case 0x4:  /* <- func_level_15_80087B40 */
    {
      int len;
      int near;
      int spin;
      int rx;
      int ry;
      int jx;
      int jy;

      /* The wizard's projectile.  Three sub-states, selected by the flag
       * halfword at +0x1E: bit 3 = the free-flying spark trail, bit 0 = the
       * spiral orbit around its own drift point, and neither = the homing
       * run at the owner actor read through the pointer at +0x18.  All three
       * fall into the shared distance test at the bottom, which flips the
       * record between its normal and its "close" colour set (class byte 3).
       */
      func_80017C24(pt, POS);
      if (HU(0x1E) & 8) {
        if (rec[0x2] >= 0x30) {
          func_80053608(rec);
          break;
        }
        rx = func_8006272C();
        jx = HU(0x18) - 3;
        jx += rx & 6;
        HU(0x18) = jx;
        ry = func_8006272C();
        jy = HU(0x1A) - 3;
        jy += ry & 6;
        HU(0x1A) = jy;
        HU(0x1C)++;
        if (HS(0x1C) >= 0x11) {
          HU(0x1C) = 0x10;
        }
        pt[0] += HS(0x18);
        pt[1] += HS(0x1A);
        pt[2] -= HS(0x1C);
        goto commit;
      } else if (HU(0x1E) & 1) {
        if (rec[0x2] >= 0x30) {
          rec[0x2] = 0;
          HS(0x18) = (func_8006272C() & 6) - 3;
          HS(0x1A) = (func_8006272C() & 6) - 3;
          HU(0x1C) = 0;
          HS(0x1E) = 8;
          goto measure;
        } else {
          func_80017C24(dv, VEL);
          if (HU(0x1E) & 2) {
            dv[0] += (rec[0x2] * func_80016CB0(rec[0x2] << 7)) >> 7;
          } else {
            dv[0] -= (rec[0x2] * func_80016CB0(rec[0x2] << 7)) >> 7;
          }
          if (HU(0x1E) & 4) {
            dv[1] += (rec[0x2] * func_80016C58(rec[0x2] << 7)) >> 7;
          } else {
            dv[1] -= (rec[0x2] * func_80016C58(rec[0x2] << 7)) >> 7;
          }
          dv[2] += rec[0x2] << 5;
          func_8001778C(dv, dv, pt);
          len = func_800171FC(dv, 1);
          if (len >= 0x81) {
            func_800175B8(dv, len, 0x80);
          }
          func_80017758(pt, pt, dv);
          goto commit;
        }
      } else {
        func_80017700(dv, (int *)(W(0x18) + 0xC));
        dv[0] += func_80016CB0(rec[0x2] << 7) >> 2;
        dv[1] += func_80016C58(rec[0x2] << 7) >> 2;
        dv[2] += func_80016CB0((rec[0x2] << 7) + 0x200) >> 2;
        func_8001778C(dv, dv, pt);
        len = func_800171FC(dv, 1);
        if (len < 0x401 || rec[0x2] >= 0x41) {
          int *owner = **(int ***)(rec + 0x18);

          if (owner[5] == 1) {
            owner[5] = 2;
            owner[0] = 0x20;
          }
          HS(0x1E) = (func_8006272C() & 6) + 1;
          func_80017BFC(VEL, (int *)(W(0x18) + 0xC));
          spin = func_8006272C() & 0x7F;
          rec[0x2] = 0;
          HU(0x1C) += spin;
          goto measure;
        }
        func_800175B8(dv, len, 0x100);
        func_80017758(pt, pt, dv);
      }
    commit:
      func_80017BFC(POS, pt);
      rec[0x2]++;
    measure:
      func_8001778C(dv, pt, D_80076DF8);
      near = abs(dv[0]) + abs(dv[1]);
      len = near + abs(dv[2]);
      if (rec[0x1] == burst) {
        if (len >= 0x3001) {
          rec[0xC] = 0xFF;
          rec[0xD] = 0xFF;
          rec[0xE] = 0xFF;
          rec[0xA] = 4;
          rec[0x1] = 0;
          rec[0xF] = 0x40;
        }
      } else if (len < 0x2800) {
        rec[0x1] = burst;
        rec[0xC] = 0x80;
        rec[0xD] = 0x80;
        rec[0xE] = 0x80;
        rec[0x11] = 4;
        rec[0xF] = 0x2C;
        rec[0x10] = 0;
        rec[0xA] = (func_8006272C() & 0xF) + 0x18;
        rec[0xB] = (func_8006272C() & 0x7) + 0xF;
      }
      break;
    }

    case 0x5:  /* <- func_level_15_80087B40 */
    {
      int rq;
      int rr;
      int jq;
      int jr;
      int dec;

      /* The short spawn drift: the record walks along its own jittered
       * velocity, plus a quarter of the record velocity vector. */
      if (rec[0x2] >= 0x30 || rec[0x3] == 0) {
        func_80053608(rec);
      } else {
        func_80017C24(qa, POS);
        rq = func_8006272C();
        jq = HU(0x18) - 3;
        jq += rq & 6;
        HU(0x18) = jq;
        rr = func_8006272C();
        jr = HU(0x1A) - 3;
        dec = HU(0x1C) - 1;
        jr += rr & 6;
        HU(0x1A) = jr;
        HU(0x1C) = dec;
        func_80017C24(qb, VEL);
        func_800176C8(qb, 2);
        func_80017758(qa, qa, qb);
        func_80017BFC(POS, qa);
        rec[0x2]++;
      }
      break;
    }

    case 0x8:  /* <- func_level_12_8008BE98 */
    {
      int len;
      int *home;
      int *bolt;

      /* The wizard's homing bolt: it spirals around the line to its owner
       * actor (D_80075828 + owner * 0x58), and switches to its burst state
       * (class byte 3) once it closes inside 0x2800. */
      home = p;
      func_80017C24(home, POS);
      if (rec[0x3] == 0) {
        func_80053608(rec);
      } else {
        bolt = v;
        func_80017700(bolt, (int *)(D_80075828 + rec[0x1E] * 0x58 + 0xC));
        v[0] += func_80016CB0(rec[0x2] << 7) >> 1;
        v[1] += func_80016C58(rec[0x2] << 7) >> 1;
        v[2] += func_80016CB0((rec[0x2] << 7) - 0x100) >> 2;
        home = p;
        func_8001778C(bolt, bolt, home);
        len = func_800171FC(bolt, 1);
        if (len < 0x401 || rec[0x2] >= 0x41) {
          func_80053608(rec);
        } else {
          func_800175B8(bolt, len, 0x80);
          func_80017758(home, home, bolt);
          func_80017BFC(POS, home);
          rec[0x2]++;
          func_8001778C(v, p, D_80076DF8);
          c = abs(v[0]) + abs(v[1]);
          len = c + abs(v[2]);
          if (rec[0x1] == burst) {
            if (len >= 0x3001) {
              rec[0xA] = 4;
              rec[0xF] = 0x40;
              rec[0x1] = 0;
              c = rec[0xC] * 2;
              rec[0xC] = c;
              rec[0xD] *= 2;
              rec[0xE] *= 2;
            }
          } else if (len < 0x2800) {
            rec[0x1] = burst;
            rec[0x11] = 4;
            rec[0xF] = 0x2C;
            rec[0x10] = 0;
            c = rec[0xC] >> 1;
            rec[0xC] = c;
            rec[0xD] >>= 1;
            rec[0xE] >>= 1;
            rec[0xA] = (func_8006272C() & 0xF) + 0x18;
            rec[0xB] = (func_8006272C() & 0x7) + 0xF;
          }
        }
      }
      break;
    }

    case 0x9:  /* <- func_level_15_80087B40 */
    /* <- func_level_10_80084EF0 */
      func_80017C84(POS, POS, VEL);
      if (HS(0x1E) != 0) {
        HU(0x1C)++;
      }
      HS(0x1E) = 1 - HU(0x1E);
      rec[0xA] += step * 2;
      rec[0x2] += step;
      if (rec[0x2] >= 0x20 || rec[0x3] == 0) {
        func_80053608(rec);
      }
      break;

    case 0xa:  /* <- func_level_15_80087B40 */
    /* <- func_level_10_80084EF0 */
      /* The homing sparkle: it only lives while Spyro is on screen. */
      if ((D_80078AD0 == 0x1D && D_80078BBC < 0) || D_80075814 != 0 ||
          D_80078BB8[0] <= 0) {
        func_80053608(rec);
      } else {
        func_80017700(w, D_80078BB8 - 0x58);
        w[0] += func_80016CB0(HS(0x18)) >> 4;
        w[1] += func_80016C58(HS(0x18)) >> 4;
        w[2] += 0x100;
        func_80017BFC(POS, w);
        HS(0x18) = HU(0x18) + 0x40;
        rec[0xA] = abs(func_80016CB0((HS(0x18) - D_80076E20) & 0xFFF)) / 170;
      }
      break;

    case 0xb:  /* <- func_level_15_80087B40 */
    /* <- func_level_10_80084EF0 */
      func_80017C84(POS, POS, (short *)(rec + 0x12));
      rec[0xC] -= 8;
      rec[0xD] -= 8;
      rec[0xE] -= 8;
      if (rec[0xC] == 0 || rec[0x3] == 0) {
        func_80053608(rec);
      }
      break;

    case 0xc:  /* <- func_level_15_80087B40 */
    /* <- func_level_10_80084EF0 */
      rec[0xB] += 8;
      rec[0xA] += 2;
      if (rec[0xC] != 0) {
        rec[0xC] -= 8;
      }
      if (rec[0xD] != 0) {
        rec[0xD] -= 8;
      }
      if (rec[0xE] != 0) {
        rec[0xE] -= 8;
      }
      if ((W(0xC) & 0xFFFFFF) == 0 || rec[0x3] == 0) {
        func_80053608(rec);
      }
      break;

    case 0x10:  /* <- func_level_18_800888F8 */
      /* Gnasty's cauldron drip: a slow ember that dies when its red
       * channel bottoms out. */
      func_80017C84(POS, POS, VEL);
      if (HS(0x1E) != 0) {
        HU(0x1C)++;
      }
      HS(0x1E) = 1 - HU(0x1E);
      rec[0xA] += step * 2;
      rec[0xC] -= 4;
      rec[0xD] -= 4;
      rec[0xE] -= 4;
      if (rec[0xC] == 0 || rec[0x3] == 0) {
        func_80053608(rec);
      }
      break;

    case 0x11:  /* <- func_level_18_800888F8 */
      /* The same ember with a late red cut-off at age 9. */
      func_80017C84(POS, POS, VEL);
      if (HS(0x1E) != 0) {
        HU(0x1C)++;
      }
      HS(0x1E) = 1 - HU(0x1E);
      rec[0xA] += step * 2;
      if (rec[0x2] >= 9) {
        rec[0xC] -= 0x20;
      }
      rec[0xD] -= 8;
      rec[0xE] -= 4;
      rec[0x2]++;
      if (rec[0x2] >= 0xC || rec[0x3] == 0) {
        func_80053608(rec);
      }
      break;

    case 0x15:  /* <- func_level_15_80087B40 */
    /* <- func_level_10_80084EF0 */
    {
      int s;

      rec[0x18] += D_800756CC * 4;
      rec[0x19] += D_800756CC;
      HU(0x4) = HU(0x12) + ((D_8006CC78[rec[0x18]] * rec[0x19]) >> 12);
      s = D_8006CBF8[rec[0x18]] * rec[0x19];
      HU(0x8) += *(const int *)&D_800756CC * 6;
      rec[0xB] += 4;
      HU(0x6) = HU(0x14) + (s >> 12);
      if (rec[0x19] >= 0xC1) {
        func_80053608(rec);
      }
      break;
    }

    case 0x16:  /* <- func_level_12_8008BE98 */
    {
      short a;

      func_80017C84(POS, POS, VEL);
      a = HS(0x18);
      if (a > 0) {
        a--;
        HS(0x18) = a;
      } else if (a < 0) {
        a++;
        HS(0x18) = a;
      }
      a = HS(0x1A);
      if (a > 0) {
        a--;
        HS(0x1A) = a;
      } else if (a < 0) {
        a++;
        HS(0x1A) = a;
      }
      rec[0xB] += rec[0x1E];
      d = rec[0xE] - D_800756CC;
      if (d <= 0) {
        func_80053608(rec);
      } else {
        rec[0xC] = d >> 1;
        rec[0xD] = d >> 1;
        rec[0xE] = d;
        rec[0x2] += step;
        if (rec[0x2] >= 0x40 || rec[0x3] == 0) {
          func_80053608(rec);
        }
      }
      break;
    }

    case 0x18:  /* <- func_level_15_80087B40 */
    /* <- func_level_10_80084EF0 */
    {
      int heat;

      if (rec[0xC] < 0xF0) {
        rec[0xC] += 4;
      }
      if (rec[0xD] < 0xF0) {
        rec[0xD] += 4;
      }
      if (rec[0xE] < 0xF0) {
        rec[0xE] += 4;
      }
      rec[0x1C] += D_800756CC * 8;
      heat = 0x3F;
      if (D_8007706C < 0x40) {
        heat = D_8007706C;
      }
      HS(0x18) = (rec[0x1D] * (0x48 - heat)) >> 3;
      HS(0x1A) = (((0x20 - rec[0x1D]) * heat) >> 4) + 8;
      HU(0x4) = HU(0x12) + ((D_8006CC78[rec[0x1C]] * HS(0x1A)) >> 12);
      HU(0x6) = HU(0x14) + ((D_8006CBF8[rec[0x1C]] * HS(0x1A)) >> 12);
      HU(0x8) = HU(0x16) + 0x20 + HU(0x18);
      break;
    }

    case 0x21:  /* <- func_level_15_80087B40 */
    /* <- func_level_10_80084EF0 */
    {
      int c;

      func_80017C84(POS, POS, VEL);
      if (HS(0x1E) != 0) {
        HU(0x1C)++;
      }
      c = rec[0xC] - step;
      HS(0x1E) = 1 - HU(0x1E);
      rec[0xA] += step * 2;
      if (c < 0) {
        c = 0;
      }
      rec[0xC] = c;
      c = rec[0xD] - step;
      if (c < 0) {
        c = 0;
      }
      rec[0xD] = c;
      c = rec[0xE] - step;
      if (c < 0) {
        c = 0;
