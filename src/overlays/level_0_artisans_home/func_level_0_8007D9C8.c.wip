/* Actor record, 0x58 bytes. Layout carried over verbatim from the matched
 * func_level_0_800857CC.c, with ONE refinement: that file spans 0x38..0x43 as
 * `int unk38[3]`, but this function reads a flags BYTE at +0x42, so the tail
 * of that span is split out here. Same layout, finer grain -- if these two
 * files are ever merged into a level_0.h, keep this split. */
typedef struct Actor {
  void *state;         /* 0x00 per-type state block */
  int unk04;           /* 0x04 */
  int unk08;           /* 0x08 */
  int posX;            /* 0x0C */
  int posY;            /* 0x10 */
  int posZ;            /* 0x14 */
  int flags;           /* 0x18 */
  int unk1C;           /* 0x1C */
  int unk20[5];        /* 0x20 */
  short unk34;         /* 0x34 */
  short type;          /* 0x36 outer switch discriminant */
  short unk38;         /* 0x38 read as a SIGNED halfword by case 16 */
  unsigned char unk3A; /* 0x3A case 323 masks this as a BYTE (&= 0x7F), so the
                        * short the sibling file spans here is split. Same kind
                        * of refinement as the 0x42 one above; nothing else in
                        * either file reads 0x3A or 0x3B. */
  unsigned char unk3B;
  unsigned char unk3C; /* 0x3C */
  unsigned char unk3D; /* 0x3D anim/pose request; 0 or 1 */
  unsigned char unk3E; /* 0x3E */
  unsigned char unk3F; /* 0x3F */
  unsigned char unk40; /* 0x40 */
  unsigned char unk41;
  unsigned char unk42; /* 0x42 flags byte: bit0 and bit1 are published */
  unsigned char unk43;
  unsigned char unk44; /* 0x44 */
  unsigned char unk45;
  unsigned char unk46;
  unsigned char unk47;
  unsigned char unk48; /* 0x48 state byte; 4 of the 6 inner switches use it */
  unsigned char unk49; /* 0x49 second state byte; inner switch B uses it */
  unsigned char unk4A;
  unsigned char unk4B; /* 0x4B */
  unsigned char unk4C; /* 0x4C */
  unsigned char unk4D;
  unsigned char unk4E;
  unsigned char unk4F;
  unsigned char unk50; /* 0x50 */
  unsigned char unk51;
  unsigned char unk52; /* 0x52 */
  unsigned char unk53;
  unsigned char unk54;
  unsigned char unk55;
  unsigned char unk56; /* 0x56 owner pool index */
  unsigned char unk57;
} Actor; /* 0x58 */

