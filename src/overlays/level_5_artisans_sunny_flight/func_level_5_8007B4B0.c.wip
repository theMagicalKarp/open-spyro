/* func_level_5_8007B4B0 (0x8007B4B0, level_5_artisans_sunny_flight overlay).
 *
 * Format and draw the flight-level race time at `pos` (units of 1/6 second).
 * Negative time draws the placeholder string (D_8007AA3C) and returns 6.
 * Otherwise formats h:mm:ss (D_8007AA44) or mm:ss (D_8007AA54) into a stack
 * buffer, right-aligns by the string length (9px per glyph), draws it, and
 * for the hour form additionally draws the colon overlay (D_8007AA5C) twice
 * at 1.5x width. Returns the glyph count.
 * Identical body in the five flight-level overlays.
 *
 * PARKED at 84.0% (100/119): logic, length, string literals, and both call
 * shapes correct. Two residue knots: (1) div-block register naming mirror —
 * orig computes q600 into a0 (the dead `time` arg reg) with the x100 input
 * as a COPY in a3 (`move a3,a0`) and min in v0; ours computes into a3,
 * copies to v1, and reuses v1 for min. Tried: qc copy local (propagated
 * away), multi-def frac (`frac = q600; frac = time/6 - frac*100;` — got the
 * move but reversed direction), redundant `frac = time/600` cse-copy
 * (identical bytes). (2) `len += 1` placement in the hr arm: orig slots the
 * addiu into the pos[0] load-delay AFTER the fmt la; ours emits it before
 * the la; source reordering produced identical bytes (Sec-K wall).
 * Permuter candidate — 5x payoff (2380 bytes across the flight overlays).
 * 2026-07-16-1 re-attempt (2 more forms, both worse): (a) separate chain-input
 * local (`mul = q600; frac = time/6 - mul*100`) — copy propagated away AND min
 * coalesced into the a3 arg reg (1 insn short, 31%%); (b) param reassignment
 * (`time = time/600` after the /6 and /36000 reads) — mult group order follows
 * SOURCE order (proves the original source starts with the /600 divide), and
 * the copy vanishes entirely (chain reads a0 directly, 1 short). The move's
 * direction (copy-in a3 feeding the chain, q600 surviving in a0 for min) is
 * cse canonical-reg choice, not reachable by source restructure. Permuter.
 */

extern void func_80017FE4(); /* draw text run */
extern void func_80062FD4(); /* sprintf */
extern int func_8006276C(); /* strlen */

int func_level_5_8007B4B0(int time, int *pos, int arg2) {
  char buf[16];
  int q600;
  int hr;
  int min;
  int frac;
  int len;

  if (time < 0) {
    pos[0] -= 0x36;
    pos[1] -= 5;
    func_80017FE4("......", pos, 0x12, arg2);
    return 6;
  }
  q600 = time / 600;
  frac = time / 600;
  frac = time / 6 - frac * 100;
  hr = time / 36000;
  min = q600 - hr * 60;
  if (hr != 0) {
    func_80062FD4(buf, "%d %02d.%02d", hr, min, frac);
  } else {
    func_80062FD4(buf, "%d.%02d", min, frac);
  }
  len = func_8006276C(buf);
  pos[0] -= len * 9;
  func_80017FE4(buf, pos, 0x12, arg2);
  if (hr != 0) {
    char *fmt = ".";
    pos[0] -= 0x6C;
    len += 1;
    pos[1] += 1;
    pos[2] = (pos[2] * 3) >> 1;
    func_80017FE4(fmt, pos, 0x12, arg2);
    pos[0] -= 0x12;
    pos[1] -= 8;
    func_80017FE4(fmt, pos, 0x12, arg2);
  }
  return len;
}
