/* PARKED 2026-08-19-2 at 1811/1815 insns, MISMATCH 57 over 30 regions with
 * registers anchored.  With the whole-function s4<->s5 rotation cancelled the
 * residue is only 14 insns over 13 regions, so this is fully decoded: arms
 * 0x45 and 0x49 were new this session and are byte-exact.
 *
 * THREE THINGS LEFT, all named:
 *  1. FOUR missing `li a3,3` -- the entire length deficit, and the SAME class
 *     that parks func_level_13_8008AF54.  The original materialises 3 eight
 *     times; four of them (arm 0x4 top, the `commit:` block head, arm 0x8 top,
 *     and the head of arm 0x8's own commit block) are DEAD: $a3 is caller-saved
 *     and the next instruction is a call, so nothing reads them.  The other four
 *     sit at the real uses (`rec[0x1] == burst` / `rec[0x1] = burst` in each
 *     arm) and we emit exactly those.  Read off the gcc 2.7.2 source this
 *     session: `local-alloc.c update_equiv_regs` puts a REG_EQUIV on the
 *     single-set constant and DOUBLES `reg_live_length`, `reload1.c:1918`
 *     deletes the init insn whenever the pseudo won no hard register, and
 *     `caller-save.c insert_save_restore` only ever emits MEMORY saves -- never
 *     a `li`.  So no dead constant materialisation is reachable from C, and
 *     every multi-set spelling loses the `reg_equiv_constant`, moves the value
 *     to a callee-saved register and re-colours the function.  Measured this
 *     session: preheader init + 4 arm re-assignments -> `li s3,3` x3, 1809/79;
 *     per-arm block-scoped `int burst;` -> 1809/82; the four assignments with
 *     no preheader init -> 1809/75; `int burst = 3;` at the declaration and
 *     `burst` spelled into the four `- 3` jitter sites are both NEUTRAL (57).
 *     level_16's copy of arm 0x8 (parked 1/1476) has the ORDINARY two-`li`
 *     form in $v0, so this is a whole-function reload artefact, not an arm.
 *  2. rec lands in $s4 and POS in $s5; the original has rec in $s5, POS in $s4
 *     -- the same global.c allocno_compare tie as level_13, and it accounts for
 *     43 of the 57 mismatches on its own.  The three givs (rec+1, rec+4,
 *     rec+0x18) are emitted in the right order; only which of the biv and its
 *     first giv wins the lower regno differs.
 *  3. Arm 0x8's last call takes `move a0,s1 / move a1,s0` where the original
 *     re-materialises `addiu a0,sp,96 / addiu a1,sp,80`: cse holds the
 *     `bolt == v` / `home == p` equivalence.  An A200b `do { } while (0);`
 *     barrier in front of that call does NOT break it and costs 2 insns
 *     elsewhere (63/31).  Same cost either way -- 2 mismatches, no length.
 *
 * FOUR THINGS THAT ARE RIGHT AND LOAD-BEARING (do not undo):
 *  - `step4 = step * 4;` must be written BEFORE `dir = dv;` (A213).  This
 *     variant spills BOTH step*2 and step*4 to the frame and gives $s8 to
 *     `dir`; the later-assigned pseudo has the shorter range and takes the
 *     register, so ordering dir LAST is what puts it in $s8: 189 -> 78.
 *     Dropping the `step4` name entirely (inline `step * 4`, letting loop.c
 *     hoist it) puts `dir` first in the preheader and spills it instead.
 *  - Arm 0x45 needs TWO multi-set pointer carriers, and group 2 must swap
 *     which carrier holds which array (`base = adv; ... hop = cur;`).  Single-
 *     set carriers (four of them) re-trigger loop.c's A212 preheader hoist of
 *     both stack-vector addresses and rotate the whole function (216/52); one
 *     carrier per array keeps cur/adv in the same registers in both groups,
 *     which lets arm 0x5's `func_80017758` cross-jump into arm 0x45's and
 *     costs 6 insns (61 -> ...).  The swap reproduces the original's
 *     s1=cur/s0=adv then s1=adv/s0=cur pairing: 78 -> 61.
 *  - Arm 0x45's stream address is `(int *)&path[W(0x1C) * 0x10 + 8]`, not
 *     `(int *)(path + W(0x1C) * 0x10 + 8)` -- the latter is left-associative
 *     and folds the +8 onto the base, which swaps the `addiu`/`addu` pair
 *     across the jal delay slot (A168).
 *  - NINE stack vectors in declaration order pt/dv/qa/qb/p/v/w/cur/adv:
 *     0x10..0x90, read straight off the original's `addiu rN,sp,K` set.
 *     Arm 0x4 takes the first two, 0x5 the next two, 0x8 the fifth and sixth,
 *     0xA the seventh and 0x45 the last two.
 */
/* func_level_14_80089454 (0x80089454, level_14_magic_crafters_high_caves
 * overlay, 0x1c5c bytes).
 *
 * The emit-list ADVANCE pass -- the 1815-insn high-caves variant, the largest
 * of the 35 and the last one in the family with undecoded arms.  Walks the
 * 0x20-byte record stream at D_80075824 and ages one record per iteration,
 * handing expired records back with func_80053608().  The walk stops at the
 * terminator record, whose class byte at +0x01 is 0xFF.
 *
 * 28 classes.  Arms 0x4/0x5 come from the matched func_level_15_80087B40,
 * 0x8/0x10/0x11 and the seven-vector frame from the level_13 park, 0x1E/0x1F
 * from the level_27 park and the rest from level_0 / level_9 / level_10.
 * Two arms are new here:
 *   0x45  the guided stream-follower: reads a waypoint list through the
 *         pointer at +0x18, steps it by the wrap counter at +0x1C, adds a
 *         unit-circle wobble to the waypoint, and dies when the wrap counter
 *         reaches the list's length byte at [0].
 *   0x49  the two-axis orbit: radius rec[0x1F] swept by (rec[0x1E] + age) << 6
 *         into the tail point, with the head point tracking age * 2, all three
 *         then advanced by the per-record velocity halfwords at 0x18/0x1A/0x1C.
 */

#define HS(n) (*(short *)(rec + (n)))
#define HU(n) (*(unsigned short *)(rec + (n)))
#define W(n) (*(int *)(rec + (n)))
#define POS ((short *)(rec + 4))
#define VEL ((short *)(rec + 0x18))

extern int abs(int n);
extern int func_80016C58(int a);               /* LookupSine */
extern int func_80016CB0(int a);               /* LookupCosine */
extern int func_800171FC(int *v, int mode);          /* VectorLength */
extern void func_800175B8(int *v, int len, int scale);
extern void func_800176C8(int *vec, int shift);      /* RShiftVector3 */
extern void func_80017700(int *dst, int *src); /* CopyVector */
extern void func_80017758(int *dst, int *a, int *b); /* AddVector */
extern void func_8001778C(int *dst, int *a, int *b); /* SubVector */
extern void func_80017BFC(short *dst, int *src);
extern void func_80017C24(int *dst, short *src);
extern void func_80017C84(short *dst, short *src, short *delta);
extern void func_80053608(unsigned char *rec); /* FreeEmitListRecord */
extern unsigned int func_8006272C(void);       /* GetRandomU32 */

extern unsigned char *D_80075824; /* g_pEmitListBase */
extern short D_8006CBF8[];        /* sine table */
extern short D_8006CC78[];        /* cosine table */
extern int D_800756CC;            /* per-frame step count */
extern int D_80075814;            /* g_nSpyroDrawSuppressed */
extern char *D_80075828;          /* g_pActorListBase */
extern int D_80076DF8[];          /* the camera world position */
extern short D_80076E20;
extern int D_8007706C;
extern int D_80078AD0;
extern int D_80078BB8[]; /* [-0x58] is the Spyro world position (D_80078A58) */
extern int D_80078BBC;

void func_level_14_80089454(int step) {
  unsigned char *rec = D_80075824;
  int pt[3];
  int dv[3];
  int qa[3];
  int qb[3];
  int p[3];
  int v[3];
  int w[3];
  int cur[3];
  int adv[3];
  int *dir;
  int step4;
  int burst;
  int c;
  int d;

  if (rec[1] == 0xFF) {
    return;
  }

  step4 = step * 4;
  dir = dv;
  burst = 3;

  do {
    switch (rec[0]) {
    case 0x0:
      func_80017C84(POS, POS, VEL);
      if (HS(0x1E) != 0) {
        HU(0x1C)++;
      }
      HS(0x1E) = 1 - HU(0x1E);
      rec[0xA] += step * 2;
      rec[0xC] -= step4;
      rec[0xD] -= step4;
      rec[0xE] -= step4;
      rec[0x2] += step;
      if (rec[0x2] >= 0x20 || rec[0x3] == 0) {
        func_80053608(rec);
      }
      break;

    case 0x1:
      func_80017C84(POS, POS, VEL);
      if (HS(0x1E) != 0) {
        HU(0x1C)++;
      }
      HS(0x1E) = 1 - HU(0x1E);
      rec[0xA] += step4;
      rec[0xC] -= step4;
      rec[0xD] -= step4;
      rec[0xE] -= step4;
      rec[0x2] += step;
      if (rec[0x2] >= 0x18 || rec[0x3] == 0) {
        func_80053608(rec);
      }
      break;

    case 0x2:
      func_80017C84(POS, POS, VEL);
      if (HS(0x1E) != 0) {
        HU(0x1C)++;
      }
      HS(0x1E) = 1 - HU(0x1E);
      rec[0xA] += step4;
      rec[0xC] -= step4;
      rec[0xD] -= step4;
      rec[0xE] -= step4;
      rec[0x2] += step;
      if (rec[0x2] >= 0x20 || rec[0x3] == 0) {
        func_80053608(rec);
      }
      break;

    case 0x4:
    {
      int len;
      int near;
      int spin;
      int rx;
      int ry;
      int jx;
      int jy;

      /* The wizard's projectile.  Three sub-states, selected by the flag
       * halfword at +0x1E: bit 3 = the free-flying spark trail, bit 0 = the
       * spiral orbit around its own drift point, and neither = the homing
       * run at the owner actor read through the pointer at +0x18.  All three
       * fall into the shared distance test at the bottom, which flips the
       * record between its normal and its "close" colour set (class byte 3).
       */
      func_80017C24(pt, POS);
      if (HU(0x1E) & 8) {
        if (rec[0x2] >= 0x30) {
          func_80053608(rec);
          break;
        }
        rx = func_8006272C();
        jx = HU(0x18) - 3;
        jx += rx & 6;
        HU(0x18) = jx;
        ry = func_8006272C();
        jy = HU(0x1A) - 3;
        jy += ry & 6;
        HU(0x1A) = jy;
        HU(0x1C)++;
        if (HS(0x1C) >= 0x11) {
          HU(0x1C) = 0x10;
        }
        pt[0] += HS(0x18);
        pt[1] += HS(0x1A);
        pt[2] -= HS(0x1C);
        goto commit;
      } else if (HU(0x1E) & 1) {
        if (rec[0x2] >= 0x30) {
          rec[0x2] = 0;
          HS(0x18) = (func_8006272C() & 6) - 3;
          HS(0x1A) = (func_8006272C() & 6) - 3;
          HU(0x1C) = 0;
          HS(0x1E) = 8;
          goto measure;
        } else {
          func_80017C24(dv, VEL);
          if (HU(0x1E) & 2) {
            dv[0] += (rec[0x2] * func_80016CB0(rec[0x2] << 7)) >> 7;
          } else {
            dv[0] -= (rec[0x2] * func_80016CB0(rec[0x2] << 7)) >> 7;
          }
          if (HU(0x1E) & 4) {
            dv[1] += (rec[0x2] * func_80016C58(rec[0x2] << 7)) >> 7;
          } else {
            dv[1] -= (rec[0x2] * func_80016C58(rec[0x2] << 7)) >> 7;
          }
          dv[2] += rec[0x2] << 5;
          func_8001778C(dir, dir, pt);
          len = func_800171FC(dir, 1);
          if (len >= 0x81) {
            func_800175B8(dir, len, 0x80);
          }
          func_80017758(pt, pt, dir);
          goto commit;
        }
      } else {
        func_80017700(dir, (int *)(W(0x18) + 0xC));
        dv[0] += func_80016CB0(rec[0x2] << 7) >> 2;
        dv[1] += func_80016C58(rec[0x2] << 7) >> 2;
        dv[2] += func_80016CB0((rec[0x2] << 7) + 0x200) >> 2;
        func_8001778C(dir, dir, pt);
        len = func_800171FC(dir, 1);
        if (len < 0x401 || rec[0x2] >= 0x41) {
          int *owner = **(int ***)(rec + 0x18);

          if (owner[5] == 1) {
            owner[5] = 2;
            owner[0] = 0x20;
          }
          HS(0x1E) = (func_8006272C() & 6) + 1;
          func_80017BFC(VEL, (int *)(W(0x18) + 0xC));
          spin = func_8006272C() & 0x7F;
          rec[0x2] = 0;
          HU(0x1C) += spin;
          goto measure;
        }
        func_800175B8(dir, len, 0x100);
        func_80017758(pt, pt, dir);
      }
    commit:
      func_80017BFC(POS, pt);
      rec[0x2]++;
    measure:
      func_8001778C(dv, pt, D_80076DF8);
      near = abs(dv[0]) + abs(dv[1]);
      len = near + abs(dv[2]);
      if (rec[0x1] == burst) {
        if (len >= 0x3001) {
          rec[0xC] = 0xFF;
          rec[0xD] = 0xFF;
          rec[0xE] = 0xFF;
          rec[0xA] = 4;
          rec[0x1] = 0;
          rec[0xF] = 0x40;
        }
      } else if (len < 0x2800) {
        rec[0x1] = burst;
        rec[0xC] = 0x80;
        rec[0xD] = 0x80;
        rec[0xE] = 0x80;
        rec[0x11] = 4;
        rec[0xF] = 0x2C;
        rec[0x10] = 0;
        rec[0xA] = (func_8006272C() & 0xF) + 0x18;
        rec[0xB] = (func_8006272C() & 0x7) + 0xF;
      }
      break;
    }

    case 0x5:
    {
      int rq;
      int rr;
      int jq;
      int jr;
      int dec;

      /* The short spawn drift: the record walks along its own jittered
       * velocity, plus a quarter of the record velocity vector. */
      if (rec[0x2] >= 0x30 || rec[0x3] == 0) {
        func_80053608(rec);
      } else {
        func_80017C24(qa, POS);
        rq = func_8006272C();
        jq = HU(0x18) - 3;
        jq += rq & 6;
        HU(0x18) = jq;
        rr = func_8006272C();
        jr = HU(0x1A) - 3;
        dec = HU(0x1C) - 1;
        jr += rr & 6;
        HU(0x1A) = jr;
        HU(0x1C) = dec;
        func_80017C24(qb, VEL);
        func_800176C8(qb, 2);
        func_80017758(qa, qa, qb);
        func_80017BFC(POS, qa);
        rec[0x2]++;
      }
      break;
    }

    case 0x8:
    {
      int len;
      int *home;
      int *bolt;

      /* The wizard's homing bolt: it spirals around the line to its owner
       * actor (D_80075828 + owner * 0x58), and switches to its burst state
       * (class byte 3) once it closes inside 0x2800. */
      func_80017C24(p, POS);
      do {
      } while (0);
      if (rec[0x3] == 0) {
        func_80053608(rec);
      } else {
        bolt = v;
        func_80017700(bolt, (int *)(D_80075828 + rec[0x1E] * 0x58 + 0xC));
        v[0] += func_80016CB0(rec[0x2] << 7) >> 1;
        v[1] += func_80016C58(rec[0x2] << 7) >> 1;
        v[2] += func_80016CB0((rec[0x2] << 7) - 0x100) >> 2;
        home = p;
        func_8001778C(bolt, bolt, home);
        len = func_800171FC(bolt, 1);
        if (len < 0x401 || rec[0x2] >= 0x41) {
          func_80053608(rec);
        } else {
          func_800175B8(bolt, len, 0x80);
          func_80017758(home, home, bolt);
          func_80017BFC(POS, home);
          rec[0x2]++;
          func_8001778C(v, p, D_80076DF8);
          c = abs(v[0]) + abs(v[1]);
          len = c + abs(v[2]);
          if (rec[0x1] == burst) {
            if (len >= 0x3001) {
              rec[0xA] = 4;
              rec[0xF] = 0x40;
              rec[0x1] = 0;
              c = rec[0xC] * 2;
              rec[0xC] = c;
              rec[0xD] *= 2;
              rec[0xE] *= 2;
            }
          } else if (len < 0x2800) {
            rec[0x1] = burst;
            rec[0x11] = 4;
            rec[0xF] = 0x2C;
            rec[0x10] = 0;
            c = rec[0xC] >> 1;
            rec[0xC] = c;
            rec[0xD] >>= 1;
            rec[0xE] >>= 1;
            rec[0xA] = (func_8006272C() & 0xF) + 0x18;
            rec[0xB] = (func_8006272C() & 0x7) + 0xF;
          }
        }
      }
      break;
    }

    case 0x9:
      func_80017C84(POS, POS, VEL);
      if (HS(0x1E) != 0) {
        HU(0x1C)++;
      }
      HS(0x1E) = 1 - HU(0x1E);
      rec[0xA] += step * 2;
      rec[0x2] += step;
      if (rec[0x2] >= 0x20 || rec[0x3] == 0) {
        func_80053608(rec);
      }
      break;

    case 0xA:
    /* <- func_level_10_80084EF0 */
      /* The homing sparkle: it only lives while Spyro is on screen. */
      if ((D_80078AD0 == 0x1D && D_80078BBC < 0) || D_80075814 != 0 ||
          D_80078BB8[0] <= 0) {
        func_80053608(rec);
      } else {
        func_80017700(w, D_80078BB8 - 0x58);
        w[0] += func_80016CB0(HS(0x18)) >> 4;
        w[1] += func_80016C58(HS(0x18)) >> 4;
        w[2] += 0x100;
        func_80017BFC(POS, w);
        HS(0x18) = HU(0x18) + 0x40;
        rec[0xA] = abs(func_80016CB0((HS(0x18) - D_80076E20) & 0xFFF)) / 170;
      }
      break;

    case 0xB:
      func_80017C84(POS, POS, (short *)(rec + 0x12));
      rec[0xC] -= 8;
      rec[0xD] -= 8;
      rec[0xE] -= 8;
      if (rec[0xC] == 0 || rec[0x3] == 0) {
        func_80053608(rec);
      }
      break;

    case 0xC:
      rec[0xB] += 8;
      rec[0xA] += 2;
      if (rec[0xC] != 0) {
        rec[0xC] -= 8;
      }
      if (rec[0xD] != 0) {
        rec[0xD] -= 8;
      }
      if (rec[0xE] != 0) {
        rec[0xE] -= 8;
      }
      if ((W(0xC) & 0xFFFFFF) == 0 || rec[0x3] == 0) {
        func_80053608(rec);
      }
      break;

    case 0x10:
      /* Gnasty's cauldron drip: a slow ember that dies when its red
       * channel bottoms out. */
      func_80017C84(POS, POS, VEL);
      if (HS(0x1E) != 0) {
        HU(0x1C)++;
      }
      HS(0x1E) = 1 - HU(0x1E);
      rec[0xA] += step * 2;
      rec[0xC] -= 4;
      rec[0xD] -= 4;
      rec[0xE] -= 4;
      if (rec[0xC] == 0 || rec[0x3] == 0) {
        func_80053608(rec);
      }
      break;

    case 0x11:
      /* The same ember with a late red cut-off at age 9. */
      func_80017C84(POS, POS, VEL);
      if (HS(0x1E) != 0) {
        HU(0x1C)++;
      }
      HS(0x1E) = 1 - HU(0x1E);
      rec[0xA] += step * 2;
      if (rec[0x2] >= 9) {
        rec[0xC] -= 0x20;
      }
      rec[0xD] -= 8;
      rec[0xE] -= 4;
      rec[0x2]++;
      if (rec[0x2] >= 0xC || rec[0x3] == 0) {
        func_80053608(rec);
      }
      break;

    case 0x15:
    {
      int s;

      rec[0x18] += D_800756CC * 4;
      rec[0x19] += D_800756CC;
      HU(0x4) = HU(0x12) + ((D_8006CC78[rec[0x18]] * rec[0x19]) >> 12);
      s = D_8006CBF8[rec[0x18]] * rec[0x19];
      HU(0x8) += *(const int *)&D_800756CC * 6;
      rec[0xB] += 4;
      HU(0x6) = HU(0x14) + (s >> 12);
      if (rec[0x19] >= 0xC1) {
        func_80053608(rec);
      }
      break;
    }

    case 0x18:
    {
      int heat;

      if (rec[0xC] < 0xF0) {
        rec[0xC] += 4;
      }
      if (rec[0xD] < 0xF0) {
        rec[0xD] += 4;
      }
      if (rec[0xE] < 0xF0) {
        rec[0xE] += 4;
      }
      rec[0x1C] += D_800756CC * 8;
      heat = 0x3F;
      if (D_8007706C < 0x40) {
        heat = D_8007706C;
      }
      HS(0x18) = (rec[0x1D] * (0x48 - heat)) >> 3;
      HS(0x1A) = (((0x20 - rec[0x1D]) * heat) >> 4) + 8;
      HU(0x4) = HU(0x12) + ((D_8006CC78[rec[0x1C]] * HS(0x1A)) >> 12);
      HU(0x6) = HU(0x14) + ((D_8006CBF8[rec[0x1C]] * HS(0x1A)) >> 12);
      HU(0x8) = HU(0x16) + 0x20 + HU(0x18);
      break;
    }

    case 0x1E:
      HU(0x8) += HU(0x1E);
      rec[0xA]++;
      rec[0xC] -= step * 2;
      rec[0xD] -= step * 2;
      rec[0xE] -= step * 2;
      rec[0x2] += step;
      if (rec[0x2] >= 0x20) {
        func_80053608(rec);
      }
      break;

    case 0x1F:
      /* A plain drifter with a long life. */
      func_80017C84(POS, POS, VEL);
      rec[0x2] += step;
      if (rec[0x2] >= 0x40 || rec[0x3] == 0) {
        func_80053608(rec);
      }
      break;

    case 0x21:
    {
      int c;

      func_80017C84(POS, POS, VEL);
      if (HS(0x1E) != 0) {
        HU(0x1C)++;
      }
      c = rec[0xC] - step;
      HS(0x1E) = 1 - HU(0x1E);
      rec[0xA] += step * 2;
      if (c < 0) {
        c = 0;
      }
      rec[0xC] = c;
      c = rec[0xD] - step;
      if (c < 0) {
        c = 0;
      }
      rec[0xD] = c;
      c = rec[0xE] - step;
      if (c < 0) {
        c = 0;
      }
      rec[0xE] = c;
      rec[0x2] += step;
      if (rec[0x2] >= 0x20 || rec[0x3] == 0) {
        func_80053608(rec);
