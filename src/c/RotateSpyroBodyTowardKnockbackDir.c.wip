#include "globals.h"

extern int ArcTan2(int y, int x, int high_precision);

/* 0x8003dfec (0xC8) — rotate Spyro's persistent yaw byte toward the direction
   of his current motion vector (the knockback heading). Does nothing when the
   angular error is within `band` of either wrap end; snaps straight to the
   target when the error is within `step`, otherwise steps by `step` the short
   way around. Commits the result to g_nSpyroBodyYaw (<<4). */
void RotateSpyroBodyTowardKnockbackDir(int step, int band) {
  int ret;
  int yaw;
  int cur;
  int diff;

  ret = ArcTan2(g_anSpyroMotionVec[0], g_anSpyroMotionVec[1], 0);
  cur = g_abSpyroPersistentEuler[2];
  diff = ret - cur;
  diff = diff & 0xFF;
  yaw = ret;
  if (band < diff && diff < 0x100 - band) {
    if (diff <= step || diff >= 0x100 - step) {
      g_abSpyroPersistentEuler[2] = yaw;
    } else {
      g_abSpyroPersistentEuler[2] =
          (unsigned int)diff < 0x80 ? cur + step : cur - step;
    }
    g_nSpyroBodyYaw = g_abSpyroPersistentEuler[2] << 4;
  }
}

/* PARKED 2026-07-10 at 98.0% — single-insn regalloc tie: original computes
 * `subu v1,v0,a0` reading the raw ArcTan2 return reg (ret pseudo kept in v0,
 * separate from yaw's a2 copy); our gcc coalesces ret with yaw (or cse
 * substitutes yaw post-copy) so the subu reads a2. ret/yaw split, statement
 * reorder (diff-before/after-copy) and single-variable forms all emit
 * byte-identical output. One operand register; prime permuter candidate.
 */
