extern int *g_pWorkAreaTop;      /* 0x800785fc */
extern void *g_apActorMeshTable; /* 0x80076378 */

void RelocateMobActorTable(int *stream) {
  int pad[2];
  int maskLo;
  int maskHi;
  int i;
  int **top;
  int off;
  int table;
  int entry;
  int mesh;
  unsigned int ptr;
  int *idx;
  int size;
  int base;
  int j;
  int *w;
  int word;
  int lo;
  idx = stream;
  i = 0;
  top = &g_pWorkAreaTop;

  while (i < 0x2E) {

    ptr = *(unsigned int *)((i * 4 + (int)g_apActorMeshTable) + 0x38);
    if (ptr < (unsigned int)*top || ptr == -1) {
      *(int *)((i * 4 + (int)g_apActorMeshTable) + 0x38) = 0;
    }
    i++;
  }

  if (*idx < 0) {
    return;
  }
  maskLo = 0x1FFFFF;
  maskHi = 0xFFE00000;
  stream += 1;
  // next:
  while (*idx >= 0) {
    size = *stream;
    stream += 1;
    off = *idx * 4;

    entry = off + (int)*(void *volatile *)&g_apActorMeshTable;
    *(volatile int *)(entry + 0x38) = (int)stream;

    table = (int)*(void *volatile *)&g_apActorMeshTable;
    entry = off + table;
    mesh = *(volatile int *)(entry + 0x38);
    *(volatile int *)(mesh + 0x14) =
        *(int *)(table + 0x34) + *(volatile int *)(mesh + 0x14);

    table = (int)*(void *volatile *)&g_apActorMeshTable;
    entry = off + table;
    mesh = *(volatile int *)(entry + 0x38);
    *(volatile int *)(mesh + 0x18) =
        *(int *)(table + 0x34) + *(volatile int *)(mesh + 0x18);

    entry = off + (int)*(void *volatile *)&g_apActorMeshTable;
    mesh = *(volatile int *)(entry + 0x38);
    base = (int)((char *)stream + ((*(short *)mesh << 2) + 0x24));
    *(volatile int *)(mesh + 0x10) = base + *(volatile int *)(mesh + 0x10);

    entry = off + (int)*(void *volatile *)&g_apActorMeshTable;
    mesh = *(volatile int *)(entry + 0x38);
    j = 0;
    w = (int *)(mesh + 0x24);
    if (*(short *)mesh > 0) {
      do {
        word = *w;
        lo = ((word & maskLo) + base) >> 1;
        *w = (word & maskHi) + (lo & maskLo);
        j += 1;
        w += 1;
      } while (
          j <
          *(short *)*(
              volatile int *)((off +
                               (int)*(void *volatile *)&g_apActorMeshTable) +
                              0x38));
    }

    stream = (int *)((char *)stream + size);
    idx = stream;
    stream += 1;
  }
}
