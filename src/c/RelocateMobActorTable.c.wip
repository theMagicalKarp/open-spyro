extern int g_pWorkAreaTop[];    /* 0x800785fc */
extern int *g_apActorMeshTable; /* 0x80076378 */

/* The loader rewrites the mesh table under us, so every read of the table
   pointer is a fresh one and every pointer written back into it is published
   immediately. */
#define MESH_TABLE (*(int *volatile *)&g_apActorMeshTable)
#define PUBLISH(p) (*(volatile int *)(p))

/* PARKED 2026-08-10-4 — 108/108 insns, LENGTH- AND SCHEDULE-EXACT (every
 * instruction is the right opcode in the right position, including all 18
 * load-delay nops). Residue: ONE whole-function register rotation, a0<->a2
 * (plus the a1/a3 and t2/t3 pairs that follow it). The original puts the
 * loop-1 counter in a0 and copies the `stream` param out to a2 (`move a2,a0`
 * at insn 1); ours keeps the param in a0 and the counter lands in a2.
 *
 * Decoded fresh this session (the old permuter body is at f172dda); every
 * structural knot is solved and each lever is load-bearing:
 *   - all table/entry accesses are INDEX form off the base, never a pointer
 *     walker, so loop.c's DEST_ADDR givs keep +0x38/+0x14 in the addressing
 *     mode and the giv init stays `move rd,base` (see RelocateActorMeshHeader).
 *   - MESH_TABLE reads volatile: cse would otherwise fold the 5 reloads per
 *     record into one (a store to `(plus reg const)` does NOT invalidate a
 *     scalar global — cse.c's "varying address that is a sum indicates an
 *     array element" rule).
 *   - the stores are volatile TOO (PUBLISH): sched.c's true_dependence only
 *     forces an ordering when BOTH refs are volatile, so with plain stores
 *     sched1 hoists the next statement's `lui/lw` into the load-delay slots
 *     and 13 nops disappear. Volatile stores + plain reads is the exact pair:
 *     making the field READS volatile as well costs the `lh`->`lhu;sll;sra`
 *     widening (B13) and pins the field load out of the lh delay slot.
 *   - the inner loop re-fetches `mesh` from the table at the END of its body,
 *     which is what puts the reload + `addiu j,j,1` in the bottom test while
 *     the loop GUARD still uses the entry loaded before the loop.
 *   - `count` is split into two statements (`count = (count<<2)+0x24;` then
 *     `base = (int)stream + count;`) or fold reassociates it into a hoisted
 *     `stream+0x24` preheader invariant (A46).
 *
 * Why the rotation is not reachable from source (measured with `cc1 -dg`):
 * allocation order is 74 79 73 90 ..., i.e. the first allocno is allocated
 * with `regs_used_so_far` already non-empty, so find_reg's PASS 0 succeeds and
 * pass 0 excludes `regs_someone_prefers` = {a0} (the param allocno 72 prefers
 * a0, conflicts with everything, and is lower priority). For the original's
 * assignment the counter has to take a0 in spite of that preference, which
 * only happens if pass 0 finds nothing at all. Note MIPS has no
 * REG_ALLOC_ORDER, so find_reg is lowest-regno-first, NOT lowest local
 * density (the density loop is only the eviction fallback taken when
 * best_reg < 0). Tried and rejected: `i` first in the declaration list, a
 * separate `stream = arg;` walker local (gcc coalesces the copy), separate vs
 * shared loop counters (both 84/108 strict; the shared counter is kept because
 * it gets loop 1's a1/a3/t0/v0/v1 exactly right).
 */

/* 0x80013230 — bind a freshly loaded mob-actor mesh stream to the actor mesh
   table (432 b, leaf). First every one of the 46 table slots whose mesh
   pointer still points below the work-area top (or is the -1 empty marker) is
   cleared, then the stream is walked: each record starts with its actor index
   and byte size, and the record body that follows is installed as that
   actor's mesh. The mesh's vertex block sits past its packed-word array, so
   that address becomes the relocation base for the +0x10 field and for the
   packed 21-bit words at +0x24. */
void RelocateMobActorTable(int *stream) {
  int i;
  int *mesh;
  int *w;
  int idx;
  int size;
  int base;
  int count;
  int word;
  int lo;

  for (i = 0; i < 0x2E; i++) {
    int *tbl = MESH_TABLE;
    if ((unsigned int)tbl[14 + i] < (unsigned int)g_pWorkAreaTop[0] ||
        tbl[14 + i] == -1) {
      tbl[14 + i] = 0;
    }
  }

  idx = stream[0];
  while (idx >= 0) {
    stream++;
    size = stream[0];
    stream++;

    {
      int *tbl = MESH_TABLE;
      PUBLISH(&tbl[14 + idx]) = (int)stream;
    }
    {
      int *tbl = MESH_TABLE;
      mesh = (int *)tbl[14 + idx];
      PUBLISH(&mesh[5]) = tbl[13] + mesh[5];
    }
    {
      int *tbl = MESH_TABLE;
      mesh = (int *)tbl[14 + idx];
      PUBLISH(&mesh[6]) = tbl[13] + mesh[6];
    }
    mesh = (int *)MESH_TABLE[14 + idx];
    count = *(short *)mesh;
    count = (count << 2) + 0x24;
    base = (int)stream + count;
    PUBLISH(&mesh[4]) = base + mesh[4];

    mesh = (int *)MESH_TABLE[14 + idx];
    w = mesh + 9;
    for (i = 0; i < *(short *)mesh; i++) {
      word = *w;
      lo = (((word & 0x1FFFFF) + base) >> 1) & 0x1FFFFF;
      *w = (word & 0xFFE00000) + lo;
      w++;
      mesh = (int *)MESH_TABLE[14 + idx];
    }

    stream = (int *)((int)stream + size);
    idx = stream[0];
  }
}
