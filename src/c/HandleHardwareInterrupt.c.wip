#include "globals.h"

/* Master hardware-interrupt dispatcher hooked at the BIOS exception vector.
   Reads (I_MASK & enable-mask & I_STAT); for each of up to 11 IRQ sources ACKs
   the bit in I_STAT and calls g_apfnIrqHandlers[i]. Re-loops while any source
   remains pending, with a 0x800-cycle watchdog. (0x8005e03c, 488 bytes.) */

extern int WritePrintf();
extern void ReturnFromException(void);
extern unsigned short
    g_anLibapiIrqBlock[]; /* alias @0x80073924: [0]=g_nLibapiCallbackInstalled,
                             +4=g_apfnIrqHandlers */
extern unsigned char D_80011640[]; /* "unexpected interrupt(%04x)\n" */
extern unsigned char D_8001165C[]; /* "intr timeout(%04x:%04x)\n" */

void HandleHardwareInterrupt(void) {
  unsigned short *p;
  void (**base)();
  void (**h)();
  int i;
  int bit;
  unsigned int mask;
  unsigned int pend;
  unsigned int stat;

  p = g_anLibapiIrqBlock;
  if (p[0] == 0) {
    WritePrintf(D_80011640, *((volatile unsigned short *)g_pIStatReg));
    ReturnFromException();
  }
  g_nInIsrFlag = 1;
  stat = ((unsigned int)(*((unsigned short *)(&g_nIrqEnableMask)))) &
         (*((volatile unsigned short *)g_pIStatReg));
  pend = (*((volatile unsigned short *)g_pIMaskReg)) & stat;
  mask = pend;
  if (pend != 0) {
    bit = 1;
    base = (void (**)())(p + 2);
    do {
      i = 0;
      if (mask != 0) {
        h = base;
        while (1) {
          if (i >= 0xB) {
            break;
          }
          if (mask & 1) {
            *((volatile unsigned short *)g_pIStatReg) = ~(bit << i);
            if ((*h) != 0) {
              (*h)();
            }
          }
          h++;
          mask >>= 1;
          i++;
          if ((mask & 0xFFFF) == 0) {
            break;
          }
        }
      }
      stat = ((unsigned int)(*((unsigned short *)(&g_nIrqEnableMask)))) &
             (*((volatile unsigned short *)g_pIStatReg));
      pend = (*((volatile unsigned short *)g_pIMaskReg)) & stat;
      mask = pend;
    } while (pend != 0);
  }
  if (((*((volatile unsigned short *)g_pIStatReg)) &
       (*((volatile unsigned short *)g_pIMaskReg))) != 0) {
    int old = g_nIsrTimeoutCounter;
    g_nIsrTimeoutCounter = old + 1;
    if (old > 0x800) {
      WritePrintf(D_8001165C, *((volatile unsigned short *)g_pIStatReg),
                  *((volatile unsigned short *)g_pIMaskReg));
      g_nIsrTimeoutCounter = 0;
      *((volatile unsigned short *)g_pIStatReg) = 0;
    }
  } else {
    g_nIsrTimeoutCounter = 0;
  }
  g_nInIsrFlag = 0;
  ReturnFromException();
}

/* PARKED 2026-08-15 at 91.8% (10/122), LENGTH-EXACT — was 26/122. The
   2026-07-25 permuter body is gone; this is a from-scratch decode. Three of the
   four residues in the 2026-08-12-2 note are now CLOSED:
     - the `move s0,v0` copy in both branch delay slots: the tested value and
       the working mask are different variables AND the copy must sit
       immediately before the test (`pend = <expr>; mask = pend; if (pend)`),
       once before the loop and once at the end of the body. Putting `mask =
       pend;` at the TOP of the body (tried 2026-08-12-2) leaves the copy
       stranded — reorg only reaches it from the insn adjacent to the branch.
     - `and v0,v0,v1` (the outer AND writing the imask value's register): the
       intermediate needs its OWN local (`stat`), not a reuse of `pend`. With
       one variable for both ANDs the second AND ties its dest to the
       intermediate instead of the imask load.
     - the tail's `lw a1(I_STAT)` / `lw a2(I_MASK)` order: write the final guard
       `I_STAT & I_MASK`, not `I_MASK & I_STAT` — the first-expanded operand's
       pointer load is emitted first (the AND encodes identically either way,
       so this reads as a no-op change but moves 6 insns).
     - `li s3,1` before `addiu s4,s1,4`: make the shift constant an explicit
       local (`bit = 1;`) written BEFORE `base = ...`. As a loop.c hoist of the
       literal it is emitted after the source statement, i.e. the wrong way
       round; hoisting `base` instead (writing `h = (void(**)())(p+2)` inside
       the loop) does NOT work — loop.c leaves it in the loop as
       `addiu s2,s4,4` and the function comes out one insn short.

   REMAINING (10 insns, 5 per recompute block, ×2): a 2-register swap between
   the g_pIStatReg POINTER (orig a0, ours v1) and the g_nIrqEnableMask VALUE
   (orig v1, ours a0). The emitted ORDER is already identical, so this is purely
   local-alloc priority (`qty_compare` = floor_log2(refs)*refs*size/live_length)
   on two block-local qtys. §D 2c probe on this body: reg 88 (the pointer)
   2 refs / 8 insns, reg 89 (the enable value) 2 refs / 10 insns — the pointer
   wins on the shorter range and takes v1 (v1 precedes a0 in reg_alloc_order).
   To flip it the enable needs 3 refs at that length, or a range under 8.
   Everything tried costs +1 insn and overflows the slot: operand-swapping the
   inner AND, splitting it (`stat = enable; stat &= *I_STAT;`), a `statval`
   temp for the I_STAT deref, and A195's `do {} while (0)` ref dial around the
   enable read (that one makes `en` a cross-block allocno: 24/122). Swapping the
   OUTER AND's operands is a true no-op (10/122 either way). */
