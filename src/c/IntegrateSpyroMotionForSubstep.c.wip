          g_nSpyroBodyYawStep <<= 4;
          if (g_nSpyroBodyYawStep < -0x10) {
            g_nSpyroBodyYawStep = -0x10;
          }
          if (g_nSpyroBodyYawStep > 0x10) {
            g_nSpyroBodyYawStep = 0x10;
