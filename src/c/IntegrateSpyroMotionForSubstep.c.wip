    }
    g_nPulseRumbleAmount = ((sp[0] - 0x1400) >> 7) + 0x14;
    if (g_nPulseRumbleAmount < 0x50) {
      g_nPulseRumbleAmount = 0x50;
    }
    if (g_nPulseRumbleAmount > 0xA0) {
      g_nPulseRumbleAmount = 0xA0;
    }
    if (g_nPulseRumbleTimer < 4) {
      g_nPulseRumbleTimer = 4;
    }
    break;
