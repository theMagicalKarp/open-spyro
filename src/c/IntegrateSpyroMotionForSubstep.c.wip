        g_nSpyroVelocityZ = g_anSpyroMotionVec[2];
        g_nSpyroVelocityZ = g_anSpyroMotionVec[2] + g_nSpyroGravityStep;
        if (g_nSpyroVelocityZ < -0x780) {
          g_nSpyroVelocityZ = -0x780;
        }
        g_nSpyroBodyRoll = 0;
      }
      PITCH_TOWARD_TURN();
