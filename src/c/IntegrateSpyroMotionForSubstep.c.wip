    zb = &D_80078A60;
    OPAQUE(zb);
    base = D_80075668;
    z = zb[0];
    if (z < base + 0x400) {
      lift = g_nSpyroCarryMotionZ + 0x80;
      if (lift > 0x12C0) {
        lift = 0x12C0;
      }
      CopyVector(v80, zb + 0x5D);
      a = zb[0] - D_80075668;
      g_nSpyroStateFlags = 0;
      g_nSpyroMoveTargetMag = 0x400;
      a = ((a * a) >> 11) + D_8007578C;
    } else if (z < zb[0x54] - 0x400) {
      if (g_nSpyroStateFlags <= 0) {
        g_nSpyroStateFlags = 1;
        D_8007578C += 0x200;
      }
      m = z - base - 0x400;
      a = D_8007578C + (D_800757F0 * m) / D_80075724;
      g_nSpyroMoveTargetMag = 0xC80;
      a = (a + ((m << 10) >> 10)) & 0xFFF;
      lift = 0x12C0;
      if (reach < m) {
        m = reach;
      }
      v80[0] = (m * LookupCosine(g_nSpyroBodyYaw)) >> 12;
      v80[1] = (m * LookupSine(g_nSpyroBodyYaw)) >> 12;
      AddVector(v80, v80, zb + 0x5D);
    } else {
      a = (g_nSpyroBodyYaw -
           (((unsigned char *)g_pScriptedCameraActor)[0x46] << 4)) &
          0xFFF;
      m = reach;
      if (a > 0x800) {
        a -= 0x1000;
      }
      if (abs(a) < 0x100) {
        m += 0x800;
      }
      v80[0] = (m * LookupCosine(g_nSpyroBodyYaw)) >> 12;
      v80[1] = (m * LookupSine(g_nSpyroBodyYaw)) >> 12;
      AddVector(v80, v80, zb + 0x5D);
      a = zb[0x54] - zb[0];
      lift = (a * 0x12C0) >> 10;
      a = (((unsigned char *)g_pScriptedCameraActor)[0x46] << 4) -
          ((a * a) >> 11);
      g_nSpyroMoveTargetMag = 0xC80;
    }
    v80[2] = 0;
    SubtractVector(v80, v80, g_anSpyroWorldPos);
    m = VectorLength(v80, 0);
    if (g_nSpyroMoveTargetMag < m) {
      ScaleVector3ByRatio(v80, m, g_nSpyroMoveTargetMag);
    }
    CopyVector(g_anSpyroWorldPos + SPY_CARRY, v80);
    CopyVector(g_anSpyroWorldPos + SPY_VELOCITY, g_anSpyroWorldPos + SPY_CARRY);
    g_nSpyroCarryMotionZ = lift;
    g_nSpyroVelocityZ = lift;
    g_nSpyroBodyYaw = a & 0xFFF;
    break;
  }
  case 19: {
    int *carry;
    int l;

    LOCKOUT_TICK(&SPY[SPY_LOCKOUT]);
    RotateSpyroBodyTowardKnockbackDir(8, 4);
    if (g_nSpyroGroundSlope < 0x17) {
      int *c2 = &SPY[SPY_CARRY];

      ZeroVector(v90);
      SubtractVector(v90, v90, c2);
      l = VectorLength(v90, 1);
      if (l > 0x100) {
        ScaleVector3ByRatio(v90, l, 0x100);
      }
      AddVector(c2, c2, v90);
    }
    carry = g_anSpyroCarryMotionVec;
    AddVector(carry, carry, carry - 6);
    l = VectorLength(carry, 1);
    g_nSpyroMotionSpeed = l;
    if (l > 0x2300) {
      ScaleVector3ByRatio(carry, l, 0x2300);
      g_nSpyroMotionSpeed = 0x2300;
    }
    AddVector(carry + 3, carry, D_80078B34);
    break;
  }
  case 20: {
    int x;
    int y;
    int a;
    int c;
    int *w;

    LOCKOUT_TICK(&SPY[SPY_LOCKOUT]);
    READ_STICK(x, y);
    a = (SPY[SPY_YAW] - g_nCameraEulerYaw) & 0xFFF;
    c = LookupCosine(a);
    g_nSpyroBodyYawStep = (-x * c - y * LookupSine(a)) >> 13;
    if (g_nSpyroBodyYawStep < RAMP[0]) {
      g_nSpyroBodyYawStep = RAMP[0];
    }
    if (g_nSpyroBodyYawStep > RAMP[12]) {
      g_nSpyroBodyYawStep = RAMP[12];
    }
    IntegrateSpyroBodyEuler(g_nSpyroBodyYawStep);
    if (g_nSpyroStateFlags & 0x40) {
      SPEED_FROM_DROP_T(g_nSpyroSpeedTarget);
      sp = &SPY[SPY_SPEED];
      OPAQUE(sp);
      if (sp[0] > 0x5900) {
        sp[0] = 0x5900;
      }
      sp[SPY_VELOCITY - SPY_SPEED] =
          (sp[0] * LookupCosine(g_nSpyroBodyYaw)) >> 12;
      g_nSpyroVelocityY = (sp[0] * LookupSine(g_nSpyroBodyYaw)) >> 12;
      CopyVector(sp + (SPY_CARRY - SPY_SPEED), sp + (SPY_VELOCITY - SPY_SPEED));
    } else {
      g_nSpyroSpeedTarget = 0x1E00;
      AdvanceSpyroSpeedTowardTarget(0x240, 0x180);
      g_anSpyroVelocity[0] =
          (g_nSpyroMotionSpeed * LookupCosine(SPY[SPY_YAW])) >> 12;
      g_nSpyroVelocityY =
          (g_nSpyroMotionSpeed * LookupSine(SPY[SPY_YAW])) >> 12;
    }
    w = &SPY[SPY_WALL_SLIDE];
    OPAQUE(w);
    WALL_SLIDE(w, ;);
    SPY[SPY_VELOCITY + 2] -= 0xC0;
    if (SPY[SPY_VELOCITY + 2] < -0x2300) {
      SPY[SPY_VELOCITY + 2] = -0x2300;
    }
    break;
  }
  case 24: {
    int x;
    int y;
    int a;
    int c;
    int *yp;

    LOCKOUT_TICK(&SPY[SPY_LOCKOUT]);
    READ_STICK(x, y);
    yp = &SPY[SPY_YAW];
    OPAQUE(yp);
    a = (yp[0] - g_nCameraEulerYaw) & 0xFFF;
    c = LookupCosine(a);
    g_nSpyroBodyYawStep = (-x * c - y * LookupSine(a)) >> 13;
    if (g_nSpyroBodyYawStep < RAMP[0]) {
      g_nSpyroBodyYawStep = RAMP[0];
    }
    if (g_nSpyroBodyYawStep > RAMP[12]) {
      g_nSpyroBodyYawStep = RAMP[12];
    }
    IntegrateSpyroBodyEuler(g_nSpyroBodyYawStep);
    yp[SPY_VELOCITY - SPY_YAW] =
        (g_nSpyroMotionSpeed * LookupCosine(yp[0])) >> 12;
    g_nSpyroVelocityY = (g_nSpyroMotionSpeed * LookupSine(yp[0])) >> 12;
    CopyVector(yp + (SPY_CARRY - SPY_YAW), yp + (SPY_VELOCITY - SPY_YAW));
    if (g_nSpyroStateTimer >= 5) {
      g_nSpyroVelocityZ -= g_nSpyroGravityStep;
    }
    CLAMP_FALL_SPEED();
    break;
  }
  case 26: {
    int *obj;
    int *obj2;
    int *pa;
    int dist;
    int ang;
    int dt;
    int a;
    int v;

    obj = ((int **)g_pScriptedCameraActor)[0];
    LOCKOUT_TICK(&SPY[SPY_LOCKOUT]);
    obj2 = obj;
    SubtractVector(vA0, (int *)g_pScriptedCameraActor + 3, &SPY[0]);
    dist = VectorLength(vA0, 0);
    ang = ArcTan2(vA0[0], vA0[1], 1);
    dt = (g_nSpyroStateFlags == 1 ? -g_nSpyroTurnRateAccum
                                  : g_nSpyroTurnRateAccum) >>
         6;
    ComputeSpyroMoveTargetFromPad(0x280);
    TurnSpyroTowardMoveTargetWithLean(0);
    g_nSpyroTurnRateAccum += 0x20;
    if (g_nSpyroSpeedTarget < g_nSpyroTurnRateAccum) {
      g_nSpyroTurnRateAccum = g_nSpyroSpeedTarget;
    }
    a = (ang + dt + 0x800) & 0xFFF;
    if (((short *)g_pScriptedCameraActor)[0x1B] == 0xFF) {
      v = obj2[5] = (obj2[5] + dt) & 0xFFF;
    } else {
      v = obj[5] = (obj[5] + dt) & 0xFFF;
    }
    ((unsigned char *)g_pScriptedCameraActor)[0x46] = v >> 4;
    vA0[0] = (dist * LookupCosine(a)) >> 12;
    vA0[1] = (dist * LookupSine(a)) >> 12;
    pa = &SPY[SPY_SCRIPTED_ACTOR];
    OPAQUE(pa);
    AddVector(vA0, vA0, ((int **)pa)[0] + 3);
    SubtractVector(vA0, vA0, pa - SPY_SCRIPTED_ACTOR);
    vA0[2] = 0;
    LShiftVector3(vA0, 6);
    CopyVector(pa + (SPY_VELOCITY - SPY_SCRIPTED_ACTOR), vA0);
    g_nSpyroBodyYaw = (g_nSpyroBodyYaw + dt) & 0xFFF;
    if (g_nSpyroCliffEdgeHint != 0) {
      pa[SPY_VELOCITY + 2 - SPY_SCRIPTED_ACTOR] -= 0xC0;
    } else {
      AddVector(g_anSpyroVelocity, g_anSpyroVelocity, D_80078B34);
    }
    break;
