  case 17: {
    int *actor;
    int reach;
    int *zb;
    int lift;
    int a;
    int base;
    int z;
    int m;

    LOCKOUT_TICK(&SPY[SPY_LOCKOUT]);
    actor = (int *)SPY[SPY_SCRIPTED_ACTOR];
    if (actor == 0) {
      break;
    }
    reach = 0x500;
    if (((short *)actor)[0x1B] == 0x12C) {
      reach = ((int **)actor)[0][1];
