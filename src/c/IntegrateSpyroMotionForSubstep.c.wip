        } else {
          y = FindGroundHeightBelow(&SPY[0], 0x10000);
          if (g_nSpyroGlideBankingFlag != 0) {
            int d = D_80078A60 - y;

            if (d < 0x200) {
              LEVEL_GLIDE_HANDOFF();
            } else if (d < 0x800) {
              y = (-0x100 - g_nSpyroBodyRoll) & 0xFFF;
              if (y > 0x800) {
                y -= 0x1000;
              }
              y >>= 2;
              if (y < -0x3C) {
                y = -0x3C;
              }
              if (y > 0x3C) {
