      l = VectorLength(vB0, 0);
      if (l > 0x40) {
        ScaleVector3ByRatio(vB0, l, 0x40);
      }
      vB0[2] = -0xC0;
      AddVector(vel, vel, vB0);
    } else {
      l = VectorLength(vB0, 1);
      if (l > 0x100) {
        ScaleVector3ByRatio(vB0, l, 0x100);
      }
      AddVector(vel, vel, vB0);
      AddVector(vel, vel, &SPY[SPY_PLATFORM]);
    }
    if (SPY[SPY_VELOCITY + 2] < -0x2300) {
      SPY[SPY_VELOCITY + 2] = -0x2300;
    }
    break;
  }
  case 29:
    ZeroVector(g_anSpyroVelocity);
    break;
  case 30:
  case 31: {
    int *carry = &SPY[SPY_CARRY];
    int *vel = &SPY[SPY_VELOCITY];

    carry[0] -= carry[0] >> 4;
    g_nSpyroCarryMotionY -= g_nSpyroCarryMotionY >> 4;
    g_nSpyroCarryMotionZ -= g_nSpyroCarryMotionZ >> 4;
    CopyVector(vel, carry);
    FINISH_VELOCITY();
    break;
