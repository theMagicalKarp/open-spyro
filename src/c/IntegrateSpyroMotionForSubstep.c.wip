          g_nSpyroBodyYawStep =
              ((g_abSpyroRequestEuler[2] << 4) - g_nSpyroBodyYaw) & 0xFFF;
          if (g_nSpyroBodyYawStep > 0x800) {
            g_nSpyroBodyYawStep -= 0x1000;
