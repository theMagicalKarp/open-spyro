          } else {
          bank:
            y = 0x1E;
            if ((unsigned int)(g_nSpyroBodyRoll + 0x100) > 0x500) {
              g_nSpyroGlideBankingFlag = 1;
              y = (-0x400 - g_nSpyroBodyRoll) & 0xFFF;
              if (y > 0x800) {
                y -= 0x1000;
              }
              if (g_nActiveLevelId == 0x16 && abs(y) < 0x100) {
                g_nCameraNextMode = (&g_abSpyroStateCameraMode)[g_nSpyroState];
              }
              y >>= 4;
              if (y < -0x1E) {
                y = -0x1E;
