extern void ChangeSpyroState(int state);
extern void ComputeSpyroMoveTargetFromPad(int mag);
extern int ApplyPadInputToSpyroBodyYaw(void);
extern int TurnSpyroTowardMoveTargetWithLean(int lean);
extern void AdvanceSpyroSpeedTowardTarget(int accel, int decel);
extern void BuildSpyroVelocityFromBodyEuler(void);
extern void IntegrateSpyroBodyEuler(int delta);
extern void NudgeSpyroFromWallProbes(void);
extern void RotateSpyroBodyTowardKnockbackDir(int rate, int lean);
extern int AbsAngleDelta12(int a, int b);
extern int ArcTan2(int y, int x, int high_precision);
extern int LookupCosine(int angle);
extern int LookupSine(int angle);
extern int IntegerSqrt(int n);
extern int VectorLength(int *vec, int include_z);
extern void SetVector3Magnitude(int *vec, int mag);
extern void ScaleVector3ByRatio(int *vec, int num, int den);
extern void ScaleVector3Shifted(int *vec, int num, int shift);
extern void AddVector(int *dst, int *a, int *b);
extern void SubtractVector(int *dst, int *a, int *b);
extern void CopyVector(int *dst, int *src);
extern void ZeroVector(int *vec);
extern void RShiftVector3(int *vec, int shift);
extern void LShiftVector3(int *vec, int shift);
extern void RotateVectorByMatrix(int *mtx, int *src, int *dst);
extern void LerpVectorGTE(int *dst, int *a, int *b, int t);
extern void AccumulateAnimRootMotionDelta(int frame, int *out, int anim,
                                          int sub);
extern int CheckLineOfSightSegment(int *from, int *to);
extern int FindGroundHeightBelow(int *pt, int depth);
extern void ActivateScriptedCameraView(int *record);
extern int ApproxDist2D(int *a, int *b);
extern int abs(int x);

extern int D_80078A60; /* g_anSpyroWorldPos[2] */
extern int g_nSpyroWorldPosY;
extern int g_nSpyroVelocityY;    /* g_anSpyroVelocity[1] */
extern int g_nSpyroVelocityZ;    /* g_nSpyroVelocityZ */
extern int g_nSpyroCarryMotionY; /* g_nSpyroCarryMotionY */
extern int g_nSpyroCarryMotionZ; /* g_nSpyroCarryMotionZ */
extern int D_80078B34[];
extern int D_800756B4;
extern int D_80075668;
extern int D_80075700;
extern int D_80075724;
extern int D_8007578C;
extern int D_80075790;
extern int D_800757F0;
extern int D_8006E7DC[];
extern int D_8006E7E4[];

SDATA(D_80075668, 4);
SDATA(D_800756B4, 4);
SDATA(D_80075724, 4);
SDATA(D_8007578C, 4);
SDATA(D_80075790, 4);
SDATA(D_800757F0, 4);
SDATA(g_pSpyroContactActor, 4);

/* One view of the Spyro record from its world position (0x80078a58). */
extern int g_anSpyroWorldPosBlock[];
extern int g_anCameraPosBlock[];
extern int g_anSpyroWorldPosZBlock[];
extern short g_anCameraEulerYawBlock[];
extern unsigned int g_adwPadPressedBlock[];
extern unsigned char g_abSpyroAnimPrevBlock[];
extern int g_anSpyroDeathCamRecordBlock[];

#define SPY g_anSpyroWorldPosBlock
#define SPY_STATE_FLAGS 0x1F    /* g_nSpyroStateFlags */
#define SPY_AIRBORNE 0x27       /* g_nSpyroAirborneFrames */
#define SPY_WALL_SLIDE 0x2D     /* g_nSpyroWallSlideContributedFlag */
#define SPY_NUDGE 0x2E          /* g_anSpyroWallSlideNudgeAccum */
#define SPY_CLIFF 0x31          /* g_nSpyroCliffEdgeHint */
#define SPY_SPEED_TARGET 0x32   /* g_nSpyroSpeedTarget */
#define SPY_PLATFORM 0x37       /* D_80078B34 */
#define SPY_CARRY 0x3A          /* g_anSpyroCarryMotionVec */
#define SPY_VELOCITY 0x3D       /* g_anSpyroVelocity */
#define SPY_VELOCITY_FP6 0x40   /* g_anSpyroVelocityFp6 */
#define SPY_SPEED 0x46          /* g_nSpyroMotionSpeed */
#define SPY_YAW 0x47            /* g_nSpyroBodyYaw */
#define SPY_ROLL 0x48           /* g_nSpyroBodyRoll */
#define SPY_PITCH 0x49          /* g_nSpyroBodyPitch */
#define SPY_FRAME_MOTION 0x4A   /* g_nSpyroFrameMotionLength */
#define SPY_LOCKOUT 0x58        /* g_nSpyroInputLockoutCountdown */
#define SPY_SCRIPTED_ACTOR 0x89 /* g_pScriptedCameraActor */
#define SPY_CHARGE_HOLD 0x94    /* g_nSpyroChargeHoldFlag */
#define SPY_GLIDE_BANK 0x95     /* g_nSpyroGlideBankingFlag */

#define PADB ((unsigned char *)g_pPadSubstepState)
#define PADW ((int *)g_pPadSubstepState)
#define RAMP ((signed char *)g_abSpyroEulerRateRampSigned)

#define PARTICLE_SPAWN(a, b, c, d)                                             \
  ((void (*)(int, int, int *, int))g_pfnLevelOverlayParticleSpawn)(a, b, c, d)

/* Opaque copy: the result is a fresh value to cse, so a block address stays
   in its register and later fields are addressed off it. */
static inline int OpaqueInt(int p) {
  int q;

  __asm__("" : "=r"(q) : "0"(p));
  return q;
}

static inline int *Opaque(int *p) {
  int *q;

  __asm__("" : "=r"(q) : "0"(p));
  return q;
}

#define OPAQUE(v) __asm__("" : "=r"(v) : "0"(v))

/* Input lockout frames count down to zero. */
#define LOCKOUT_TICK(p)                                                        \
  {                                                                            \
    int n = (p)[0] - 1;                                                        \
                                                                               \
    (p)[0] = n;                                                                \
    if (n < 0) {                                                               \
      (p)[0] = 0;                                                              \
    }                                                                          \
  }

/* Analog stick (or d-pad) as signed x/y in -0x7F..0x7F. */
#define READ_STICK(x, y)                                                       \
  if (PADW[4] != 0) {                                                          \
    x = PADB[0x16] - 0x7F;                                                     \
    y = 0x7F - PADB[0x17];                                                     \
  } else {                                                                     \
    if (PADW[1] & 0x1000) {                                                    \
      y = 0x7F;                                                                \
    } else {                                                                   \
      y = (PADW[1] & 0x4000) ? -0x7F : 0;                                      \
    }                                                                          \
    if (PADW[1] & 0x2000) {                                                    \
      x = 0x7F;                                                                \
    } else {                                                                   \
      x = (PADW[1] & 0x8000) ? -0x7F : 0;                                      \
    }                                                                          \
  }

/* Slide along the wall that pushed Spyro: add the into-wall share of the
   velocity back along the nudge direction. */
#define WALL_SLIDE(w, setspeed)                                                \
  if ((w)[0] != 0) {                                                           \
    int *nudge = (w) + 1;                                                      \
    int k;                                                                     \
                                                                               \
    g_anSpyroWallSlideNudgeAccum[2] = 0;                                       \
    SetVector3Magnitude(nudge, 0x1000);                                        \
    k = (-(w)[0x10] * (w)[1] -                                                 \
         g_nSpyroVelocityY * g_anSpyroWallSlideNudgeAccum[1]) >>               \
        12;                                                                    \
    (w) += 0x10;                                                               \
    if (k > 0) {                                                               \
      ScaleVector3ByRatio(nudge, 0x1000, k);                                   \
      AddVector((w), (w), nudge);                                              \
      setspeed;                                                                \
    }                                                                          \
  }

/* On the ground the platform carry is added; airborne or at a cliff edge
   gravity takes over. */
#define FINISH_VELOCITY()                                                      \
  if (g_nSpyroCliffEdgeHint != 0 || g_nSpyroAirborneFrames != 0) {             \
    g_nSpyroVelocityZ = g_anSpyroMotionVec[2] - 0xC0;                          \
  } else {                                                                     \
    AddVector(g_anSpyroVelocity, g_anSpyroVelocity, D_80078B34);               \
  }

#define CLAMP_FALL_SPEED()                                                     \
  if (g_nSpyroVelocityZ < -0x2300) {                                           \
    g_nSpyroVelocityZ = -0x2300;                                               \
  }

/* Glide/charge speed from the height fallen below the floor reference. */
#define SPEED_FROM_DROP(base, shift)                                           \
  {                                                                            \
    int f = g_nSpyroFloorReferenceZ - D_80078A60;                              \
                                                                               \
    if (f < 0) {                                                               \
      g_nSpyroMotionSpeed = (base) - IntegerSqrt(-f << (shift));               \
    } else {                                                                   \
      g_nSpyroMotionSpeed = IntegerSqrt(f << (shift)) + (base);                \
    }                                                                          \
  }

#define SPEED_FROM_DROP_T(base)                                                \
  {                                                                            \
    int f = g_nSpyroFloorReferenceZ - D_80078A60;                              \
    int v;                                                                     \
                                                                               \
    if (f < 0) {                                                               \
      v = (base) - IntegerSqrt(-f << 13);                                      \
    } else {                                                                   \
      v = (base) + IntegerSqrt(f << 13);                                       \
    }                                                                          \
    g_nSpyroMotionSpeed = v;                                                   \
  }

/* Ease the pitch toward a yaw-rate-dependent bank. */
#define PITCH_TOWARD_TURN()                                                    \
  {                                                                            \
    int p = (g_nSpyroBodyYawStep * -8 - g_nSpyroBodyPitch) & 0xFFF;            \
                                                                               \
    if (p > 0x800) {                                                           \
      p -= 0x1000;                                                             \
    }                                                                          \
    if (p > 0x10) {                                                            \
      p = 0x10;                                                                \
    } else if (p < -0x10) {                                                    \
      p = -0x10;                                                               \
    }                                                                          \
    SPY[SPY_PITCH] = (SPY[SPY_PITCH] + p) & 0xFFF;                             \
  }

#define LEVEL_GLIDE_HANDOFF()                                                  \
  {                                                                            \
    g_nSpyroStateFlags = 0;                                                    \
    g_bSpyroOtBinBias = 4;                                                     \
    g_nCameraNextMode = (&g_abSpyroStateCameraMode)[g_nSpyroState];            \
  }

#define APPROACH_GLIDE_SPEED(t)                                                \
  if ((t)[SPY_SPEED - SPY_SPEED_TARGET] < (t)[0]) {                            \
    (t)[SPY_SPEED - SPY_SPEED_TARGET] += 0x80;                                 \
    if ((t)[SPY_SPEED - SPY_SPEED_TARGET] > (t)[0]) {                          \
      (t)[SPY_SPEED - SPY_SPEED_TARGET] = (t)[0];                              \
    }                                                                          \
  } else if ((t)[SPY_SPEED - SPY_SPEED_TARGET] > (t)[0]) {                     \
    (t)[SPY_SPEED - SPY_SPEED_TARGET] -= 0x80;                                 \
    if ((t)[SPY_SPEED - SPY_SPEED_TARGET] < (t)[0]) {                          \
      (t)[SPY_SPEED - SPY_SPEED_TARGET] = (t)[0];                              \
    }                                                                          \
  }

/* Spyro motion for one pad substep (0x80043fe4, 15228 bytes): steering,
   speed and velocity per state, the glide flight model, then the 1/64
   position accumulator and the persistent byte euler angles. */
void IntegrateSpyroMotionForSubstep(int substep) {
  int v10[3];
  int v20[3];
  int v30[3];
  int v40[3];
  int v50[3];
  int v60[3];
  int v70[3];
  int v80[3];
  int v90[3];
  int vA0[3];
  int vB0[3];
  int t;
  int *sp;

  g_pPadSubstepState = &g_anPadSubstepRing[substep * 6];
  t = g_nSpyroStateTimer + substep;
  if (g_nGamestate == 0 && g_nActiveLevelId == 0x40 &&
      g_nSpyroAirborneFrames == 0) {
    g_nSpyroFallTrackingFlag = 1;
  }
  switch (g_nSpyroState) {
  case 0:
  case 13:
  case 18:
  case 36:
  case 37:
  case 38:
  case 39:
  case 40:
  case 41:
  case 42:
  case 43:
    LOCKOUT_TICK(&SPY[SPY_LOCKOUT]);
    if (g_nSpyroScriptedMoveMode == 0) {
      ComputeSpyroMoveTargetFromPad(0);
    } else if (g_nSpyroStateTimer > 0x2C && g_bSpyroHornCollisionActive == 0) {
      if (g_nSpyroStateFlags != 0) {
        g_nSpyroScriptedMoveMode = 0;
      } else {
        g_nSpyroStateFlags = 1;
        g_adwPadPressedBlock[0] |= 0x20;
      }
    }
    ZeroVector(g_anSpyroVelocity);
    break;
  case 1:
  case 2:
  case 21: {
    int r;
    int *w;

    LOCKOUT_TICK(&SPY[SPY_LOCKOUT]);
    if (g_nSpyroScriptedMoveMode == 0) {
      ComputeSpyroMoveTargetFromPad(g_nSpyroMoveTargetMag);
    } else {
      int d = (g_nSpyroMoveTargetYaw - g_nSpyroBodyYaw) & 0xFFF;

      if (d > 0x800) {
        d -= 0x1000;
      }
      if (abs(d) < 0x10) {
        ChangeSpyroState(0);
      }
    }
    g_nSpyroStateFlags = 0;
    if (g_nSpyroMotionSpeed < 0x400) {
      r = ApplyPadInputToSpyroBodyYaw();
    } else {
      int lean = 2;

      if (g_nSpyroMotionSpeed < 0xC80) {
        lean = 1;
      }
      r = TurnSpyroTowardMoveTargetWithLean(lean);
    }
    if (g_nSpyroStateFlags != 0) {
      int s = g_nSpyroMotionSpeed - 0xC0;

      g_nSpyroMotionSpeed = s;
      if (s < 0) {
        g_nSpyroMotionSpeed = 0;
      }
    } else {
      int a = 0x140;

      if (r > 0x200) {
        a = OpaqueInt(0);
      }
      AdvanceSpyroSpeedTowardTarget(a, 0xC0);
    }
    BuildSpyroVelocityFromBodyEuler();
    w = &SPY[SPY_WALL_SLIDE];
    OPAQUE(w);
    WALL_SLIDE(w, g_nSpyroMotionSpeed = VectorLength(w, 1));
    if (Opaque(&SPY[SPY_CLIFF])[0] != 0 || g_nSpyroAirborneFrames != 0) {
      g_nSpyroVelocityZ = g_anSpyroMotionVec[2] - 0xC0;
    } else {
      AddVector(g_anSpyroVelocity, g_anSpyroVelocity, D_80078B34);
    }
    break;
  }
  case 4: {
    int d;

    LOCKOUT_TICK(&SPY[SPY_LOCKOUT]);
    d = AbsAngleDelta12(g_nSpyroMoveTargetYaw, g_nSpyroBodyYaw);
    if (d < 0x80) {
      d >>= 3;
    } else {
      d = t;
      if (d > 0xB) {
        d = 0xB;
      }
      d = g_abSpyroEulerRateRampUp[d];
    }
    IntegrateSpyroBodyEuler(d);
    if (g_nSpyroCliffEdgeHint != 0) {
      g_nSpyroMotionSpeed = 0;
    } else {
      int s = g_nSpyroMotionSpeed - 0x100;

      g_nSpyroMotionSpeed = s;
      if (s < 0) {
        g_nSpyroMotionSpeed = 0;
      }
    }
    BuildSpyroVelocityFromBodyEuler();
    AddVector(g_anSpyroVelocity, g_anSpyroVelocity, D_80078B34);
    break;
  }
  case 3: {
    int r;
    int *w;

    LOCKOUT_TICK(&SPY[SPY_LOCKOUT]);
    if (g_nPadDirectionalIdleFlag != 0 && g_nSpyroStateFlags == 7) {
      g_nSpyroSpeedTarget = 0;
      if (g_pSpyroContactActor != 0) {
        int *a = g_pSpyroContactActor;

        g_nSpyroMoveTargetYaw =
            ArcTan2(a[3] - g_anSpyroWorldPos[0], a[4] - g_nSpyroWorldPosY, 1);
      }
    } else {
      ComputeSpyroMoveTargetFromPad(g_nSpyroMoveTargetMag);
    }
    if (SPY[SPY_STATE_FLAGS] != 7) {
      SPY[SPY_STATE_FLAGS] = 0;
    }
    if (g_nSpyroMotionSpeed < 0x400) {
      r = ApplyPadInputToSpyroBodyYaw();
    } else {
      int lean = 2;

      if (g_nSpyroMotionSpeed < 0xC80) {
        lean = 1;
      }
      r = TurnSpyroTowardMoveTargetWithLean(lean);
    }
    if (g_nSpyroCliffEdgeHint != 0) {
      g_nSpyroMotionSpeed = 0;
    } else if (g_nSpyroStateFlags != 0) {
      int s = g_nSpyroMotionSpeed - 0xC0;

      g_nSpyroMotionSpeed = s;
      if (s < 0) {
        g_nSpyroMotionSpeed = 0;
      }
    } else {
      int a = 0x140;

      if (r > 0x200) {
        a = OpaqueInt(0);
      }
      AdvanceSpyroSpeedTowardTarget(a, 0xC0);
    }
    BuildSpyroVelocityFromBodyEuler();
    w = &SPY[SPY_WALL_SLIDE];
    OPAQUE(w);
    WALL_SLIDE(w, g_nSpyroMotionSpeed = VectorLength(w, 1));
    if (SPY[SPY_AIRBORNE] != 0) {
      g_nSpyroVelocityZ = g_anSpyroMotionVec[2] - 0xC0;
    } else {
      AddVector(&SPY[SPY_VELOCITY], &SPY[SPY_VELOCITY], D_80078B34);
    }
    break;
  }
  case 5: {
    int *cd = &SPY[SPY_LOCKOUT];
    int *vel;
    int l;

    OPAQUE(cd);
    LOCKOUT_TICK(cd);
    ComputeSpyroMoveTargetFromPad(0xC80);
    TurnSpyroTowardMoveTargetWithLean(2);
    AdvanceSpyroSpeedTowardTarget(0x140, 0xC0);
    vel = cd + (SPY_VELOCITY - SPY_LOCKOUT);
    cd[SPY_CARRY - SPY_LOCKOUT] =
        (g_nSpyroMotionSpeed * LookupCosine(g_nSpyroMoveTargetYaw)) >> 12;
    g_nSpyroCarryMotionY =
        (g_nSpyroMotionSpeed * LookupSine(g_nSpyroMoveTargetYaw)) >> 12;
    SubtractVector(v10, cd + (SPY_CARRY - SPY_LOCKOUT), vel);
    v10[2] = 0;
    l = VectorLength(v10, 0);
    if (l > 0x280) {
      ScaleVector3ByRatio(v10, l, 0x280);
    }
    AddVector(vel, vel, v10);
    if (g_nSpyroWallSlideContributedFlag != 0) {
      int *nudge = cd + (SPY_NUDGE - SPY_LOCKOUT);
      int k;

      g_anSpyroWallSlideNudgeAccum[2] = 0;
      SetVector3Magnitude(nudge, 0x1000);
      k = (-cd[SPY_VELOCITY - SPY_LOCKOUT] * cd[SPY_NUDGE - SPY_LOCKOUT] -
           g_nSpyroVelocityY * g_anSpyroWallSlideNudgeAccum[1]) >>
          12;
      if (k > 0) {
        ScaleVector3ByRatio(nudge, 0x1000, k);
        AddVector(vel, vel, nudge);
      }
    }
    if (t < 0xD && g_nSpyroStateFlags == 0 &&
        ((PADW[1] & 0x40) || D_800756B4 != 0)) {
      int c = g_nSpyroCarryMotionZ + 0xD7 + g_nSpyroGravityStep;
      int v;

      g_nSpyroCarryMotionZ = c;
      v = ((g_nSpyroFloorReferenceZ - D_80078A60) << 6) -
          g_anSpyroVelocityFp6[2] + c;
      g_nSpyroVelocityZ = v;
      g_nSpyroFloorReferenceZ =
          ((D_80078A60 << 6) + v + g_anSpyroVelocityFp6[2]) >> 6;
    } else {
      SPY[SPY_CARRY + 2] += g_nSpyroGravityStep;
      g_nSpyroVelocityZ = SPY[SPY_CARRY + 2];
    }
    break;
  }
  case 6: {
    int *vel;
    int *vz;
    int l;

    LOCKOUT_TICK(&SPY[SPY_LOCKOUT]);
    if (g_nSpyroFallTrackingFlag != 0) {
      int d;

      ComputeSpyroMoveTargetFromPad(g_nSpyroMoveTargetMag);
      d = (g_nSpyroMoveTargetYaw - g_nSpyroBodyYaw) & 0xFFF;
      if (d > 0x800) {
        d -= 0x1000;
      }
      if (d > 0x20) {
        d = 0x20;
      }
      if (d < -0x20) {
        d = -0x20;
      }
      IntegrateSpyroBodyEuler(d);
    }
    if (SPY[SPY_FRAME_MOTION] < 0x80) {
      CopyVector(v20, &SPY[SPY_NUDGE]);
      RShiftVector3(v20, 3);
      AddVector(&SPY[SPY_VELOCITY], &SPY[SPY_VELOCITY], v20);
    }
    ZeroVector(v20);
    vel = &SPY[SPY_VELOCITY];
    SubtractVector(v20, v20, vel);
    v20[2] = 0;
    l = VectorLength(v20, 0);
    if (l > 0x40) {
      ScaleVector3ByRatio(v20, l, 0x40);
    }
    v20[2] = g_nSpyroGravityStep;
    AddVector(vel, vel, v20);
    if (g_nSpyroGroundProbeSuspendFlag == 0 && g_nSpyroGroundSlope < 0x20) {
      NudgeSpyroFromWallProbes();
    }
    vz = &SPY[SPY_VELOCITY + 2];
    OPAQUE(vz);
    if (vz[0] < -0x2300) {
      vz[0] = -0x2300;
    }
    if (g_nSpyroWallSlideContributedFlag != 0) {
      int *nudge = vz + (SPY_NUDGE - SPY_VELOCITY - 2);
      int k;

      g_anSpyroWallSlideNudgeAccum[2] = 0;
      SetVector3Magnitude(nudge, 0x1000);
      k = (-vz[-2] * vz[SPY_NUDGE - SPY_VELOCITY - 2] -
           g_nSpyroVelocityY * g_anSpyroWallSlideNudgeAccum[1]) >>
          12;
      if (k > 0) {
        vz -= 2;
        ScaleVector3ByRatio(nudge, 0x1000, k);
        AddVector(vz, vz, nudge);
      }
    }
    break;
  }
  case 9:
  case 10: {
    int *cd = &SPY[SPY_LOCKOUT];
    int *vel;

    OPAQUE(cd);
    LOCKOUT_TICK(cd);
    ComputeSpyroMoveTargetFromPad(0x1000);
    TurnSpyroTowardMoveTargetWithLean(3);
    g_nSpyroSpeedTarget = 0x1000;
    AdvanceSpyroSpeedTowardTarget(0x140, 0xC0);
    cd[SPY_VELOCITY - SPY_LOCKOUT] = 0;
    g_nSpyroVelocityZ = 0;
    g_nSpyroVelocityY = g_nSpyroMotionSpeed;
    vel = cd + (SPY_VELOCITY - SPY_LOCKOUT);
    if (g_nSpyroState == 10) {
      g_nSpyroVelocityY = -g_nSpyroMotionSpeed;
    }
    RotateVectorByMatrix(cd - (SPY_LOCKOUT - 0xD), vel, vel);
    cd[SPY_CARRY - SPY_LOCKOUT] -= cd[SPY_CARRY - SPY_LOCKOUT] >> 4;
    g_nSpyroCarryMotionY -= g_nSpyroCarryMotionY >> 4;
    g_nSpyroCarryMotionZ -= g_nSpyroCarryMotionZ >> 4;
    AddVector(vel, vel, cd + (SPY_CARRY - SPY_LOCKOUT));
    FINISH_VELOCITY();
    break;
  }
  case 11:
    LOCKOUT_TICK(&SPY[SPY_LOCKOUT]);
    if (g_nSpyroStateFlags & 1) {
      int x;
      int y;
      int a;
      int c;
      int d;
      int lo;
      int *ch;
      signed char *ramp;

      READ_STICK(x, y);
      a = (SPY[SPY_YAW] - g_anCameraEulerYawBlock[0]) & 0xFFF;
      c = LookupCosine(a);
      ramp = (int *)g_abSpyroEulerRateRampSigned;
      OPAQUE(ramp);
