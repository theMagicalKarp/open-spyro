              if (y > 0x1E) {
                y = 0x1E;
              }
            } else {
              g_nSpyroGlideBankingFlag = 0;
            }
          }
        }
        SPY[SPY_ROLL] = (SPY[SPY_ROLL] + y) & 0xFFF;
        g_abSpyroPersistentEuler[1] = SPY[SPY_ROLL] >> 4;
        if (SPY[SPY_ROLL] > 0x800) {
          SPY[SPY_ROLL] -= 0x1000;
