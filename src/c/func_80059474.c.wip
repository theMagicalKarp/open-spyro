#include "globals.h"

extern void CopyVector(int *dst, int *src);
extern void CopyWords(void *dst, void *src, int byte_count);

extern int g_anLevelSpawnYawBlock[]; /* +0 spawn yaw (see alias) */
extern int g_nLevelSpawnPosZ;        /* g_anLevelSpawnPos[2] (see alias) */
extern int D_8007788C;
extern int D_80077890;
extern int D_80077894;
extern int D_800778E8;
extern int D_800778EC;

/* 0x80059474 (0xF8) — latch `actor`'s position (+0xC) and facing as the
   level spawn anchor: store the wrapped yaw (<<4 & 0xFFF) and position, mark
   the anchor valid, bias spawn Z up 0x164, snapshot the level's rescued/gem
   tallies into the persistence block, merge the pending block into the
   committed one (copy 0x20 bytes then OR the 8 words), and carry the spawn
   flag word across. */
/* Body is decomp-permuter output from the 2026-07-25 sweep (reads worse than
   the hand-written form it replaced); original hand-written body:
   git show 46305b0:src/c/func_80059474.c.wip
   The anchor flag's `1` is carried by `t` (the snapshot temp) on purpose: as a
   bare literal its pseudo is single-set, so sched.c birthing_insn_p boosts the
   `li` to max_priority and it lands next to its store; sharing the already
   twice-set `t` makes it non-birthing and it drifts to the block front where
   the original has it (F14 carrier, 4 insns -> 2). */

void func_80059474(unsigned char *actor, int yaw) {
  int *new_var;
  int *dst;
  int *src;
  int i;
  int t;
  g_anLevelSpawnYawBlock[0] = (yaw << 4) & 0xFFF;
  CopyVector((int *)(&g_anLevelSpawnYawBlock[-3]), (int *)(actor + 0xC));
  t = 1;
  *((volatile int *)(&g_nSpawnAnchorValid)) = t;
  dst = &g_anLevelSpawnYawBlock[-19];
  src = &g_anLevelSpawnYawBlock[-11];
  *((volatile int *)(&g_nLevelSpawnPosZ)) += 0x164;
  new_var = &g_anLevelDragonsRescued[g_nLevelIntroIndex];
  {
    t = *new_var;
    *((volatile int *)(&D_8007788C)) = t;
    t = g_anLevelGemsCollected[g_nLevelIntroIndex];
    *(&D_80077894) = 0;
    *((volatile int *)(&D_80077890)) = t;
  }
  CopyWords(dst, src, 0x20);
  i = 0;
  do {
    int v = *src;
    *dst = (*dst) | v;
    src += 1;
    i += 1;
    dst += 1;
  } while (i < 8);
  D_800778EC = D_800778E8;
}

/* PARKED — 2/62 insns (96.8%, length-exact) as of 2026-08-06-1. The ONLY
 * residue left is an F2/B19 arg-copy tie: the original emits
 *   addiu s1,s0,-76 ; move a0,s1 ; addiu s0,s0,-44
 * and we emit the two addiu's first and the arg copy last. Position-invariant
 * — moving the `src` derivation to the call site and an embedded-assignment
 * arg (`CopyWords(dst = ..., src = ..., 0x20)`) both give byte-identical
 * output; both pointers are already multi-set (the loop increments them), so
 * the F14 set-count lever has nothing left to move. Permuter or a real basic
 * block boundary (B19).
 *
 * Earlier note (2026-07-10, ~63%; best form 67.7%) — logic, alias-held base
 * (g_anLevelSpawnYawBlock), CopyVector/CopyWords calls, OR-merge loop and
 * tail all correct; the -0x4C/-0x2C/-0xC derivations and the loop are
 * byte-identical. Residue is the straight-line snapshot run: our sched1
 * hoists the (non-volatile) dragons/gems array loads above the posZ RMW's
 * addiu/sw and sinks/hoists the anchor=1 and 894=0 stores; volatile stores
 * pin store order (67.7%) but loads still float (§K), full-volatile loads
 * overflow the slot by 8 bytes, and t-serial (row 19) fixes seriality but
 * regalloc picks a2 over v0. Scalar alias g_nLevelSpawnPosZ needed for the
 * per-access absolute RMW form (array form CSEs the address into a reg).
 * Permuter candidate.
 *
 * 2026-07-25-1 unattended permuter session (~15m, ~90000 iterations, timed out
 * at the 15m budget): best score 130 vs base score 1260 across 829 output dirs
 * — a large gain. No byte-perfect candidate found; still PARKED. Worth a longer
 * budget.
 */
