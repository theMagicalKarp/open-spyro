#include "globals.h"

extern void ResetPadStickCalibrationDefaults(unsigned char *cal);

/* 0x80053790, 432 bytes — validate and bake the pad-stick calibration block.
   Each of the four axes needs its recorded neutral (+0x20) at least 0x30 away
   from both reported extremes (+0x24 low / +0x28 high), otherwise the whole
   block falls back to the uncalibrated defaults and the function returns 0.
   Otherwise each axis gets its two breakpoints (+0x2c neutral+0x30 /
   +0x30 neutral-0x30) and the two fixed-point scale factors (+0x34 and +0x3c
   shorts), and the per-frame stick state is cleared: the snapshot head words,
   its four neutral 0x7f bytes, and the four 0x18-byte autorepeat records. */

/* PARKED 2026-08-12-2 at 22/108 differing insns, LENGTH- AND SHAPE-EXACT:
   every instruction is the right opcode with the right operands; the only
   residue is local-alloc register assignment, in three swapped PAIRS.
     (1) loop 2: ours q->a1, axis->a2; original axis->a1, q->a2.
     (2) phase 3: ours neutral->a1, j->a0; original neutral->a0, j->a1.
     (3) phase 4: ours k->a1, j2->v1; original k->v1, j2->a1.
   Measured with the -dg probe (D 2c): the pair-(1) allocnos are
   q = 9 refs/22 insns (prio floor_log2(9)*9/22 = 1.227) and
   axis = 9 refs/25 insns (1.08), i.e. ~13% apart, so the flip needs axis at
   L<=21 or q at R<=7. Tried without moving it: declaration reorder (ties only,
   these are not ties), `q = p + axis` instead of `cal + axis*2` (identical
   code), one shared vs two separate loop counters, literal vs local 0x7f.
   Everything else in this function was SOLVED this session -- see the A-series
   entries for the giv levers used here (mult-giv base + giv-test counter +
   increment-after-last-use). Do not re-derive the shape; only the allocation
   is left. Permuter candidate: three independent 2-way register swaps.

   (The 2026-07-25 permuter-spew body this replaced scored 14/108 differing but
   was machine-generated, wrote *(short*)(cal+0x34) for a q-relative store, and
   its two named residues -- "loop.c lifts the two sh givs onto an anchored biv"
   and "phase-3/4 fill loop rotation" -- are both retired: the giv anchor is
   fixed here, and the fill loops are byte-shape-exact.) */

int FinalizePadCalibration(unsigned char *cal) {
  unsigned char *p;
  unsigned char *q;
  unsigned char *fill;
  unsigned char *rec;
  unsigned char *fill2;
  int i;
  int axis;
  int ok;
  int j;
  int j2;
  int k;
  int mid;
  int hi;
  int num1;
  int num2;
  int neutral;
  int neutral2;

  ok = 1;
  for (i = 0; i < 4;) {
    p = cal + i;
    mid = p[0x20];
    if (mid + 0x30 >= p[0x28] || (i += 1, p[0x24] >= mid - 0x30)) {
      ResetPadStickCalibrationDefaults(cal);
      ok = 0;
      break;
    }
  }

  axis = 0;
  num1 = 0x4000;
  num2 = 0x3F80;
  do {
    p = cal + axis;
    q = cal + axis * 2;
    p[0x2C] = p[0x20] + 0x30;
    hi = p[0x28];
    hi = num1 / (hi - *(volatile unsigned char *)&p[0x2C]);
    p[0x30] = p[0x20] - 0x30;
    *(short *)(q + 0x34) = hi;
    *(short *)(q + 0x3C) = num2 / (*(volatile unsigned char *)&p[0x30] - p[0x24]);
    axis += 1;
  } while (axis < 4);

  neutral = 0x7F;
  j = 3;
  fill = cal + 3;
  *(int *)(cal + 0x00) = 0;
  *(int *)(cal + 0x04) = 0;
  *(int *)(cal + 0x08) = 0;
  *(int *)(cal + 0x18) = 1;
  *(int *)(cal + 0x1C) = 1;
  do {
    fill[0x14] = neutral;
    fill -= 1;
  } while (--j >= 0);

  neutral2 = 0x7F;
  k = 0;
  do {
    rec = cal + k * 0x18;
    j2 = 3;
    fill2 = rec + 3;
    *(int *)(rec + 0x4C) = 0;
    *(int *)(rec + 0x50) = 0;
    *(int *)(rec + 0x48) = 0;
    do {
      fill2[0x58] = neutral2;
      fill2 -= 1;
    } while (--j2 >= 0);
    k += 1;
  } while (k * 0x18 < 0x60);

  return ok;
}
