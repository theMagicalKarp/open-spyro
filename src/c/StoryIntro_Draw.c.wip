#include "globals.h"

extern void *BuildTextSprites(unsigned char *str, int *pos, int *size, int a,
                              int b);
extern void EnqueuePendingSpritePrims(void);
extern void FillWord(void *dst, unsigned int value, int byte_count);
extern void RasterizeSpritePrimQueue(void);
extern void RasterizePairedActor(void);
extern void DrawSync(int mode);
extern int VSync(int mode);
extern DISPENV *PutDispEnv(DISPENV *env);
extern void PutDrawEnv(void *env);
extern void *LinkOTPrimitives(int depth_max);
extern void DrawOTag(void *ot);

extern unsigned char D_80010CF0[];     /* "IN THE WORLD OF DRAGONS..." */
extern unsigned char D_80010D0C[];     /* "THE ADVENTURE CONTINUES..." */
extern unsigned char D_80010D28[];     /* "THE ADVENTURE BEGINS..." */
extern unsigned char D_80010D40[];     /* "ENTERING DEMO MODE..." */
extern unsigned short g_anCosineLut[];    /* g_anSineLut + 0x80 */
extern int g_anStoryIntroTimerBlock[];    /* held-base alias @ g_nStoryIntroTimer */

/* Draw gamestate 0xD's story-intro card (substate 2, after the g_nStoryIntroTimer
   warm-up): fades in one of the message variants selected by g_nStoryIntroMessage,
   with the per-glyph brightness wave (a linear ramp-in then g_anCosineLut ripple),
   then flushes the sprite queue and, in substate 2, splices the paired-actor OT
   before the frame submit (0x8001e6b8). */
void StoryIntro_Draw(void) {
  int *slot;
  void *binBase;
  int iVar3;
  int iVar2;
  int msgHold;
  int pos[3];
  int size[3];

  if (g_nStoryIntroSubstate == 2 && g_nStoryIntroTimer >= 0x8c) {
    pos[1] = 0x78;
    pos[2] = 0x1400;
    iVar3 = (int)g_pSpriteRecordWriteCursor;
    size[0] = 0xe;
    size[1] = 1;
    size[2] = 0x1600;
    if (g_nStoryIntroMessage == 0) {
      pos[0] = 0x5c;
      BuildTextSprites(D_80010CF0, pos, size, 0x10, 0xb);
      msgHold = 0xb8;
    } else if (g_nStoryIntroMessage == 1) {
      if (g_abLevelVisitedFlag[0] != 0) {
        pos[0] = 0x50;
        BuildTextSprites(D_80010D0C, pos, size, 0x10, 0xb);
        msgHold = 0xbc;
      } else {
        pos[0] = 0x64;
        BuildTextSprites(D_80010D28, pos, size, 0x10, 0xb);
        msgHold = 0xb6;
      }
    } else {
      pos[0] = 0x68;
      BuildTextSprites(D_80010D40, pos, size, 0x10, 0xb);
      msgHold = 0xb2;
    }
    if (g_anStoryIntroTimerBlock[0] < msgHold) {
      g_pSpriteRecordWriteCursor =
          (void *)((int)g_pSpriteRecordWriteCursor +
                   ((msgHold - g_anStoryIntroTimerBlock[0]) >> 1) * 0x58);
    }
    iVar2 = 0;
    iVar3 -= 0x58;
    if ((int)g_pSpriteRecordWriteCursor <= iVar3) {
      int phase = 0;
      char *p = (char *)(iVar3 + 0x46);
      do {
        int tv = g_anStoryIntroTimerBlock[0];
        int off = iVar2 + 0x8c;
        int t = tv - off;
        int c;
        if (t < 0x38) {
          c = t * 8 + 0x40;
        } else {
          c = g_anCosineLut[(tv * 4 + phase) & 0xff] >> 7;
        }
        *p = c;
        phase += 0xc;
        iVar2 += 1;
        p -= 0x58;
        iVar3 -= 0x58;
      } while ((int)g_pSpriteRecordWriteCursor <= iVar3);
    }
  }
  g_abFrameDrawEnv0.r0 = 0;
  g_abFrameDrawEnv0.g0 = 0;
  g_abFrameDrawEnv0.b0 = 0;
  g_abFrameDrawEnv1.r0 = 0;
  g_abFrameDrawEnv1.g0 = 0;
  g_abFrameDrawEnv1.b0 = 0;
  g_apSpritePrimQueue[0] = 0;
  EnqueuePendingSpritePrims();
  FillWord((char *)g_apSpritePrimQueue - 0x2400, 0, 0x900);
  RasterizeSpritePrimQueue();
  if (g_nStoryIntroSubstate == 2) {
    RasterizePairedActor();
    slot = g_pOtActiveDepthSlot;
    binBase = g_pOtDepthBinArrayBase;
    *(int *)((char *)binBase + 0x100) = slot[0];
    *(int *)((char *)binBase + 0x104) = slot[1];
    slot[0] = 0;
    g_pOtActiveDepthSlot[1] = 0;
  }
  DrawSync(0);
  VSync(0);
  PutDispEnv((DISPENV *)((char *)g_pActiveFrameDrawEnv + 0x5c));
  PutDrawEnv(g_pActiveFrameDrawEnv);
  DrawOTag(LinkOTPrimitives(0x800));
}

/* PARKED 94.4% (11/196), exact length, logic 100% correct. Everything byte-
   identical (substate guard, 4-arm message dispatch, fade-threshold cursor shift,
   glyph-wave loop with the g_anStoryIntroTimerBlock held-base timer read [§A row13/
   §G single-offset alias] + off-split load-delay fill [§P] + separate stepped store
   pointer, the substate-2 OT splice, and the simple frame-flush tail) EXCEPT one §H
   register-coalescing tie: the original materializes &g_nStoryIntroTimer in a1 at
   the fade threshold, copies it to t1 for the loop, then REUSES a1 for the glyph
   store pointer p; our gcc assigns the timer base its own t0 and gives p a1 (no
   coalesce), which also flips the loop-body store to emit AFTER the phase/counter
   addius instead of before. Source can't force the a1 reuse (alias-array, pointer
   local, decl-order all leave t0). Clean permuter candidate — 2 coupled register
   roles. Alias g_anStoryIntroTimerBlock @0x80078d80 committed. */
