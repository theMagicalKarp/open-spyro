#include "globals.h"

/* Align Spyro's body pitch/roll toward his velocity direction (0x8003de44,
   284 bytes). Computes the target pitch from ArcTan2(speed, vz) + 0x8E (roll
   target is 0), wraps each delta to a signed 12-bit angle, then advances the
   two spring velocities (D_80078CB0/CB4) toward the deltas and steps the body
   euler angles by spring/4. */
extern unsigned int VectorLength(int *vec, int include_z);
extern int ArcTan2(int y, int x, int high_precision);

extern int D_80078CB0;
extern int D_80078CB4;

/* NOTE: the function body below is decomp-permuter output from the
   2026-07-25 sweep, kept for its partial-byte credit. It is machine-
   generated and reads worse than the hand-written form it replaced;
   the analysis above and below still describes the residue accurately.
   Original hand-written body: git show
   HEAD:src/c/AlignSpyroBodyToVelocity.c.wip Best candidate:
   build/permuter/nonmatchings/AlignSpyroBodyToVelocity/output-215-1/source.c */

void AlignSpyroBodyToVelocity(void) {
  int d[3];
  int len;
  int roll;
  int pitch;
  int v;
  int step2;
  int u;
  int step;
  d[0] = 0;
  len = VectorLength(g_anSpyroVelocity, 0);
  d[2] = len;
  d[1] = ArcTan2(len, g_anSpyroVelocity[2], 1) + 0x8E;
  v = (d[0] - (pitch = g_nSpyroBodyPitch)) & 0xFFF;
  d[0] = v;
  if (v >= 0x800) {
    d[0] = v - 0x1000;
  }
  v = (d[1] - (roll = g_nSpyroBodyRoll)) & 0xFFF;
  d[1] = v;
  if (v >= 0x800) {
    d[1] = v - 0x1000;
  }
  step = D_80078CB0 + (((d[0] << 2) >> 4) - ((D_80078CB0 << 4) >> 6));
  u = (d[1] << 2) >> 4;
  D_80078CB0 = step;
  step2 = D_80078CB4 + (u - ((D_80078CB4 << 4) >> 6));
  step >>= 2;
  d[0] = step;
  g_nSpyroBodyPitch = pitch + step;
  D_80078CB4 = step2;
  step2 >>= 2;
  d[1] = step2;
  g_nSpyroBodyRoll = roll + step2;
}

/* PARKED 63.4% (session 2026-07-10-1): logic + length correct; pitch/roll a3/a2
   roles and chain-1 (incl. sw-before-sra via in-place `step >>= 2`) all match.
   Residue is one Sec-K independent-load scheduling decision: after chain 1's
   addu, the original hoists the d[1] stack reload (lw 20(sp)) up to the load
   batch head and loads D_80078CB4 late (defc); our sched1 always hoists the
   D_80078CB4 lui/lw pair instead and reloads d[1] late (df0c), renaming chain 2
   (v1<->a0) as a consequence. Tried: u-temp between chains (combine merges it
   back), volatile d[1] read (pins but cannot hoist), chain-2 operand-order
   flips. Permuter candidate. */

