#include "globals.h"

extern volatile unsigned int *D_800738BC; /* GPU_STAT-shadow reg ptr (interlace/field bit) */
extern volatile unsigned int *D_800738C0; /* TMR_HRETRACE_VAL reg ptr */
extern int WaitForFrameDeadline(int deadline, int mode);

/* libgpu VSync: mode<0 returns the free-running HRETRACE tick delta since the
   last call without waiting; mode==0/1 waits for the next vblank (or field,
   mode==1) via WaitForFrameDeadline, then for interlaced fields waits out
   the field-parity flip on the GPU status shadow register; mode>0 waits for
   the mode'th future vblank. Returns g_nRcntAuxState (the current vblank
   tick) on the waiting paths. (0x8005dbc4, 328 bytes.)

   PARKED at 316/328 bytes (12 bytes / 3 instr short). Structure, both dead
   priming reads (D_800738BC deref'd once unused at entry, matching
   InitDisplayEnv's HW bus-sync idiom), the do/while field-wait loop, and the
   two-arm target/wait computation (each mode>0/else arm independently
   reloads g_nVsyncPrevVblankCount rather than sharing one load - forced by
   writing it as if/else rather than default+override) are all
   byte-identical. Sole remaining residue: the second WaitForFrameDeadline's
   literal `1` arg is scheduled into the jalr delay slot by our build
   (`a0 += 1` computed early as a real insn instead); original does the
   mirror (literal materializes as its own early insn, `a0 += 1` deferred
   into the delay slot). A named `int one = 1;` local made no difference -
   pure §K independent-load/constant scheduling tie. Permuter candidate: 1
   instruction reorder. */
int VSync(int mode) {
  unsigned int delta;
  unsigned int stat;
  int target;
  int wait;

  stat = *D_800738BC;
  delta = (*D_800738C0 - g_nVsyncPrevHRetraceCount) & 0xFFFF;
  if (mode < 0) {
    return g_nRcntAuxState;
  }
  if (mode == 1) {
    return delta;
  }
  if (mode > 0) {
    target = g_nVsyncPrevVblankCount - 1 + mode;
  } else {
    target = g_nVsyncPrevVblankCount;
  }
  wait = 0;
  if (mode > 0) {
    wait = mode - 1;
  }
  WaitForFrameDeadline(target, wait);
  stat = *D_800738BC;
  {
    int one = 1;
    WaitForFrameDeadline(g_nRcntAuxState + 1, one);
  }
  if ((stat & 0x400000) != 0 && (int)(stat ^ *D_800738BC) >= 0) {
    do {
    } while (((stat ^ *D_800738BC) & 0x80000000) == 0);
  }
  g_nVsyncPrevVblankCount = g_nRcntAuxState;
  g_nVsyncPrevHRetraceCount = *D_800738C0;
  return delta;
}
