#include "globals.h"

extern void CopyVector(int *dst, int *src);
extern int PlaySoundEffect(unsigned int id, int owner, unsigned int flags,
                           unsigned char *pos);

extern int g_anGemPickupBlock[]; /* held-base alias @ g_nGemPickupSubstate */

/* Begins the dragon-rescue statue cutscene overlay (GS_GEM_PICKUP): seeds the
   cutscene substate/timer globals, bumps both dragon counters (per-level +
   world total, priming the HUD cache), blocks gameplay, flags the source
   actor's render record at +0x3c, anchors the aura star, and fires the rescue
   chime. Special-cases Artisans home (level 10 pickup 1->2) and Gnasty's Loot
   (level 0x3c key-locked treasure rewrite). (0x8002c924) */
void BeginGemPickupOverlay(unsigned int *param_1) {
  unsigned int *puVar1;
  int world;
  int *dragons;
  int prevDragons;
  int idx;
  int one; /* the shared `1`, re-used as the world-counter carrier: see the
            park note -- the second SET is what de-boosts it */
  puVar1 = (unsigned int *)(*param_1);
  if (((g_nActiveLevelId == 0xa) && (puVar1[6] == 1)) &&
      ((((g_abLevelGemPercent[1] != 0) || (g_abLevelGemPercent[2] != 0)) ||
        (g_abLevelGemPercent[3] != 0)) ||
       (g_abLevelGemPercent[5] != 0))) {
    puVar1[6] = 2;
  }
  if (g_nActiveLevelId == 0x3c) {
    if (g_abLevelGemPercent[0x21] != 0) {
      puVar1[6] = 1;
      puVar1[0xa] = 0x800;
      puVar1[0xb] = 0xcc8;
      puVar1[2] = 0x2561;
      puVar1[3] = 0xffc;
      puVar1[4] = 0x6a;
      puVar1[5] = 0xbb;
      puVar1[0xc] = 0x800;
      puVar1[0] = 0x134bf;
      puVar1[1] = 0x13ce9;
      puVar1[0xe] = 0x10;
    }
  }
  g_nGamestate = 8;
  world = g_nWorldDragonsRescued;
  g_nHudDragonCachedCount = world;
  dragons = &g_anLevelDragonsRescued[g_nLevelIntroIndex];
  prevDragons = *dragons;
  one = 1;
  g_nGameplayBlocked = one;
  g_nGamePaused = one;
  *dragons = prevDragons + 1;
  g_anGemPickupBlock[0] = 0;
  g_anGemPickupBlock[1] = 0;  /* g_nGemPickupStreamState */
  g_anGemPickupBlock[5] = 0;  /* g_nGemPickupTimer */
  g_anGemPickupBlock[10] = 0; /* g_nGemPickupSecondaryTimer */
  g_anGemPickupBlock[13] = 0; /* g_nGemPickupPadHoldTimer */
  g_anGemPickupBlock[12] = 0; /* g_nGemPickupAudioFiredFlag */
  g_anGemPickupBlock[0x1a] = (int)param_1;
  one = world + 1;
  g_nWorldDragonsRescued = one;
  g_anGemPickupBlock[-1] = puVar1[6]; /* g_nGemPickupTypeSnapshot */
  if (puVar1[8] != (-1)) {
    *((unsigned char *)((((char *)g_pActorListBase) + (puVar1[8] * 0x58)) +
                        0x3c)) = 1;
  }
  CopyVector(g_anGemPickupAuraStarAnchor, (int *)(param_1 + 3));
  g_anGemPickupAuraStarAnchor[2] += 0x40;
  PlaySoundEffect(
      *((unsigned char *)(((char *)g_pLevelSampleBankHeader) + 0x30)),
      (int)(&g_anGemPickupBlock[0x1a]), 0x10,
      (unsigned char *)(((char *)g_anGemPickupBlock[0x1a]) + 0x54));
}

/* PARKED 2026-08-31 at 95.2% (7/146), LENGTH-EXACT -- was 9/146 for three
   sessions.  The residue is now ONE register decision, not a chain rotation.

   WHAT MOVED IT (9 -> 7), and it is the reusable finding: the 2026-08-15 note
   below diagnosed the residue as "the shared literal 1 beats the `dragons`
   pointer in local-alloc's qty_compare, and the numerator cannot be bought
   without an insn".  The numerator is not the dial -- **F14's birthing boost
   is**.  The literal's pseudo is single-set, so sched1 places its `li` right
   next to its first use, which makes its live range 3 insns, which is what
   wins it $v1 over the `dragons` giv.  Give that pseudo a SECOND SET
   (A238 step 1) and the whole dragons chain comes back byte-exact:
   `lw g_nLevelIntroIndex` / `sll 2` / `addu` / `lw 0(v1)` / `sw 0(v1)` all
   land in $v1 as the original has them, closing 6 of the 9.
   The second set has to be a value that already needs a register in the SAME
   basic block; `one = world + 1;` (the g_nWorldDragonsRescued increment) is
   the cheapest one and is what is checked in.

   WHAT IS LEFT (7 insns, one decision): `one` and `world` are allocated the
   WRONG WAY ROUND -- ours puts `world` in $a0 and the constant in $a1, the
   original has `li a0,1` and `world` in $a1.  Six of the seven are that swap
   (`li`, the `lui/lw` pair, the HUD store, and the two flag stores); the
   seventh is `addiu a1,a0,1` where the original has `addiu a1,a1,1`, which is
   inherent to using the increment as the carrier (the original's increment
   writes into world's own register, so the carrier can never be the constant).
   **So this shape caps at 2 even with the swap fixed** -- a de-boost carrier
   that is NOT the world increment is needed for a real match, and $a0 is used
   by nothing else in that basic block, which is why every other carrier site
   couples a second register.
   MEASURED 2026-08-31, all length-exact unless noted (baseline 9):
     7   `one = world + 1` carrier (checked in).
     7   the same with `one` declared first / declared before `puVar1` /
         `one = 1` hoisted to the top of the block or below the HUD store /
         `one = world; one = one + 1;` -- statement and declaration order are
         INERT here, exactly as the 2026-08-15 note found.
     9   carriers whose second set is a COPY and is deleted before sched1
         (`one = (int)param_1;`), with or without `world = world + 1;`:
         reg_n_sets stays 1, the boost survives, nothing moves.  Same for a
         plain `world = world + 1;` with no carrier at all.
     13  `one = puVar1[6]` (snapshot) carrier: fixes the chain, but the
         snapshot store then schedules ABOVE the world store.  Also 13 for the
         actor-index carrier (`one = puVar1[8]`) at two positions, and for
         `one = 2; puVar1[6] = one;` in the first `if`.
     33  `one` shared with the actor `+0x3c` store: fixes the chain AND is one
         insn SHORT -- the original re-materialises `li v1,1` there, so the two
         are separate pseudos in the original.
     38  `one = 1` shared with `puVar1[6] = 1` in the 0x3c block.
     19-38 every `do { } while (0)` ref dial (A238), at depth 1 and 2, on the
         `dragons` def / the load / the store / the carrier's first or second
         set.  This is straight-line code, so the dummy loop's NOTEs only split
         the basic block and wreck sched1 -- confirmed again, and the two
         depth-1/depth-2 pairs that do link change nothing between them.
     34  both flag stores through `*(volatile int *)`.
     LENGTH-DIFF: a nest around `one = world + 1;` at either depth.
   The next idea has to be a way to give the constant's pseudo a second set
   whose value is DEAD or already lives in $a0 -- neither exists in this block.

   ---- the 2026-08-15 note, whose closing residue list is superseded ----
   PARKED 2026-08-15 at 93.8% (9/146), LENGTH-EXACT — was 24/146 at the start of
   the session (and 45/146 when the 2026-07-19 note below was written; that
   note's residue list is superseded). The permuter body is gone. Closed here:
     - the tail zero-store run scheduled AFTER the source-actor store (the
       2026-07-19 note's residue 3): write the five cutscene-state zeroes
       THROUGH THE SAME ALIAS as the +0/+0x68 stores (g_anGemPickupBlock[1]/[5]/
       [10]/[13]/[12]) instead of as their own extern scalars. Different base
       SYMBOLS let 2.7.2 alias analysis reorder the group; one symbol pins it.
       The emitted addressing is unchanged (nonzero offsets still fold to
       `lui at; sw %lo(sym+K)(at)` — B-i rule 1). 24 -> 15 diffs.
     - `lw v1,0x20(a2)` (the actor-index load) hoisting above the two scalar
       global stores that precede it: A134/A153 — a store to a plain extern
       scalar does not block a pointer load, an ARRAY store does. Writing
       g_nGemPickupTypeSnapshot as `g_anGemPickupBlock[-1]` (it sits 4 bytes
       below the alias base) sets MEM_IN_STRUCT_P and the load stays put.
       15 -> 9 diffs.

   (2026-08-15) REMAINING (9 insns, one class): in the dragon-rescue block the original puts
   the shared literal `1` in a0 and the `dragons` pointer in v1; ours has them
   swapped. §D 2c probe: reg 116 (the constant, 3 refs / 6 insns, priority
   floor_log2(3)*3/6 = 0.50) beats reg 75 (`dragons`, 3 refs / 7 insns, 0.43),
   so it is allocated first and takes v1 (v1 precedes a0 in reg_alloc_order).
   Flipping it needs `dragons` at 4 refs, or its live range at <=6 (a tie then
   goes to the earlier birth, which is `dragons`). Everything tried either does
   not move the counts or costs an insn: A181's second set (`dragons =
   g_anLevelDragonsRescued; dragons += g_nLevelIntroIndex;` — flips the index
   to v1 but ties `dragons` to the BASE's register and hoists the `la` two
   slots, 22/146), a `dst = dragons;` copy before the store (cse deletes it),
   A179's index form (16/146 — the HudDragonCachedCount store sinks below the
   two flag stores), moving the increment or one flag store between the pair
   (sched1 puts them back, 9/146 unchanged), `*dragons = prevDragons + 1` before
   the flag stores (+1 insn, the load-delay nop the 2026-07-19 note describes),
   a long-lived `one = 1` local (cse re-materializes it, 9/146), and A176/A195's
   do/while(0) ref dial in every placement (31-38/146 — this is straight-line
   code, so the wrapper only splits the basic block and wrecks sched1, exactly
   A195's documented caveat). Not a permuter target: it is one local-alloc
   priority comparison, and the numerator cannot be bought without an insn. */
