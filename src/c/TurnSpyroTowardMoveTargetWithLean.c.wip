#include "globals.h"

/* Per-speed-bucket turn-rate table at 0x8006c5f0; row stride 0x1a bytes, the
   lean-indexed rate short sits at +0xc (short[6]). */
extern short D_8006C5F0[];

extern void IntegrateSpyroBodyEuler(int delta);

/* 0x8003d6d0: Steers Spyro's body yaw toward the move-target yaw using a lean
   accumulator g_nSpyroBodyYawStep (clamped -6..+6). Picks the turn rate from
   the 2D table (speed bucket param_1 selects the row, lean the column). Resets
   the lean when the target is overshot or the desired delta falls inside the
   table-indexed band, then integrates the chosen angular delta and reports the
   remaining |delta| via AbsAngleDelta12. */
void TurnSpyroTowardMoveTargetWithLean(int param_1) {
  int iVar1;
  unsigned int uVar2;
  int uVar3;
  short *row;

  uVar3 = g_nSpyroMoveTargetYaw - g_nSpyroBodyYaw & 0xfff;
  if (uVar3 < 0x800) {
    g_nSpyroBodyYawStep = g_nSpyroBodyYawStep + 1;
    if (g_nSpyroBodyYawStep < 1) {
      g_nSpyroBodyYawStep = 1;
    }
    iVar1 = 6;
    if (g_nSpyroBodyYawStep < 7) {
      goto found;
    }
  } else {
    g_nSpyroBodyYawStep = g_nSpyroBodyYawStep + -1;
    if (g_nSpyroBodyYawStep < -6) {
      g_nSpyroBodyYawStep = -6;
    }
    iVar1 = -1;
    if (g_nSpyroBodyYawStep < 0) {
      goto found;
    }
  }
  g_nSpyroBodyYawStep = iVar1;
found:
  row = (short *)((char *)D_8006C5F0 + param_1 * 0x1a);
  uVar2 = (unsigned int)row[g_nSpyroBodyYawStep + 6];
  if (((int)uVar3 <= (int)uVar2) || ((int)(uVar2 + 0x1000) <= (int)uVar3)) {
    uVar2 = g_nSpyroMoveTargetYaw - g_nSpyroBodyYaw & 0xfff;
    if (0x800 < uVar2) {
      uVar2 = uVar2 - 0x1000;
    }
    g_nSpyroBodyYawStep = 0;
  }
  IntegrateSpyroBodyEuler(uVar2);
  AbsAngleDelta12(g_nSpyroMoveTargetYaw, g_nSpyroBodyYaw);
}

