#include "globals.h"

extern unsigned int VectorLength(int *vec, int include_z);

/* 0x8003891c (0x124) — ballistic aim helper: time-of-flight from `pos` to
   `target` at horizontal `speed` (2D distance / speed), optionally written to
   *pOutTime; returns the initial vertical velocity that lands the arc on the
   target under `gravity` (0 when the target is already in reach). */
int func_8003891C(int *pos, int *target, int speed, int gravity,
                  int *pOutTime) {
  int v[2];
  int t;
  int r;

  v[0] = pos[0] - target[0];
  v[1] = pos[1] - target[1];
  t = (int)VectorLength(v, 0) / speed;
  if (pOutTime != 0) {
    *pOutTime = t;
  }
  if (t == 0) {
    return 0;
  } else {
    return -((pos[2] - target[2]) + ((gravity * (t * t)) >> 1)) / t;
  }
}

/* PARKED 2026-07-09, +4 bytes (last iteration; logic fully correct).
   Ballistic-aim leaf. Residue: the zero-return arm. Original: bnez t -> work,
   inline "j epilogue; delay v0=0", mflo v0 falls into epilogue (early-return
   codegen WITHOUT block relocation). Ours: every early-return form (plain,
   goto-guard, if/else-both-return, ternary) relocates ret0 to the end
   (beqz -> end-block, +j/+nop); the result-variable form keeps the arm inline
   but allocates r to v1 (+move v0,v1, +8). Need ret0 inline AND result in v0
   simultaneously — jump-opt block-order tie; permuter candidate. */
