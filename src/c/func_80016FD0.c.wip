#include "globals.h"

/* WALL 2026-08-12 (§B6 hand-written asm) — do NOT attempt again.
 * The original uses $at as a general-purpose TEMPORARY: `and $at,$a2,$v1`,
 * `andi $at,$a3,0xffff`, `and $at,$t0,$v1` are three-operand logical ops whose
 * DESTINATION is $at. gcc never allocates $at (it is in FIXED_REGISTERS) and
 * gas only writes $at while expanding a macro with an immediate/address — none
 * of these have one. So this function was not built by our toolchain.
 * `progress.py`'s at_is_data() misses it: that detector only accepts $at as the
 * destination of add/addi/sub/neg or of a non-%hi/%lo load/store, so logical
 * ops writing $at slip through and the function is still in the denominator.
 *
 * The body below is a from-scratch re-derivation (2026-08-12) that replaces the
 * 2026-07-25 permuter spew. It is INSTRUCTION-FOR-INSTRUCTION identical to the
 * original in opcode and order (30/30) — the three swap stanzas come out
 * and/and/xor/xor/or/or exactly when each field swap is written as SIX separate
 * statements with in-place compound assignment (`w0 ^= a; w1 ^= b; w0 |= b;
 * w1 |= a;`); the single-expression form `w0 = (w0 ^ a) | b;` instead emits
 * and/and/xor/or/xor/or with a fresh temp per pair. What cannot be reached is
 * the register assignment: the original's temps are $at/$v0, ours are two
 * ordinary pseudos, and the 0xFFFF0000 `lui` lands before the five loads
 * instead of after them (it is a priority-1 straggler whose RTL insn precedes
 * them; A164 group permutation does not move it — a named mask local, before
 * or after the loads, is far worse). Still 6.7% linked, same as the spew.
 *
 * 0x80016fd0, 120 bytes — transpose the packed 3x3 short matrix at src into
   dst: three halfword-field swaps (word0<->word1 high halves, word1<->word3
   low halves, word2<->word3 high halves); the 5th word passes through. */

void func_80016FD0(unsigned int *dst, unsigned int *src) {
  unsigned int w0;
  unsigned int w1;
  unsigned int w2;
  unsigned int w3;
  unsigned int w4;
  unsigned int a;
  unsigned int b;

  w0 = src[0];
  w1 = src[1];
  w2 = src[2];
  w3 = src[3];
  w4 = src[4];

  a = w0 & 0xFFFF0000;
  b = w1 & 0xFFFF0000;
  w0 ^= a;
  w1 ^= b;
  w0 |= b;
  w1 |= a;

  a = w1 & 0xFFFF;
  b = w3 & 0xFFFF;
  w1 ^= a;
  w3 ^= b;
  w1 |= b;
  w3 |= a;

  a = w2 & 0xFFFF0000;
  b = w3 & 0xFFFF0000;
  w2 ^= a;
  w3 ^= b;
  w2 |= b;
  w3 |= a;

  dst[0] = w0;
  dst[1] = w1;
  dst[2] = w2;
  dst[3] = w3;
  dst[4] = w4;
}
