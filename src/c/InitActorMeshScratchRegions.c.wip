#include "globals.h"

/* PARKED 2026-10-04-2 -- fresh decode, 56/56, 20 linked / 14 masked (was
   the 2026-07-25 permuter body, "B18 constant-hoist layout tie").
   B18 is SOLVED: with `top += size` written inside each arm of the size
   select, jump.c leaves the if/else alone and reorg merges both arms' `lui
   0xfffe` into the beqz delay slot (`j; ori 0xd000` / `ori 0x4000`), exactly
   the original. (A single join-block add lets jump.c rewrite the select as
   "default, then conditional override".) SetupFrameOT matched on the same
   lever.
   LEFT: allocation. The original computes the emit-list temp and stores it
   before the OT/prim-top temps, so both temps share v1 and the work-area top
   stays in v0 across the branch (in place, `top -= 0x6008`); ours schedules
   the three address temps together, local-alloc hands them v0/v1 first and
   the post-branch pointer lands in a3. Store-order permutations (6),
   in-place vs separate `p`, and copy-preference spellings measured 14-18. */

extern void FillWord(void *dst, unsigned int value, int byte_count);

#define VREAD(sym) (*(void *volatile *)&(sym))

/* 0x8005b6f8 (0xe0) — carve the render scratch regions down from
   g_pWorkAreaTop (emit list, OT, primitive top, two primitive buffers of
   0x13000 or 0x1c000 bytes depending on `split`), publish them to both
   frame slots and clear the merged-chain head and the OT. */
void InitActorMeshScratchRegions(int split) {
  char *top;
  int size;
  char *p;

  top = g_pWorkAreaTop;
  g_pEmitListBuffer = top - 0x2000;
  g_pRenderScratchOtBase = top - 0x6000;
  p = top - 0x6008;
  g_pRenderScratchPrimTop = p;
  if (split) {
    size = -0x13000;
    p += size;
  } else {
    size = -0x1c000;
    p += size;
  }
  g_pRenderScratchPrimBase1 = p;
  p += size;
  g_pRenderScratchRegionBase = p;
  g_pFramePrimBufferBase0 = VREAD(g_pRenderScratchRegionBase);
  g_pFramePrimBufferBase1 = VREAD(g_pRenderScratchPrimBase1);
  g_pFrameOtMergedChainSlot0 = g_pFrameOtMergedChainSlot1 =
      VREAD(g_pRenderScratchPrimTop);
  g_pFrameOtDepthBinBase0 = g_pFrameOtDepthBinBase1 =
      VREAD(g_pRenderScratchOtBase);
  FillWord(g_pFrameOtMergedChainSlot0, 0, 8);
  FillWord(g_pRenderScratchOtBase, 0, 0x4000);
}
