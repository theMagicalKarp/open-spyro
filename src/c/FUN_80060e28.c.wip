#include "globals.h"

/* PARKED 2026-08-10-3 — 43/44 insns (one short); block layout is EXACT.
 *
 * Decoded: map a display RECT's left edge into the debug-overlay coordinate
 * space. Debug type 1 mirrors about 0x400 when the GPU reverse flag is set,
 * type 2 does the same at half scale; everything else returns r->x.
 *
 * Solved this session (all confirmed against the shape diff):
 *   - two-case `switch` (A145: 2 nodes stay a chain -> bare beq/beq + j default)
 *   - case-1 flag-clear arm is `break` falling to the single tail `return r->x`
 *   - case-2 arm must be written `if (rev != 0) {...} else return r->x / 2;`
 *     so the mirror path is the inline/fallthrough block (A64)
 *   - the shared `subu; j; subu` tail lives in CASE 1 and case 2 jumps BACKWARD
 *     into it. jump.c cross-jumping cannot produce that: its forward walk hits
 *     case 1's `j end` first and `do_cross_jump` always deletes the insns
 *     before the jump it is looking at, so the LATER copy survives (+1 insn:
 *     case 1 gets a `j` whose delay slot re-duplicates `subu v0,v0,v1`).
 *     An explicit label in case 1 + `goto` from case 2 reproduces the layout.
 *   - with locals (not global loads) `a - b - c` does NOT reassociate, so the
 *     accumulator order is written literally: `mirrored - span - left`.
 *
 * RESIDUE (F1 register tie, 3 insns + 1 length): the carried accumulator lands
 * in a1, the original has it in v0 (`li v0,0x400` / `subu v0,v0,v1` /
 * `subu v0,v0,a0`). Root cause is the goto: `mirrored` becomes a GLOBAL allocno,
 * and global.c's find_reg prefers the hard reg with the lowest local-allocno
 * density -- v0/v1 are saturated by the two flag loads, the /2 chain and the
 * default `lh`, so an untouched a1 always wins. The `move v0,mirrored` copy that
 * would register a v0 preference is coalesced into the final subu before global
 * alloc runs, so the preference never exists. Tried and rejected: accumulate-in-
 * place vs. one expression, all three declaration orders, carrying the partial
 * sum instead of the constant. Length follows from the same cause: with the
 * accumulator in a1 the `li a1,0x400` is eligible for case 2's `beqz v0` delay
 * slot, where the original (li into v0, the branch's own operand) must nop.
 * Needs either a way to keep the value local across the join, or the real
 * jump.c lever that flips cross-jump direction without a goto.
 */
int FUN_80060e28(RECT *r) {
  int span;
  int left;
  int mirrored;

  switch (g_bGpuDebugType) {
  case 1:
    if (g_bGpuReverseFlag == 0) {
      break;
    }
    span = r->w;
    left = r->x;
    mirrored = 0x400;
  mirror:
    mirrored -= span;
    mirrored -= left;
    return mirrored;
  case 2:
    if (g_bGpuReverseFlag != 0) {
      span = r->w / 2;
      left = r->x;
      mirrored = 0x400;
      goto mirror;
    }
    return r->x / 2;
  }
  return r->x;
}
