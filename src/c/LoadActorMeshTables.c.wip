#include "globals.h"

/* 0x8005b7d8, 264 bytes — load the actor-mesh directory from CD into the top of
   the boot-load region. CdReadSyncSectors pulls D_8007A714 bytes from sector
   D_8007A710 into a buffer just under 0x80200000 - g_nCrt0StackSize; the first
   word gives the payload size, which is copied down to a fresh g_pWorkAreaTop.
   Up to 64 directory entries are then walked: each non-empty entry relocates a
   mesh header and stores the resolved pointer at g_apActorMeshTable[slot]. */

extern int D_8007A710;
extern int D_8007A714[4]; /* sized alias (A22): keeps the address in a reg */

extern void *g_apActorMeshTableBlock[]; /* incomplete-array view of
                                           g_apActorMeshTable */

extern void CdReadSyncSectors(int lba, void *buf, int size, int sector,
                              int marker);
extern void CopyWords(void *dst, void *src, int byte_count);
extern int *RelocateActorMeshHeader(int *header);
extern void InitActorMeshScratchRegions(int arg);

void LoadActorMeshTables(void) {
  int *dir;
  int top;
  int nbytes;
  int size;
  int i;
  void **table;

  i = 0;
  table = g_apActorMeshTableBlock;
  top = 0x80200000;
  size = (int)D_8007A714;
  nbytes = *(volatile int *)size;
  size = *(volatile int *)size;
  dir = (int *)(top - size - size - g_nCrt0StackSize);
  CdReadSyncSectors(g_nCdBaseLba, dir, nbytes, D_8007A710, 0x258);

  g_pWorkAreaTop = (void *)(top - g_nCrt0StackSize - dir[0]);
  CopyWords(g_pWorkAreaTop, dir + 0x200, dir[0]);

  for (; i < 0x40; i++) {
    if (dir[i * 2 + 1] == 0) {
      break;
    }
    table[dir[i * 2 + 2]] = RelocateActorMeshHeader(
        (int *)((char *)g_pWorkAreaTop + dir[i * 2 + 1] - 0x800));
  }

  InitActorMeshScratchRegions(0);
}

/* PARKED 2026-08-16 — LENGTH-EXACT, 56/66 instructions byte-identical (10/66
 * differ, 84.8%). Was 11/66 with a wrong-register, wrong-position `la`; the
 * whole prologue through `addiu v1,v1,-22764` is now byte-identical and the
 * residue is a smaller two-block ordering question. The 2026-08-12 note's
 * decode findings still hold and are kept below.
 *
 * WHAT CHANGED (and why the old note's "A164 straggler order, unreachable"
 * verdict was wrong): the `la` of D_8007A714 was not a straggler tie at all. It
 * was sched.c's `adjust_priority` LAUNCH boost — a single-set producer whose
 * dest is live is dragged to sit IMMEDIATELY BEFORE its consumer, which is why
 * a `volatile int *pdirbytes = D_8007A714;` local (one set) always emitted its
 * `lui/addiu` glued to the two loads, nine slots late. Giving the address
 * carrier a SECOND set kills the boost, and the second set is free here: read
 * both words through the `size` variable itself, so the second load overwrites
 * the base it reads (`size = *(volatile int *)size;`). That also reproduces the
 * original's `lw v1,0(v1)`. Position is then LUID order, and A93's corollary
 * supplies the two insns the original emits BEFORE the la: an explicit `i = 0;`
 * and an explicit pre-loop `table = g_apActorMeshTableBlock;` local (loop.c's
 * own hoists always land after every pre-loop statement, so the table base has
 * to be named to precede the la).
 *
 * RESIDUE (10 insns, two ordering questions, no length change):
 *   (a) the `lw a0,%lo(g_nCdBaseLba)` arg-1 load: original emits it directly
 *       after the la, ours after both dirbytes loads. Naming it as an early
 *       local (`lba = g_nCdBaseLba;`) is propagated away and changes nothing.
 *   (b) our two dirbytes loads are ADJACENT; the original separates them with
 *       `lui s1,0x8020` (top) and the arg-5 stack store. The `lw a2` (nbytes)
 *       load is anti-dependent on the `lw v1` (size) load — it reads the
 *       register that load overwrites — so when the size load is scheduled the
 *       nbytes load becomes ready at cost 0 and, being single-set and birthing,
 *       inherits LAUNCH_PRIORITY and is glued in front of it. Giving `nbytes` a
 *       second set does NOT unstick it: measured with the second set as the
 *       CopyWords count arg (10/66, unchanged) and as the g_pWorkAreaTop term
 *       (12/66, worse), and with `top = 0x80200000;` moved between the two
 *       loads (10/66, unchanged).
 * Next lever: something that separates the two loads without an anti-dependence
 * — i.e. a base carrier with two sets that is NOT one of the loaded values.
 */

/* 2026-08-12 decode notes (still valid):
 *   - The loop is SOLVED and byte-exact, including the held s3 table base, the
 *     no-peel entry test and the `4(s0)/8(s0)` offsets. The recipe is A179:
 *     write the entry fields as an INDEX off a fixed base (`dir[i*2+1]`,
 *     `dir[i*2+2]`) with the `== 0` test as a `break` at the top. loop.c then
 *     reduces `dir + i*8` to the giv, SPLITS the constant terms off into the
 *     addressing mode, and keeps `i` as the biv for the count test. A pointer
 *     WALKER (`dir += 2`) is what caused the peel and the dir+4 giv.
 *   - The two loads of D_8007A714 need A22 (declare the symbol as a >8-byte
 *     array) so the offset-0 base does not lose the sdata cost tie and fold
 *     back to `lui/lw %lo` per use.
 *   - MEASURED 2026-08-12: all 24 permutations of the four straggler-producing
 *     statements give the identical diff; declaration order of every local,
 *     `top` assigned before/after the reads and the `top - stack - size - size`
 *     reassociation are all no-ops. The load ORDER is load-bearing: `nbytes`
 *     must be read before `size`.
 */
