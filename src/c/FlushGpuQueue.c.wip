#include "globals.h"

extern int SetInterruptMask(int mask);
extern void DmaCallback();

/* libgpu DMA-queue drain (0x80061b00, 748 bytes). Called whenever the GPU may
   have completed an op. While DMA channel 2 (GPU CHCR bit 0x1000000) is idle
   and slots are queued, spins on the GP1 ready bit (0x4000000) and invokes each
   pending slot's func(args, arg4) in FIFO order until the ring drains or the
   GPU goes busy again; then, if the ring is empty and a one-shot completion
   callback is armed, fires it once. Returns the remaining ring depth. The ring
   head/tail indices are shared with the DMA-completion IRQ handler, hence
   volatile. */

extern unsigned int g_adwLastGpuOp[]; /* alias @ g_dwLastGpuOpFunc — held base
                                         for the Func store */

/* Distinct word[] views of the three used ring-slot fields (ring+0/+4/+8).
   Referencing them by distinct symbols keeps cse from hoisting one shared &ring
   base into a register: each access re-materializes %hi(ring+off) fresh,
   matching the original. */
extern unsigned int g_adwGpuRingFunc[]; /* ring + 0x0 */
extern unsigned int g_adwGpuRingArgs[]; /* ring + 0x4 */
extern unsigned int g_adwGpuRingArg4[]; /* ring + 0x8 */

/* Incomplete-array view of the pending flag: the read and the clear share one
   materialized base in the original (addiu v1,%lo(); lw 0(v1) … sw zero,0(v1)),
   which a plain 4-byte extern loses to the sdata cost tie. */
extern int g_anGpuQueueCompletionPending[];

#define WIDX (*(volatile int *)&g_nGpuQueueWriteIndex)
#define RIDX (*(volatile int *)&g_nGpuQueueReadIndex)
#define CHCR (*(volatile unsigned int *)g_pDmaGpuChcrReg)

unsigned int FlushGpuQueue(void) {
  volatile unsigned int *last;

  if ((CHCR & 0x1000000) != 0) {
    return 1;
  }
  g_nFlushGpuSavedIMask = SetInterruptMask(0);
  if (WIDX != RIDX && (CHCR & 0x1000000) == 0) {
    last = (volatile unsigned int *)g_adwLastGpuOp;
  drain:
    if (((RIDX + 1) & 0x3F) == WIDX && g_pfnGpuQueueCompletionCallback == 0) {
      DmaCallback(2, 0);
    }
    while ((*(volatile unsigned int *)g_pGpuStatReg & 0x4000000) == 0) {
      ;
    }
    (*(void (**)(unsigned int, unsigned int))&g_abGpuOpQueueRing[RIDX * 0x60])(
        g_adwGpuRingArgs[RIDX * 0x18], g_adwGpuRingArg4[RIDX * 0x18]);
    last[0] = g_adwGpuRingFunc[RIDX * 0x18];
    *(volatile unsigned int *)&g_dwLastGpuOpArg1 =
        g_adwGpuRingArgs[RIDX * 0x18];
    *(volatile unsigned int *)&g_dwLastGpuOpArg2 =
        g_adwGpuRingArg4[RIDX * 0x18];
    RIDX = (RIDX + 1) & 0x3F;
    if (WIDX != RIDX && (CHCR & 0x1000000) == 0) {
      goto drain;
    }
  }
  SetInterruptMask(g_nFlushGpuSavedIMask);
  if (WIDX == RIDX && (CHCR & 0x1000000) == 0 &&
      g_anGpuQueueCompletionPending[0] != 0 &&
      g_pfnGpuQueueCompletionCallback != 0) {
    *(volatile int *)g_anGpuQueueCompletionPending = 0;
    (*(void (*)(void))g_pfnGpuQueueCompletionCallback)();
  }
  return (WIDX - RIDX) & 0x3F;
}

/*
 * PARKED 2026-08-13 — LENGTH-EXACT (187/187), 20/187 words differ (89.3%),
 * re-derived from scratch (the 2026-07-25 permuter spew that used to live here
 * was 182 insns / 59 shape-differing; this body is hand-written and readable).
 * FOUR residues from the old note are RETIRED, all by ordinary idioms:
 *   - Ring bases hoisted into s1/s2/s3: the drain loop must be an A86
 * GOTO-loop. As a real do/while it is a loop.c loop, and loop.c hoists
 * %hi(ring+off) into callee-saved regs no matter how many distinct alias
 * symbols you give the fields. The three g_adwGpuRing* aliases are still needed
 * on top.
 *   - `depth` in v1 + a trailing `move v0,v1`: write the entry test as an EARLY
 *     `return 1;` and the tail as a direct `return (WIDX - RIDX) & 0x3F;`. A
 *     `depth` local initialised before the `if` costs 3 insns; the two-return
 *     form also lands the g_pDmaGpuChcrReg load ahead of the `addiu sp` (the
 *     old note's separate "prologue" residue - it was the same cause).
 *   - `sw zero,0(v1)` for the pending clear needs BOTH the incomplete-array
 *     alias g_anGpuQueueCompletionPending (held base, A22 / B-i rule 2) and a
 *     volatile cast on the store (else reorg eats it for the jalr delay slot).
 *   - The chcr-mask `lui v1,0x100` landing in a branch delay slot (§F8, this
 *     function is the named member) is fixed by making the CHCR read VOLATILE:
 *     reorg will not speculate past a volatile MEM into the fall-through, so
 *     the slot stays a nop and the lui falls into the load shadow, as in the
 *     original. Both sites, 4 insns.
 *
 * SOLE REMAINING RESIDUE (13 insns, one sched1 decision, + the frame it costs):
 *   In the dispatch block the original's memory-op order is
 *       RIDX(L1), RIDX(L2), lw args, RIDX(L3), lw arg4, lw func
 *   and ours is
 *       RIDX(L1), RIDX(L2), RIDX(L3), lw args, lw arg4, lw func
 *   i.e. sched1 hoists the THIRD volatile RIDX read above the (non-volatile)
 *   ring `args` read — gcc 2.7.2 orders volatile MEMs only against each other,
 *   not against plain ones. Consequences, all downstream of that one move:
 *   the original interleaves L1's `sll;addu` before the args load and finishes
 *   it with `sll ..,5` after (keeping 3*L1 live in v1), while ours defers L1's
 *   whole chain to the end and keeps L1 raw alive in a2 (hence a2-vs-a1), and
 *   the extra pressure reserves stack vars (0x28 frame vs 0x18; nothing is
 *   ever stored there).
 *   NOT source-steerable — measured 2026-08-13, all byte-identical output:
 *   func-pointer hoisted to a local; all three slot reads split into separate
 *   statements; an index temp for the func slot; `slot = RIDX * 3` + `slot * 8`
 *   (combine re-fuses it); byte-scaled `&ring[RIDX*0x60]` vs word-scaled
 *   `ring[RIDX*0x18]` (identical schedule, but it IS worth keeping: it drops
 *   the frame from 0x30 to 0x28).
 *   Levers that pin the order but cost more than they buy: volatile on the
 *   `args` ring read alone pins L3 below it but adds +1 insn and forces a held
 *   base (26 differing); volatile on all three ring reads costs +4 insns
 *   (191/187, 56 differing).
 *   CLASS: §F8-adjacent sched1 tie (volatile-vs-plain MEM ordering in a
 * call-arg block). Clean permuter target — the logic, the CFG, the length and
 * every other block are exact; only this one block's insn order is in play.
 */
