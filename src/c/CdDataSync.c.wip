#include "globals.h"

extern int VSync(int mode);
extern void WriteString(char *s);
extern int WritePrintf();
extern void CdResetController(void);

extern char D_80011DFC[]; /* "CD timeout: " */
extern char D_80011E0C[]; /* "%s:(%s) Sync=%s, Ready=%s\n" */
extern char D_80011F04[]; /* "CD_datasync" */

extern int D_80075AE8;           /* VSync deadline stamp */
extern int D_80075AEC;           /* spin counter */
extern char *D_80075AF0;         /* op-name string for the timeout message */
extern int *D_80075140;          /* libcd status word pointer */
extern int D_80074E5C[];         /* sync-status name table */
extern int D_80074EDC[];         /* ready-status name table */
extern unsigned char D_80074E55; /* sync index */
extern unsigned char D_80075114; /* ready index (Sync) */
extern unsigned char D_80075115; /* ready index (Ready) */

/* libcd CdDataSync (0x800655a0, 0x16c). Spins up to ~0x3C0 VSyncs (or 0x3C0000
   iterations) for the data-ready bit (0x1000000) of *D_80075140. On timeout
   prints "CD timeout: <op>:(<sync>) Sync=.., Ready=.." and resets the drive.
   Returns 1 = still busy (mode != 0 poll), 0 = ready, -1 = timed out.

   PARKED length- AND layout-exact (90/90 insns); the only residue is the
   WritePrintf argument block. Re-derived from scratch 2026-08-12-1; the
   2026-07-25 permuter spew it replaces was +1 insn with a different tail.
   Solved here, and load-bearing — do not "simplify":
     - the timeout check is the same inlined libcd helper as CheckGpuTimeout:
       one `||` over the VSync deadline and the post-incremented spin counter,
       with the arms assigning r = -1 / 0 and a separate `if (r != 0) return
       -1;`.  That `r`, not a direct `return -1;`, is what produces the
       original's `j .L800656BC` + second `li -1` in the bnez delay slot.
     - the loop tail must be `break` out of a `for (;;)` with `return 0` as the
       FUNCTION tail and `return 1` as the early return inside the loop.  Any
       arrangement with `return 0` inside the loop (including the do/while
       (mode == 0) + trailing `return 1` form) leaves the 0-arm as a real block
       between the loop-back branch and the epilogue, costing `j`/`nop`/`move`
       (+4 insns): reorg can only fold the constant into the beqz delay slot
       when nothing sits between that branch and the shared epilogue.
     - the three table bases are pointer locals ASSIGNED AFTER the first VSync
       call (assigning them at their declarations hoists all six la insns above
       the call).  Dropping them and writing D_80074EDC[D_80075114] directly
       costs 6 insns and two callee-saved regs — loop.c's invariant hoist is
       not what the original used.  Declaration order fixes the registers
       (readyIdx -> s1, readyTbl -> s0, syncTbl -> s3); the ASSIGNMENT order is
       the A164 straggler order for the three la pairs (syncTbl first).
   Residue: 14 insns, F-class sched1 tie in the one WritePrintf arg block.  The
   original computes the a3 chain (readyTbl[readyIdx[0]]) FIRST and parks its
   address in a0 until just before the `jal`, then the stack arg, then
   syncTbl[D_80074E55]; ours schedules the stack-arg chain first and defers the
   a3 chain to the end.  Both are the same 16 insns with the same registers
   otherwise.  Measured identical (no RTL change): block-scoped idx0/idx1
   locals after WriteString, locals before WriteString (worse - they land in
   s4/s5 across the call), and *readyIdx vs readyIdx[0].  Permuter candidate:
   one basic block, length-exact, pure schedule. */
int CdDataSync(int mode) {
  unsigned char *readyIdx;
  int *readyTbl;
  int *syncTbl;
  int r;

  D_80075AE8 = VSync(-1) + 0x3C0;
  syncTbl = D_80074E5C;
  readyIdx = &D_80075114;
  readyTbl = D_80074EDC;
  D_80075AEC = 0;
  D_80075AF0 = D_80011F04;

  for (;;) {
    if (VSync(-1) > D_80075AE8 || D_80075AEC++ > 0x3C0000) {
      WriteString(D_80011DFC);
      WritePrintf(D_80011E0C, D_80075AF0, syncTbl[D_80074E55],
                  readyTbl[readyIdx[0]], readyTbl[readyIdx[1]]);
      CdResetController();
      r = -1;
    } else {
      r = 0;
    }
    if (r != 0) {
      return -1;
    }
    if ((*D_80075140 & 0x1000000) == 0) {
      break;
    }
    if (mode != 0) {
      return 1;
    }
  }
  return 0;
}
