/* 0x800495d8: PARKED 2026-07-08, best form 140/136 bytes (4 bytes / 1
   instruction over). Correct logic (matches funcs.h's documented semantics
   for this function). Two shapes tried, neither exact:
   - "Always store raw sum, then test" (`*p = sub; if ((u8)sub>=0x10) { *p =
     sub-0x10; ...} `) matches the original's held-base array-alias trick for
     `p` but forces an extra `move v0,v1` before the store (the original's
     `sb` in the branch delay slot stores the raw sum register directly, no
     copy) -- 4 bytes over.
   - Early-return / if-else forms (`if ((u8)sub<0x10) { *p=sub; return; } *p
     = sub-0x10; ...`, and the arm-inverted else variant) avoid the extra
     move but trigger gcc's early-return-block relocation (cookbook idiom:
     small arm gets pushed to the tail with an added `j`) -- 8 bytes / 3
     instructions over instead.
   The original's actual shape needs the SHORT arm's `sb` to land directly in
   the overflow-test branch's delay slot with NO extra move and NO
   relocation `j` -- some source form threads that needle without hitting
   either penalty. Permuter candidate (single word/reg swap only, high
   correctness confidence). */
void AdvanceSpyroAnimLayer1Frame(int param_1) {
  unsigned char *sub_ptr = g_abSpyroAnimLayer1SubstepBlock;
  unsigned char sub;
  unsigned char frame;
  unsigned char anim;
  unsigned char newFrame;
  unsigned char len;

  sub = *sub_ptr + param_1;
  *sub_ptr = sub;
  if ((unsigned char)sub >= 0x10) {
    *sub_ptr = sub - 0x10;

    frame = D_80078A79;
    anim = D_80078A73;
    newFrame = frame + 1;
    D_80078A72 = anim;
    D_80078A78 = frame;
    D_80078A79 = newFrame;

    len = g_abSpyroAnimDescTable[anim * 4 + 2];
    if ((unsigned char)newFrame >= len) {
      D_80078A79 = len - 1;
    }
  }
}
