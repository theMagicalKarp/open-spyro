#include "globals.h"

/* Enter the gem-cutscene gamestate (0x8002d338, gamestate 0xE): reset the
   generic countdown fade and the path-table head, raise the storm flag when
   entering from world 1, then build the cutscene sample-bank entry at
   D_800778F0 (sample 0x1010, per-world pitch from g_nWorldCutsceneSamplePitch)
   and trigger it via PlaySoundEffect with the gem-pickup voice marker.

   2026-07-25-1 unattended permuter session (~15m, ~90300 iterations, timed out
   at the 15m budget): best score 105 vs base score 170. No byte-perfect
   candidate found; still parked. */
extern int PlaySoundEffect(unsigned int sample, int a, unsigned int b, void *c);
extern int D_800778F0[];
/* volatile alias of g_pLevelSampleBankEntries — the entry writes below reload
   the pointer global before every store */
extern char *volatile D_800761D0;
extern int D_800761DC;
extern short D_800761E8;
extern short D_800761EA;

/* NOTE: the function body below is decomp-permuter output from the
   2026-07-25 sweep, kept for its partial-byte credit. It is machine-
   generated and reads worse than the hand-written form it replaced;
   the analysis above and below still describes the residue accurately.
   Original hand-written body: git show HEAD:src/c/BeginGemCutscene.c.wip
   Best candidate:
   build/permuter/nonmatchings/BeginGemCutscene/output-105-1/source.c */

void BeginGemCutscene(void) {
  register int world = g_nCurrentWorldId;
  int *new_var;
  g_nGamestate = 0xE;
  g_nGenericCountdown = 0;
  new_var = (int *)g_pPathTableHead;
  *new_var = 0;
  if (world == 1) {
    g_nLevelStormFlag = 1;
  }
  new_var = D_800778F0;
  D_800761D0 = (char *)new_var;
  *((int *)D_800761D0) = 0x1010;
  *((int *)(D_800761D0 + 4)) = -1;
  *((short *)(D_800761D0 + 8)) = 0x50;
  *((short *)(D_800761D0 + 0xA)) = (&g_nWorldCutsceneSamplePitch)[world];
  *((short *)(D_800761D0 + 0xC)) = 0;
  *((short *)(D_800761D0 + 0xE)) = 0;
  *((int *)(D_800761D0 + 0x10)) = 0;
  D_800761DC = 1;
  world = 0;
  D_800761E8 = 0x3FFF;
  D_800761EA = 0x3FFF;
  PlaySoundEffect(world, 0, 0x10, &g_bGemPickupSfxVoiceMarker);
}
