#include "globals.h"

extern void FillWord(void *dst, unsigned int value, int byte_count);
extern void CopyVector(int *dst, int *src);

/* Read g_pSpriteRecordWriteCursor volatile-ly: the original re-loads the queue
   tail from the global at every field access (no held base). */
#define CURSOR (*(void *volatile *)&g_pSpriteRecordWriteCursor)

/* Emit a glyph-sprite chain for a string: per non-space byte allocate a
   0x58-byte SPRT slot at g_pSpriteRecordWriteCursor (queue tail, grows down),
   map '0'-'9' and 'A'-'Z' (+ specials '/','?','%','^','+') to font tile
   indices, copy the pen position from *param_2 and advance it by param_3
   between glyphs (0x80017fe4, 0x1c8). */
void *BuildTextSpriteChain(unsigned char *param_1, int *param_2, int param_3,
                           int param_4) {
  unsigned char bVar1;
  unsigned int uVar3;
  unsigned short uVar2;

  bVar1 = *param_1;
  while (bVar1 != 0) {
    if (bVar1 != 0x20) {
      CURSOR = (void *)((int)CURSOR - 0x58);
      FillWord(CURSOR, 0, 0x58);
      CopyVector((int *)((int)CURSOR + 0xc), param_2);
      bVar1 = *param_1;
      uVar3 = (unsigned int)bVar1;
      if (uVar3 - 0x30 < 10) {
        *(unsigned short *)((int)CURSOR + 0x36) = bVar1 + 0xd4;
      } else if (uVar3 - 0x41 < 0x1a) {
        *(unsigned short *)((int)CURSOR + 0x36) = bVar1 + 0x169;
      } else {
        if (uVar3 == 0x2f) {
          uVar2 = 0x115;
        } else if (uVar3 == 0x3f) {
          uVar2 = 0x116;
        } else if (uVar3 == 0x25) {
          uVar2 = 0x110;
        } else if (uVar3 == 0x5e) {
          uVar2 = 0x141;
        } else {
          uVar2 = 0x147;
          if (uVar3 == 0x2b) {
            uVar2 = 0x13d;
          }
        }
        *(unsigned short *)((int)CURSOR + 0x36) = uVar2;
      }
      *(unsigned char *)((int)CURSOR + 0x47) = 0x7f;
      *(unsigned char *)((int)CURSOR + 0x4f) = param_4;
      *(unsigned char *)((int)CURSOR + 0x50) = 0xff;
    }
    param_1 = param_1 + 1;
    *param_2 = *param_2 + param_3;
    bVar1 = *param_1;
  }
  return CURSOR;
}

/* PARKED. Sprite-record glyph builder, §F-ish vein. Digit + letter arms match
   byte-identical (per-arm cursor reload via the volatile CURSOR macro + inline
   sh). Residue is ONLY the special-char (else) block: the original reloads the
   queue-tail cursor in EACH special arm and cross-joins the 5 stores into one
   shared `sh v0,0x36(v1)` at 0x8001812c, keeping the case value in v0. My gcc
   allocates the merged uVar2 into a0 (free after the char's last use) and sinks
   the cursor reload to a single spot at the merge -> 105/114 (9 short, shared
   form here). Duplicating the store into each special arm forces per-arm reloads
   but gcc does NOT cross-join the 5 sh -> 117/114 (3 over, slot overflow). Pure
   local-alloc (value reg a0 vs v0) + jump2 cross-join tie; §J/§P class. Permuter
   candidate. */
