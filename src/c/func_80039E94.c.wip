#include "globals.h"

/* PARKED at 10/182 (94.5%) — LENGTH-EXACT and links (was +1 insn / slot
   overflow). Two of the three parked classes are solved:
     * the cross-branch `li v1,255` hoist into the 0x80039f8c delay slot is
       an F14 birthing question, not a schedule one. A bare `0xFF` comparand
       is a single-set pseudo, so sched.c boosts it to max_priority and it
       sinks next to its `bne` INSIDE the backward arm (+1 insn). Giving both
       arms ONE `wrap` comparand local (`wrap = path[0]` / `wrap = 0xFF`)
       makes it reg_n_sets==2, non-birthing, so it keeps priority 1 and
       drifts to the FRONT of the backward arm — which is the branch TARGET
       thread, so reorg lifts it straight into the delay slot. The shared
       local is also why both arms compare against v1 in the original.
     * `ret` was taking s4 (allocated first) where the original has fp
       (allocated last). Three `return ret;` statements make it 5 refs
       (2 sets + 3 uses, `dies in 3 places`); one exit drops it to 3, and
       floor_log2(3)*3/92 = 326 falls below every parameter allocno, so it is
       allocated last and lands fp. jump2 still duplicates the epilogue, so
       the three `move v0,fp` insns are unchanged.
   Residue (10 insns, all one tie): `step` (stack param @0x54) and `kind`
   (@0x5c) exchange s6/s7, which also swaps their two prologue home insns.
   Measured with -dg: both have 4 refs, but global.c priority is
   floor_log2(R)*R/live_length, and step is live 202 insns vs kind 182 =>
   396 vs 439, so kind is allocated first. kind only reaches 4 refs because
   flow weights its `peer[0x43] == kind` use by loop depth; step's three uses
   are all straight-line. To flip, kind needs live_length > 202 or 3 refs —
   its last use is the scan loop and step's is the final else arm, so
   closing the 20-insn gap needs the arms reordered, which moves the emitted
   branch layout. Ties break on allocno number (77 step < 79 kind), so an
   exact live-length tie would also do it. */

/* Waypoint path-follow driver (0x80039e94, 0x2d8). Steers the actor
   toward its current path node (path[1] = node index, 16-byte node
   records at +8/+0xC/+0x10). On arrival (2D distance and, with flags
   bit 8, Z distance within `thresh`) advances the node index — forward
   with wrap when the path's +6 halfword is -1, backward with wrap to
   path[0]-1 otherwise — and reports it as 0x100+index in the return.
   When the heading delta to the node exceeds `lim`, turns in place via
   ApproachAngle8 (deferring the turn when another listed actor of the
   same `kind` is already mid-turn); otherwise marks the actor moving
   and delegates the step to func_80038EE0 + func_80039398.

   2026-07-25-1 unattended permuter session (~15m, ~63000 iterations, timed out
   at the 15m budget): best score 125 vs base score 500. No byte-perfect
   candidate found; still parked. */
extern int ApproxDist2D(int *a, int *b);
extern int ArcTan2(int x, int y, int mode);
extern int AbsAngleDelta8(int a, int b);
extern int ApproachAngle8(int target, int cur, int step, int lim);
extern int func_80038EE0(int *actor, int ang, int step, int lim, int mode);
extern int func_80039398(int *actor, int speed, int group, int radius,
                         int flags);
extern int abs(int);

extern int D_800756C4;
extern void *g_apSaveMenuAnimActorListBlock[];

/* NOTE: the function body below is decomp-permuter output from the
   2026-07-25 sweep, kept for its partial-byte credit. It is machine-
   generated and reads worse than the hand-written form it replaced;
   the analysis above and below still describes the residue accurately.
   Original hand-written body: git show HEAD:src/c/func_80039E94.c.wip
   Best candidate:
   build/permuter/nonmatchings/func_80039E94/output-125-1/source.c */

int func_80039E94(int *actor, unsigned char *path, int thresh, int speed,
                  int group, int step, int lim, int kind, int flags) {
  int ret;
  int zclose;
  int ang;
  int t;
  int wrap;
  int *node;
  void **list;
  unsigned char *peer;
  if (D_800756C4 == 3) {
    speed += speed >> 1;
  } else if (D_800756C4 == 4) {
    speed <<= 1;
  }
  ret = 0;
  if (flags & 0x100) {
    zclose = abs(actor[5] - ((int *)(path + (path[1] << 4)))[4]) < thresh;
  } else {
    zclose = 1;
  }
  if ((ApproxDist2D(actor + 3, (int *)(path + ((path[1] << 4) + 8))) <
       thresh) &&
      (zclose != 0)) {
    *((unsigned char *)(((char *)actor) + 0x49)) = 0;
    if ((*((short *)(path + 6))) == (-1)) {
      wrap = path[0];
      t = path[1] + 1;
      path[1] = t;
      if ((t & 0xFF) == wrap) {
        path[1] = 0;
      }
    } else {
      wrap = 0xFF;
      t = (path[1] = path[1] - 1);
      if ((t & 0xFF) == wrap) {
        path[1] = path[0] - 1;
      }
    }
    ret = path[1] + 0x100;
  }
  node = (int *)(path + (path[1] << 4));
  ang = ArcTan2(node[2] - actor[3], node[3] - actor[4], 0);
  if (AbsAngleDelta8(ang, *((unsigned char *)(((char *)actor) + 0x46))) <=
      lim) {
    *((unsigned char *)(((char *)actor) + 0x49)) = 1;
    func_80038EE0(actor, ang, step, lim, 1);
    func_80039398(actor, speed, group, 0, flags);
    goto done;
  }
  if (((*((unsigned char *)(((char *)actor) + 0x49))) == 0) && (kind != 0xFF)) {
    list = g_apSaveMenuAnimActorListBlock;
    while ((peer = (unsigned char *)(*(list++))) != 0) {
      if (((peer[0x43] == kind) && (((unsigned int)peer[0x48]) < 0x80)) &&
          (peer[0x49] == 1)) {
        break;
      }
    }

    if (peer != 0) {
      goto done;
    }
    *((unsigned char *)(((char *)actor) + 0x46)) = ApproachAngle8(
        ang, *((unsigned char *)(((char *)actor) + 0x46)), step, lim);
    *((unsigned char *)(((char *)actor) + 0x49)) = 2;
  } else {
    *((unsigned char *)(((char *)actor) + 0x46)) = ApproachAngle8(
        ang, *((unsigned char *)(((char *)actor) + 0x46)), step, lim);
  }
done:
  return ret;
}
