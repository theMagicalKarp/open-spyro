#include "globals.h"

/* PARKED .wip — structure & logic byte-exact except ONE scheduling insn.
   Residue: in the backward-wrap branch the original fills the `path[6]==-1`
   branch's delay slot (0x80039f8c) with `li v1,255` (the `(t&0xFF)==0xFF`
   comparand), so its backward branch reuses v0 for the andi and needs no
   separate `li`. Our gcc emits `li v0,255` LATE inside the branch instead
   (andi->v1, sb, li v0,255, bne v1,v0) = +1 insn (+4 bytes, link overflows
   the slot). The forward branch already matches exactly; only backward
   differs because its comparand is a constant, not a load. This +1 then
   cascades the s-reg rotation (ret gets s4/highest-priority; original puts
   ret in fp/s8 = allocated LAST). Preheader fold FIXED via
   g_apSaveMenuAnimActorListBlock alias (see symbol_addrs.txt). This is a
   pure delay-slot-constant-hoist schedule tie -> permuter candidate; no
   source form probed (natural order, `0xFF ==` swap, both fail) reproduces
   the cross-branch hoist. Verified: all 3 returns copy fp->v0; node/ang
   reuse s0; scan loop body byte-identical. */

/* Waypoint path-follow driver (0x80039e94, 0x2d8). Steers the actor
   toward its current path node (path[1] = node index, 16-byte node
   records at +8/+0xC/+0x10). On arrival (2D distance and, with flags
   bit 8, Z distance within `thresh`) advances the node index — forward
   with wrap when the path's +6 halfword is -1, backward with wrap to
   path[0]-1 otherwise — and reports it as 0x100+index in the return.
   When the heading delta to the node exceeds `lim`, turns in place via
   ApproachAngle8 (deferring the turn when another listed actor of the
   same `kind` is already mid-turn); otherwise marks the actor moving
   and delegates the step to func_80038EE0 + func_80039398.

   2026-07-25-1 unattended permuter session (~15m, ~63000 iterations, timed out
   at the 15m budget): best score 125 vs base score 500. No byte-perfect
   candidate found; still parked. */
extern int ApproxDist2D(int *a, int *b);
extern int ArcTan2(int x, int y, int mode);
extern int AbsAngleDelta8(int a, int b);
extern int ApproachAngle8(int target, int cur, int step, int lim);
extern int func_80038EE0(int *actor, int ang, int step, int lim, int mode);
extern int func_80039398(int *actor, int speed, int group, int radius,
                         int flags);
extern int abs(int);

extern int D_800756C4;
extern void *g_apSaveMenuAnimActorListBlock[];

int func_80039E94(int *actor, unsigned char *path, int thresh, int speed,
                  int group, int step, int lim, int kind, int flags) {
  int ret;
  int zclose;
  int ang;
  int t;
  int *node;
  void **list;
  unsigned char *peer;

  if (D_800756C4 == 3) {
    speed += speed >> 1;
  } else if (D_800756C4 == 4) {
    speed <<= 1;
  }
  ret = 0;
  if (flags & 0x100) {
    zclose = abs(actor[5] - ((int *)(path + (path[1] << 4)))[4]) < thresh;
  } else {
    zclose = 1;
  }
  if (ApproxDist2D(actor + 3, (int *)(path + ((path[1] << 4) + 8))) < thresh &&
      zclose != 0) {
    *(unsigned char *)((char *)actor + 0x49) = 0;
    if (*(short *)(path + 6) == -1) {
      t = path[1] + 1;
      path[1] = t;
      if ((t & 0xFF) == path[0]) {
        path[1] = 0;
      }
    } else {
      t = path[1] - 1;
      path[1] = t;
      if ((t & 0xFF) == 0xFF) {
        path[1] = path[0] - 1;
      }
    }
    ret = path[1] + 0x100;
  }
  node = (int *)(path + (path[1] << 4));
  ang = ArcTan2(node[2] - actor[3], node[3] - actor[4], 0);
  if (AbsAngleDelta8(ang, *(unsigned char *)((char *)actor + 0x46)) <= lim) {
    *(unsigned char *)((char *)actor + 0x49) = 1;
    func_80038EE0(actor, ang, step, lim, 1);
    func_80039398(actor, speed, group, 0, flags);
    return ret;
  }
  if (*(unsigned char *)((char *)actor + 0x49) == 0 && kind != 0xFF) {
    list = g_apSaveMenuAnimActorListBlock;
    while ((peer = (unsigned char *)*list++) != 0) {
      if (peer[0x43] == kind && (unsigned int)peer[0x48] < 0x80 &&
          peer[0x49] == 1) {
        break;
      }
    }
    if (peer != 0) {
      return ret;
    }
    *(unsigned char *)((char *)actor + 0x46) = ApproachAngle8(
        ang, *(unsigned char *)((char *)actor + 0x46), step, lim);
    *(unsigned char *)((char *)actor + 0x49) = 2;
  } else {
    *(unsigned char *)((char *)actor + 0x46) = ApproachAngle8(
        ang, *(unsigned char *)((char *)actor + 0x46), step, lim);
  }
  return ret;
}
