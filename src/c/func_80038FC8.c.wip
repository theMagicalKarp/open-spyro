#include "globals.h"

/* Steer an actor's yaw toward Spyro (0x80038fc8, 0x260). Computes the
   signed wrap-around delta between the ArcTan2 bearing to Spyro and the
   tracked yaw at *yawp, picks/holds a turn direction in *dirp (dir 0
   seeds from the delta sign; an established direction only flips once
   the opposite-side delta exceeds `thresh`), and advances *yawp by the
   gamestate-scaled `speed` clamped to the remaining delta. While more
   than 0x101 off-bearing it swaps the actor's anim pair at +0x3C..+0x41
   (animId when turning positive, animId+1 otherwise) through
   func_80037E98. Stores the coarse yaw at +0x46; returns the delta. */
extern int ArcTan2(int y, int x, int mode);
extern void func_80037E98(int *actor, int a, int b);
extern int abs(int);

extern int D_800756C4;
extern int D_80075794;

int func_80038FC8(int *actor, int *dirp, int *yawp, int speed, int thresh,
                  int animId) {
  int ret;
  int yaw;
  int d;
  int d2;
  int ad;
  int dir;
  int next;
  int t;
  int c16;

  ret = ArcTan2(g_anSpyroWorldPos[0] - actor[3],
                g_anSpyroWorldPos[1] - actor[4], 1);
  yaw = *yawp;
  d = (ret - yaw) & 0xFFF;
  ret -= 0x800;
  d2 = (ret - yaw) & 0xFFF;
  if (d >= 0x801) {
    d -= 0x1000;
  }
  if (d2 >= 0x801) {
    d2 -= 0x1000;
  }
  if (D_800756C4 == 3) {
    speed += speed >> 1;
  } else if (D_800756C4 == 4) {
    speed <<= 1;
  }
  ad = abs(d);
  if (ad < speed) {
    speed = ad;
  }
  dir = *dirp;
  if (dir == 0) {
    if (d < 0) {
      *dirp = -1;
    } else {
      *dirp = 1;
    }
  } else if (d < 0) {
    if (dir > 0) {
      if (thresh < abs(d2)) {
        *dirp = -1;
      }
    }
  } else if (dir < 0 && d > 0) {
    if (thresh < abs(d2)) {
      *dirp = 1;
    }
  }
  if (abs(d) >= 0x101) {
    next = animId + 1;
    if (*dirp == 1) {
      if (*((unsigned char *)actor + 0x3D) != animId) {
        int old;
        int p3F;
        D_80075794 = 0;
        old = *((unsigned char *)actor + 0x3D);
        p3F = *((unsigned char *)actor + 0x3F);
        c16 = 0x10;
        *((unsigned char *)actor + 0x40) = c16;
        *((unsigned char *)actor + 0x41) = c16;
        *((unsigned char *)actor + 0x3D) = animId;
        *((unsigned char *)actor + 0x3F) = 0;
        *((unsigned char *)actor + 0x3C) = old;
        *((unsigned char *)actor + 0x3E) = p3F;
        func_80037E98(actor, p3F, next);
      }
    } else {
      if (*((unsigned char *)actor + 0x3D) != next) {
        int old;
        int p3F;
        D_80075794 = 0;
        old = *((unsigned char *)actor + 0x3D);
        p3F = *((unsigned char *)actor + 0x3F);
        c16 = 0x10;
        *((unsigned char *)actor + 0x40) = c16;
        *((unsigned char *)actor + 0x41) = c16;
        *((unsigned char *)actor + 0x3D) = next;
        *((unsigned char *)actor + 0x3F) = 0;
        *((unsigned char *)actor + 0x3C) = old;
        *((unsigned char *)actor + 0x3E) = p3F;
        func_80037E98(actor, p3F, next);
      }
    }
  }
  t = *yawp + speed * *dirp;
  *yawp = t;
  if (t < 0) {
    *yawp = t + 0x1000;
  }
  *((char *)actor + 0x46) = *yawp >> 4;
  return d;
}

/* 2026-08-16-1 — one more escape from the mutual exclusion RULED OUT. The note
   below assumes global_alloc needs `reg_n_sets >= 2`; it does not —
   local-alloc's gate is `reg_basic_block[i] >= 0 && reg_n_deaths[i] == 1`, so a
   SINGLE-set pseudo referenced from more than one basic block also falls to
   global_alloc and would get both halves (boost + v1). Measured both placements
   of a single `c16 = 0x10;` dominating the two arms (top of the `abs(d) >=
   0x101` block, and above that `if`): gcc does NOT rematerialise the constant
   per arm — it leaves ONE `li` in the dominator block, so the function comes
   out a word short and will not link. The mutual exclusion stands. */

/* PARKED at 97.4% (4/152 insns, was 9/152) — length-exact, one root cause per
   arm. The two anim arms need `old`(lbu 0x3D) in v0, the 0x10 constant in v1,
   AND the `li v1,16` sitting right before its two `sb`s while the call-arg copy
   `move a0,s0` drifts to the front (reorg then eats it into the beq delay
   slot). Those two requirements are the F14b mutual exclusion, measured here:

     - single-set const (a bare 0x10 literal, or a block-scoped local): sched.c
       birthing_insn_p boosts it -> it sinks next to its stores (POSITION
   RIGHT), but it is then block-local with reg_n_deaths==1, so local-alloc takes
   it first — qty priority floor_log2(3)*3/6 = 5000 vs `old`'s floor_log2(2)*2/9
   = 2222 — and hands it v0 (REGISTER WRONG, 9/152).
     - function-scope carrier assigned in BOTH arms (this file): reg_n_sets==2
   => reg_basic_block==-1 => global_alloc, which runs after local-alloc, so
   `old` takes v0 and the const takes v1 (REGISTER RIGHT). But >=2 sets also
   kills the birthing boost, so the `li` keeps priority 1 and joins the
   priority-1 straggler pool, where rank_for_schedule sorts on INSN_LUID
   descending and the lowest LUID is placed FIRST — the `li` (LUID 235) beats
   the call-arg copy (LUID 256) to the front of the block and dbr puts IT in the
   delay slot. 4/152: the delay-slot insn and the position-5 insn, x2 arms.

   Why neither half is reachable from the other:
     * Register, single-set case: local-alloc priority is computed from the
       POST-sched1 lifetimes (life_analysis re-runs after sched1 — verified:
   moving the load/store statements around left `old` at 2 refs/8-9 insns and
   the const at 3/6 in every variant), so the 2.25x gap cannot be closed by
   source order. `old` would need 4 refs with one death, and 2 sets in one block
   always means 2 deaths => global.
     * Position, multi-set case: A164 says permute the group, but the const's
   set must precede its uses, which precede the call, so its LUID is
   structurally below the arg copy's. No C form raises it. Variants measured
   this session: c16 at the top of the arm / next to its stores / as `unsigned
   char` (all 4/152); single-set c16 with `old` loaded late and stored
   immediately (11/152 — the register mirror returns and the two lbus swap).
   Next idea would have to make the `li` ineligible for the delay slot (its dest
   live on the taken path) at zero insn cost, or find a 3rd use of `old`. */

/* 2026-08-21-1 — THE REGISTER HALF OF THE MUTUAL EXCLUSION IS RETIRED.  The
   note above says a single-set c16 is unreachable because local-alloc "takes it
   first ... and hands it v0 (REGISTER WRONG)".  That is only true at `old`'s
   default ref count.  `qty_compare`'s priority is
   `floor_log2(n_refs) * n_refs * qty_size / (death - birth)` (read off
   local-alloc.c) and it is dialable through **A195, which raises `reg_n_refs`
   because flow.c weights every ref by `loop_depth`** — so a `do { } while (0);`
   around a statement adds one ref per reference in it, at zero emitted code.
   Measured with the SD-2c probe (`cc1 -dl`), per arm block:
     baseline single-set c16 (E1): old 2 refs / 9 insns = 2222, c16 3/6 = 5000.
     wrap `old`'s DEF only:        old 3/11 = 2727.  Still loses.
     wrap `old`'s USE only:        old 3/8  = 3750.  Still loses.
     wrap BOTH def and use:        old **4/8 = 10000**, c16 3/6 = 5000 -> old
                                   takes v0 and c16 takes v1.  **REGISTER RIGHT
                                   WITH c16 SINGLE-SET**, which the note above
                                   calls impossible.
   Note `floor_log2` is a step function: 3 refs is still floor_log2 == 1, so the
   dial does nothing until it reaches 4.  That is why the one-sided wraps look
   like failures and why an earlier session concluded the gap "cannot be
   closed".

   WHAT BLOCKS IT NOW is a different, cheaper-looking problem: the do/while is
   also an A200 cse/block barrier, and the barrier at the USE site lets jump.c
   CROSS-JUMP the two arms' identical `func_80037E98(actor, p3F, next)` tails.
   Both per-arm `move a0,s0` copies then collapse into one in the shared tail
   (ours at 125, the original has one per arm at 101 and 114), and the `li`
   drifts to the front again.  Score 7/152 aligned (49 linked) for every
   use-site spelling measured: 1x, 2x and 3x nesting on the use, and def+use
   together, are all BIT-IDENTICAL to each other — the dial saturates.
   So the open question is no longer "can c16 be single-set" (yes) but
   **"can `old` reach 4 refs without a barrier at its use"**.  flow.c's
   loop_depth is the only mechanism that raises reg_n_refs, and a real third
   reference costs an insn, so this needs either a loop-shaped construct that
   jump.c deletes before cross-jumping runs, or something that keeps the two
   arms' tails distinct so cross-jumping cannot fire.
   Park state UNCHANGED at 4/152 (the multi-set c16 body below) — it is still
   the best score; E1's single-set body is 9/152 and the E5 dial body is 7. */

/* 2026-08-23 — THE RESIDUE IS NOT A CROSS-JUMP PROBLEM, AND THE 2026-08-21-1
   "next step" was aimed at the wrong pass.  Re-measured from the LINKED diff
   (4/152, unchanged) and the sched1 trace (SD 2d, `cc1 -dS`):

   WHAT THE FOUR INSNS ACTUALLY ARE.  Per arm, exactly two insns are SWAPPED:
     orig  8003915c/80039190  move a0,s0   (in the guard `beq`'s delay slot)
     orig  80039170/800391a4  li   v1,16   (immediately before its two `sb`s)
   ours has the same two insns in the same block with the positions exchanged.
   Both builds cross-jump the arms IDENTICALLY — the original's shared tail is
   .L800391B4 (`sb zero,3F / sb v0,3C / jal / sb a1,3E`, 4 insns) and the
   per-arm `move a0,s0` sits above the differing `sb ?,0x3D`, which is what
   keeps it out of the merge in BOTH builds.  So "make the tails textually
   distinct so cross-jumping cannot fire" is not the goal; nothing about the
   merge differs.

   WHY THE SWAP HAPPENS (measured, do not re-derive).  In the arm's block both
   insns are priority-1 stragglers with no in-block operands, so they are placed
   at the block's two scheduling bubbles (head, and the slot before the `sb`
   batch).  The sched1 trace ends:
     ;; ready list at T-14: 256 (1) 235 (1), now 256 235   -> 256 picked
     ;; ready list at T-15: 235 (1), now 235
   insn 256 is `(set (reg a0) (reg 72))`, insn 235 is `(set (reg 86) 16)`.
   `rank_for_schedule` breaks the priority tie on INSN_LUID DESCENDING and
   sched.c schedules backward, so the HIGHER-LUID insn is placed LATER.  The
   call's argument copy is emitted by expand_call at the call, i.e. at the very
   end of the arm, so its LUID is structurally above any user statement's — it
   can never lose this tie.  (sched2 then re-runs the same comparison on the
   sched1 order and reproduces it; the final asm's slot-5 insn is whichever one
   sched1 put second.)

   WHAT THE ORIGINAL MUST THEREFORE BE.  For `move a0,s0` to take the head, the
   `li v1,16` has to be ABSENT from the sched1 block and re-appear immediately
   before `sb v1,0x40` — which is exactly A215/A220's reload REMATERIALISATION
   insertion point.  That needs `local-alloc.c update_equiv_regs` to delete the
   constant pseudo, whose gate is `reg_n_refs == 2 && reg_basic_block < 0`
   (one set, one use, in DIFFERENT basic blocks).  Here the constant has two
   uses (`sb 0x40`, `sb 0x41`) that cse shares into one pseudo in one block, so
   refs == 3 and the pseudo always survives to be scheduled.
   THE OPEN QUESTION IS THEREFORE: can the 0x10 constant reach the two `sb`s
   with one set and one use per block?  Everything on the register axis
   (A195 ref dials on `old`, carrier vs literal, qty_compare arithmetic) is a
   consequence of the pseudo existing at all, and is the wrong axis.

   Measured this session, all against the 4/152 baseline:
     bare literals, no carrier          9/152 (as recorded 2026-08-16-1)
     `int *ap = actor;` at the arm top, call through `ap`   4/152 (copy
       propagation deletes it — no LUID change, as expected from the above)
     `sb ?,0x3D` moved ABOVE the c16 pair (A221 reorder)    length CHANGES
       (`zip() argument 2 is shorter`) — the merge grows; strictly worse.
*/

/* 2026-08-23-1 — THE SCHEDULE AND THE REGISTERS ARE TWO SEPARATE STATES, AND
   EACH IS INDIVIDUALLY REACHABLE.  This sharpens (and partly contradicts) the
   note above: the register axis is NOT "a consequence of the pseudo existing".

   Writing the two stores as BARE LITERALS (`*(actor+0x40) = 0x10;` etc., no
   carrier at all) gives the ORIGINAL'S SCHEDULE EXACTLY: `move a0,s0` takes
   both `beq` delay slots (orig 101/114) and the `li ?,16` lands at orig
   106/119, adjacent to its `sb`s.  The whole 4-insn schedule residue is gone.
   What is left in that state is a pure v0/v1 ROTATION, 9 insns over 5 regions:
   the constant takes v0 and `old` (the `lbu ?,61(s0)` at 104 that survives to
   `sb ?,60(s0)` at 124 in the cross-jumped tail) takes v1, where the original
   has them the other way round.  Arithmetic: the constant is 3 refs (one set,
   two uses) over 3 insns = 10000, `old` is 2 refs over 21 = 952, so local-alloc
   allocates the constant first and it takes the lowest free reg.  `old` spans
   the `j` into the shared tail, so it is a GLOBAL allocno and is assigned after
   local-alloc has already taken v0.

   AND AN A195 DIAL ON `old` FIXES THE REGISTERS — but reverts the schedule.
   `do { do { do { old = *((unsigned char *)actor + 0x3D); } while (0); }
   while (0); } while (0);` on the bare-literal body gives `li v1,16` (correct
   register) and comes back to 4/152 — but they are the SAME 4 as the baseline,
   i.e. the delay slots go back to `li v1,16`.  Depths measured on the
   bare-literal body: x1/x2 = 11, x3/x4 = 4, and a dial on the `*(actor+0x3C) =
   old;` store is 7 (and wrecks 103 words).  The two states are coupled by the
   dummy loop's NOTE, which is also what perturbs sched1.

   SO THE OPEN QUESTION IS NOW EXACT: **make v0 unavailable to the constant
   over orig 106-108 without introducing a loop note.**  Either lower the
   constant's local-alloc priority below `old`'s 952 (its range is pinned at 3
   insns by the two adjacent `sb`s, so this needs a different shape), or make
   `old` block-local AND higher priority, or get the constant deleted by
   `update_equiv_regs` as the note above describes (still the cleanest story:
   one deletion explains the delay slot, the position AND the register).
   Also measured and rejected this session: outer-block constant carriers
   (one, two per arm, four — all 150 insns, the arms lose two), and per-arm
   block-scoped `int c16 = 0x10;` (byte-identical to the shared carrier).
*/
