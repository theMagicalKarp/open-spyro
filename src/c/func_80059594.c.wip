#include "globals.h"

extern void CopyWords(void *dst, void *src, int byte_count);
extern void SetSpuCommonAttr(unsigned char *attr);
extern int ComputeSaveGameChecksum(unsigned char *data);

extern int D_80075838;
extern int D_8007583C;
extern short D_80075F18;
extern short D_80075F1A;
extern int D_80076224;
extern int D_80076228;
extern int D_80076228_blk[];

/* 0x80059594 (720 bytes) — memcard save-block deserializer: the inverse of
   BuildSaveGameBuffer.  Unpacks a 0x600-byte save buffer back into live game
   state (options bytes, scaled SPU/CD volumes, per-world tables, per-level
   tallies with recomputed world totals, kill bitmaps) and returns whether the
   stored checksum at +0x58C matches.

PARKED 97.8%, LENGTH-EXACT (4/180) -- was 6/180 (2026-08-30-1), and the
   older "15/180" / "11/180" figures in this header's history were already
   stale when written; re-measure before believing any park figure.
   Held-base SpuCommonAttr -0x320 region matches via the D_80076228_blk
   incomplete-array alias (A20).

   SOLVED 2026-08-25 (5 insns, do not regress): the world-table copy loop's
   preheader and increments are pure A164 straggler order.  The original's
   preheader is [move a3,s0 (row)] then [la a1 (tbl)] and its increments are
   [addiu a3,5 (row)] ... [addiu a1,5 (tbl)] in the backedge delay slot; ours
   had both the other way round.  Writing `row = buf;` BEFORE
   `tbl = g_abWorldPerLevelByteTable;` and `row += 5;` BEFORE `tbl += 5;` fixes
   all five insns (11 -> 6).  Neither half works alone (8 and 9).

   SOLVED 2026-08-30-1 (the a0/a1 knot, 6 register diffs -> 0): the world-totals
   accumulator loop is an A238 shape and the dial is TWO source edits, both in
   the block above:
     * `g = *((short *)(half + 0xAC));` is hoisted ABOVE `*dragons = d;`.  That
       makes g born one insn earlier, so its local-alloc live length goes 5 -> 6.
     * `*dragons = d;` is wrapped in `do { ... } while (0);`.  flow.c weights
       REG_N_REFS by loop depth, so that one reference of d counts 3 instead of
       2 and d goes 6 refs -> 7.
   qty_compare_1 is floor_log2(R)*R*size/(death-birth), so this moves the pair
   from d 2*6*4/6 = 80000 < g 2*6*4/5 = 96000 to d 2*7*4/6 = 93333 > g
   2*6*4/6 = 80000, and d takes a0.  Every register in the block is now correct
   (a0=d, a1=g, v0=wd, v1=wt).  MEASURED with cc1 -dl at each step; do not
   re-derive.  Two calibration facts worth keeping: a DOUBLE nest here is an
   over-shoot (8 refs -> floor_log2 steps to 3 -> 160000, d out-ranks the wd/wt
   pair and takes v0, 13/180), and the ref dial does NOT work in the original
   store-before-load source order (d tops out at 93333 against g's 96000, X/AB
   variants, 7 and 9).

   RESIDUE (4 insns, two same-position swaps):
   R1 `sw a0,0(t0)` <-> `lh a1,172(t1)`.  The original stores *dragons before
      loading g; we load g first.  This is FORCED by the fix above and is not a
      scheduling tie: gcc cannot disambiguate the two register-addressed MEMs,
      so whichever comes first in source gets the dependence edge and the
      emitted order is source order (with the A200 barrier between them it is
      source order by construction).  So R1 and the allocation are the SAME
      degree of freedom -- closing R1 needs a dial that gives d the higher
      qty_compare priority WITHOUT hoisting the g load.  Measured and inert in
      that order: the store nest alone (7), a nest on `wd + d` as well (9),
      re-reading `*dragons` to buy a cse ref (6, cse substitutes the pseudo so
      the ref count does not move), and both together (9).
   R2 `slti v0,a2,18` <-> `sw a1,0(t2)`.  Caused by the SECOND barrier: per B23
      the insn that carries the loop notes gets reg_pending_sets_all, so
      everything after it -- including the egg-guard compare -- depends on it,
      and `*gems = g` cannot be scheduled after the slti.  Without that barrier
      `addu v1,v1,a1` floats three slots early instead (6/180), so the barrier
      is a 4-insn-for-2 trade, not a fix.  Measured, all 4 or worse: barrier
      after `*gems` (4), barrier at the top of the if body (4), barrier around
      the treasure total (6), barrier before the if (6), a hoisted `cond`
      local (6 / 37), swapping the gems store past the treasure total (50).
   Also measured earlier, all inert or worse: A195 dials on d's def / store /
   add at depths 1-3 (11-17); every reordering of the wd/wt/d loads (6, 6);
   `dragons[0]` / `gems[0]` ARRAY_REF forms and the `((short *)half)[0x56]` form
   (all 6); `unsigned char d` (6); `short g` (length change); splitting the
   treasure add from its store with a reused or a fresh temp (11); `+=` on the
   two world globals instead of the wd/wt temps (+2 insns, will not link);
   moving the gems store past the egg `if` (27).

   2026-07-25-1 unattended permuter session (~15m, ~63600 iterations, timed out
   at the 15m budget): best score 120 vs base score 325. No byte-perfect
   candidate found; still PARKED (see above). */
/* NOTE: the body below still carries the 2026-07-25 permuter sweep's variable
   naming (new_var/new_var2/new_var3), but the two edits above are hand-made and
   the analysis describes the current residue exactly. A full re-derive is the
   obvious next step if the a0/a1 knot is ever re-opened. */

int func_80059594(unsigned char *buf) {
  unsigned char *start;
  int new_var2;
  unsigned char *common;
  int sfx;
  int sm;
  int mv;
  int w;
  int i;
  unsigned char *tbl;
  unsigned char *dst;
  unsigned char *src;
  unsigned char *end;
  int *eggs;
  int *gems;
  unsigned char *half;
  int new_var;
  unsigned int new_var3;
  int *dragons;
  unsigned char *row;
  unsigned char *row2;
  int d;
  int g;
  int e;
  int wd;
  int wt;
  int we;
  g_nActiveLevelId = buf[0];
  sfx = buf[1];
  sm = (sfx * 0x3FFF) / 10;
  D_80076228_blk[0] = sm;
  g_nSfxVolume = sfx;
  g_nSoundMasterVolume = (sm << 0xC) / 16383;
  mv = buf[2];
  common = ((unsigned char *)D_80076228_blk) - 0x320;
  *((int *)common) = 0xC0;
  g_nMusicVolume = mv;
  D_80076224 = mv << 0xB;
  D_80075F18 = mv << 0xB;
  D_80075F1A = mv << 0xB;
  SetSpuCommonAttr(common);
  new_var3 = *((unsigned int *)(buf + 4));
  g_nOptionVibrationEnabled = buf[3];
  g_dwActiveCameraOptions = new_var3;
  g_nSoundMonoMixFlag = buf[8];
  D_80075838 = buf[9];
  D_8007583C = buf[0xA];
  g_nExtraLives = buf[0xB];
  new_var = g_nExtraLives;
  start = buf;
  if (new_var < 4) {
    g_nExtraLives = 4;
  }
  CopyWords(g_anWorldPersistentFlags, buf + 0x10, 0x14);
  new_var2 = 0x64;
  w = 0;
  row = buf;
  tbl = g_abWorldPerLevelByteTable;
  do {
    dst = tbl;
    src = row + 0x24;
    end = tbl + 5;
    do {
      *(dst++) = *(src++);
    } while (((int)dst) < ((int)end));
    row += 5;
    w += 1;
    tbl += 5;
  } while (w < 5);
  CopyWords(g_abLevelVisitedFlag, buf + 0x40, 0x24);
  CopyWords(g_abLevelGemPercent, buf + new_var2, 0x24);
  i = 0;
  eggs = g_anLevelEggsRecovered;
  gems = g_anLevelGemsCollected;
  half = buf;
  dragons = g_anLevelDragonsRescued;
  g_nWorldDragonsRescued = 0;
  g_nWorldTreasureCollected = 0;
  g_nWorldEggsRecovered = 0;
  do {
    row2 = buf + i;
    d = row2[0x88];
    wd = g_nWorldDragonsRescued;
    wt = g_nWorldTreasureCollected;
    g = *((short *)(half + 0xAC));
    do {
      *dragons = d;
    } while (0);
    g_nWorldDragonsRescued = wd + d;
    do {
    } while (0);
    *gems = g;
    g_nWorldTreasureCollected = wt + g;
    if (i < 0x12) {
      e = row2[0xF4];
      we = g_nWorldEggsRecovered;
      *eggs = e;
      g_nWorldEggsRecovered = we + e;
    }
    eggs += 1;
    gems += 1;
    half += 2;
    i += 1;
    dragons += 1;
  } while (i < 0x24);
  i = 0;
  do {
    g_abSaveOptionsBlock[i] = *((buf + i) + 0x106);
    i += 1;
  } while (i < 6);
  CopyWords(g_anLevelKillBitmapTable, buf + 0x10C, 0x480);
  return (*((int *)(buf + 0x58C))) == ComputeSaveGameChecksum(start);
}
