#include "globals.h"

extern void CopyWords(void *dst, void *src, int byte_count);
extern void SetSpuCommonAttr(unsigned char *attr);
extern int ComputeSaveGameChecksum(unsigned char *data);

extern int D_80075838;
extern int D_8007583C;
extern short D_80075F18;
extern short D_80075F1A;
extern int D_80076224;
extern int D_80076228;
extern int D_80076228_blk[];

/* 0x80059594 (720 bytes) — memcard save-block deserializer: the inverse of
   BuildSaveGameBuffer.  Unpacks a 0x600-byte save buffer back into live game
   state (options bytes, scaled SPU/CD volumes, per-world tables, per-level
   tallies with recomputed world totals, kill bitmaps) and returns whether the
   stored checksum at +0x58C matches.

   PARKED 91.7%, LENGTH-EXACT (15/180). Everything matches except a single
   symmetric a0/a1 register swap in the world-totals accumulator loop:
   original puts d (dragon byte) in a0 and g (gem short) in a1; ours swaps
   them. Root cause (§F7 qty_compare): in the original, g's live range EQUALS
   d's because gems[i] is stored AFTER the treasure add (add/store split), so
   the tie breaks on birth order (d first -> a0). Ours stores gems[i] before
   the treasure add, giving g the shorter (nested) range and thus a0. Splitting
   the treasure add from its store to delay the gems store (fresh temp, reused
   wd, or reused wt) DOES equalize the range but cascades register pressure into
   the matched start=buf / g_dwActiveCameraOptions region (-> 88.9%) — a §F9
   double knot. Held-base SpuCommonAttr -0x320 region matches via the
   D_80076228_blk incomplete-array alias (A20). Permuter target.

   2026-07-25-1 unattended permuter session (~15m, ~63600 iterations, timed out
   at the 15m budget): best score 120 vs base score 325. No byte-perfect
   candidate found; still PARKED (see above). */
/* NOTE: the function body below is decomp-permuter output from the
   2026-07-25 sweep, kept for its partial-byte credit. It is machine-
   generated and reads worse than the hand-written form it replaced;
   the analysis above and below still describes the residue accurately.
   Original hand-written body: git show HEAD:src/c/func_80059594.c.wip
   Best candidate:
   build/permuter/nonmatchings/func_80059594/output-120-1/source.c */

int func_80059594(unsigned char *buf) {
  unsigned char *start;
  int new_var2;
  unsigned char *common;
  int sfx;
  int sm;
  int mv;
  int w;
  int i;
  unsigned char *tbl;
  unsigned char *dst;
  unsigned char *src;
  unsigned char *end;
  int *eggs;
  int *gems;
  unsigned char *half;
  int new_var;
  unsigned int new_var3;
  int *dragons;
  unsigned char *row;
  unsigned char *row2;
  int d;
  int g;
  int e;
  int wd;
  int wt;
  int we;
  g_nActiveLevelId = buf[0];
  sfx = buf[1];
  sm = (sfx * 0x3FFF) / 10;
  D_80076228_blk[0] = sm;
  g_nSfxVolume = sfx;
  g_nSoundMasterVolume = (sm << 0xC) / 16383;
  mv = buf[2];
  common = ((unsigned char *)D_80076228_blk) - 0x320;
  *((int *)common) = 0xC0;
  g_nMusicVolume = mv;
  D_80076224 = mv << 0xB;
  D_80075F18 = mv << 0xB;
  D_80075F1A = mv << 0xB;
  SetSpuCommonAttr(common);
  new_var3 = *((unsigned int *)(buf + 4));
  g_nOptionVibrationEnabled = buf[3];
  g_dwActiveCameraOptions = new_var3;
  g_nSoundMonoMixFlag = buf[8];
  D_80075838 = buf[9];
  D_8007583C = buf[0xA];
  g_nExtraLives = buf[0xB];
  new_var = g_nExtraLives;
  start = buf;
  if (new_var < 4) {
    g_nExtraLives = 4;
  }
  CopyWords(g_anWorldPersistentFlags, buf + 0x10, 0x14);
  new_var2 = 0x64;
  w = 0;
  tbl = g_abWorldPerLevelByteTable;
  row = buf;
  do {
    dst = tbl;
    src = row + 0x24;
    end = tbl + 5;
    do {
      *(dst++) = *(src++);
    } while (((int)dst) < ((int)end));
    tbl += 5;
    w += 1;
    row += 5;
  } while (w < 5);
  CopyWords(g_abLevelVisitedFlag, buf + 0x40, 0x24);
  CopyWords(g_abLevelGemPercent, buf + new_var2, 0x24);
  i = 0;
  eggs = g_anLevelEggsRecovered;
  gems = g_anLevelGemsCollected;
  half = buf;
  dragons = g_anLevelDragonsRescued;
  g_nWorldDragonsRescued = 0;
  g_nWorldTreasureCollected = 0;
  g_nWorldEggsRecovered = 0;
  do {
    row2 = buf + i;
    d = row2[0x88];
    wd = g_nWorldDragonsRescued;
    wt = g_nWorldTreasureCollected;
    *dragons = d;
    g = *((short *)(half + 0xAC));
    g_nWorldDragonsRescued = wd + d;
    *gems = g;
    g_nWorldTreasureCollected = wt + g;
    if (i < 0x12) {
      e = row2[0xF4];
      we = g_nWorldEggsRecovered;
      *eggs = e;
      g_nWorldEggsRecovered = we + e;
    }
    eggs += 1;
    gems += 1;
    half += 2;
    i += 1;
    dragons += 1;
  } while (i < 0x24);
  i = 0;
  do {
    g_abSaveOptionsBlock[i] = *((buf + i) + 0x106);
    i += 1;
  } while (i < 6);
  CopyWords(g_anLevelKillBitmapTable, buf + 0x10C, 0x480);
  return (*((int *)(buf + 0x58C))) == ComputeSaveGameChecksum(start);
}
