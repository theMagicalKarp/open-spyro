#include "globals.h"

extern uint GetRandomU32(void);
extern int LookupSine(uint angle_12_4);
extern void RotateVectorByMatrix(int *mtx, int *src, int *dst);
extern void ApplyActiveGteRotation(int *src, int *dst);
extern void SVectorToVector(int *dst, short *src);
extern void CopyVector(int *dst, int *src);
extern void ZeroVector(int *vec);
extern void AddVector(int *dst, int *a, int *b);
extern void SubtractVector(int *dst, int *a, int *b);
extern void CopyWords(void *dst, void *src, int byte_count);
extern int DispatchActorContactAtSphere(int *pos, int radius, int a, int mask,
                                        int e, int f);
extern int CastRayWorldAndActors(int *from, int *to);
extern uint PlaySoundEffect(uint sampleId, int *owner, uint mode,
                            void *pPlaying);

/* Held-base alias views (see config/symbol_addrs.txt). */
extern int g_anSpyroFlameBreathTimerBlock[]; /* 0x80078768 */
extern int g_anSpyroBodyMtxBlock[];          /* 0x80078a8c, -0x34 world pos */
extern unsigned char g_abSpyroPersistentEulerBlock[]; /* 0x80078a64 */
extern unsigned char
    g_abSpyroHornStrikeSegmentBlock[]; /* 0x80078761, +2 = ring row */
extern unsigned char g_abSpyroHornStrikeAnchorModeBlock[]; /* 0x80078762 */
extern int g_anSpyroHornStrikeAnchorMtxBlock[];            /* 0x8007876c */

extern unsigned char D_80078A78; /* layer-1 frame index */
extern unsigned char g_abSpyroAnimLayer1SubstepBlock[]; /* 0x80078a7d */

/* The particle spawner installed by the level overlay:
   (count, kind, world position, direction | NULL). */
#define SPAWN ((void (*)(int, int, int *, int *))g_pfnLevelOverlayParticleSpawn)

/* PARKED 2026-07-30-3 — 562/562 insns, 28 words differ (95.0%), every block
   positionally aligned.  Four residues, all named:

   F7  spill-slot order.  The original's spill block is [0x58 empty]
       [0x60 sfxDone] [0x68 UNUSED] [0x70 burst giv]; ours has no fourth
       spilled pseudo, so the giv lands at 0x68 and the frame comes out 0x98
       instead of 0xA0.  `int pad[2]` buys the frame back (all 20 save/restore
       insns + the giv slot then match) at the cost of the two counters sitting
       8 bytes high (5 insns).  The hole is a pseudo that reload gave a slot to
       and then rematerialised or deleted; no source form reproduces it (a
       pointer local with a constant equivalence — tried `wp`, `dirs` — is
       replaced by update_equiv_regs and leaves no slot, and expand-time slots
       always precede reload's, so a dead local can only pad at 0x58).
   F1  loop preheader order.  Original: [&tip][&dir][la mtx][giv init][age]
       [state][pt][cursor]; ours: [la mtx][age][state][&tip][&dir][giv init]
       [pt][cursor].  The original's age/state/pt come AFTER loop.c's hoisted
       invariants, i.e. they are loop-generated (givs off `slotAge[i]` /
       `slotState[i]`), not preheader statements.  Writing them as array givs
       does produce that order but costs more elsewhere (35 shape mismatches
       vs 26): the giv form loses `pt` its register and the arc-path block
       degrades.  9 insns.
   F1  arc-path table select: original holds the table base in v0 and the
       scaled index in v1 (mflo -> t0), ours the other way round (mflo -> a3),
       and the `la` of the long table sits before the subtract in the else arm.
       Statement order in both arms is already source-matched.  8 insns.
   F10 PlaySoundEffect arg block: original emits `li a2,4` first and the
       `sfxDone = 1` store last (reorg then eats it for the jal delay slot);
       ours emits the flag store early and `li a2,4` late.  5 insns.

   Everything else transcribes exactly, including the whole flame-breath half
   (129 insns byte-identical).  Levers that got it here: the alias blocks
   listed below, `i = 0` placed in the merge block so loop.c knows the biv's
   initial value (otherwise every giv init is computed generically), A142-style
   volatile on the three `pt[-0xf]` variant reads (without it cse folds them to
   absolute, `pt` drops to 3 refs and loses its register to the burst giv —
   measured with the §D 2c allocation probe: pt 9 refs/402 insns = 0.067 vs the
   giv 7/206 = 0.068), `&pt[i * 3]` for the trail cursor so its giv init comes
   out as `move s5,s7`, and per-arm SPAWN calls for the variant flag (a ternary
   if-converts to sltu).  Restore by renaming back to .c.

   2026-08-14-1 unattended permuter session (~15m, ~36900 iterations, timed out
   at the 15m budget): best score 655 vs first-iteration score 855. No
   byte-perfect candidate found; still PARKED (see above). */

/* 0x80048d10 (2248 bytes) — per-tick attack-effects driver, two independent
   subsystems sharing one function.  (1) Flame breath: while the breath timer
   runs, spawn one particle per frame at a random offset in Spyro's body frame
   and pulse the flame trail's RGBA (the alpha follows a sine, and blinks off
   for part of every 24-frame cycle once the timer is under 0x78).  (2) Horn
   strike: arm this frame's trail slots through the ring permutation, rebuild
   the anchor frame (either the body-frame matrix of the current anim frame's
   packed offset, or a static offset from the world position), then walk each
   of the 8 slots along its arc path — probing actors and world geometry
   between the previous and current point, freezing the slot and spawning the
   hit burst (plus one kick sfx per frame) on contact, or spawning the
   end-of-arc burst when the slot runs off the end of its path.  param steps =
   frame delta.  Clears g_bSpyroHornCollisionActive once all 8 slots are idle.
 */
/* NOTE: the function body below is decomp-permuter output, spliced in
   by the 2026-08-14-1 unattended permuter session for its PARTIAL-BYTE
   gain only. It reads worse than the hand-written form it replaced and
   its inline comments are lost. The hand-written original is recoverable
   with `git show HEAD:src/c/TickSpyroAttackEffects.c.wip`; this body came from
   build/permuter/nonmatchings/TickSpyroAttackEffects/output-655-1/source.c. */
void TickSpyroAttackEffects(int steps) {
  int flame[3];
  int anchor[3];
  int tip[3];
  int dir[3];
  int empty;
  int sfxDone;
  int pad[2];
  int *wp;
  unsigned char *seg;
  unsigned char *map;
  unsigned char *age;
  unsigned char *state;
  int *mtx;
  int *pt;
  int *cursor;
  int *amtx;
  int *rec;
  short *path;
  int count;
  int limit;
  int mask;
  int n;
  int i;
  empty = 0;
  sfxDone = 0;
  if (g_anSpyroFlameBreathTimerBlock[0] != 0) {
    flame[0] = (GetRandomU32() & 0x1ff) - 0x160;
    flame[1] = (GetRandomU32() & 0x7f) - 0x40;
    flame[2] = ((flame[0] >> 1) + (GetRandomU32() & 0x3f)) - 0x60;
    RotateVectorByMatrix(g_anSpyroBodyMtxBlock, flame, flame);
    AddVector(flame, flame, &g_anSpyroBodyMtxBlock[-13]);
    ((void (*)(int, int, int *, int *))g_pfnLevelOverlayParticleSpawn)(
        1, 0x1e, flame, 0);
    g_abSpyroFxParticleRgba[0] = 0x90;
    g_abSpyroFxParticleRgba[1] = 0x20;
    g_abSpyroFxParticleRgba[2] = 0x10;
    if ((g_anSpyroFlameBreathTimerBlock[0] < 0x78) &&
        ((g_anSpyroFlameBreathTimerBlock[0] % 24) >= 0xe)) {
      g_abSpyroFxParticleRgba[3] = 0;
    } else {
      g_abSpyroFxParticleRgba[3] =
          (LookupSine(g_nSpyroFlameBreathTimer << 7) / 256) - 0x28;
    }
    g_anSpyroFlameBreathTimerBlock[0] -= g_nFrameStep;
    if (g_anSpyroFlameBreathTimerBlock[0] <= 0) {
      g_anSpyroFlameBreathTimerBlock[0] = 0;
      g_abSpyroFxParticleRgba[3] = 0;
    }
  }
  if (g_bSpyroHornCollisionActive != 0) {
    wp = g_anSpyroWorldPos;
    if ((g_nSpyroAirborneFrames == 0) &&
        (g_abSpyroPersistentEulerBlock[1] >= 0x81)) {
      g_nCameraScriptStickRequestY =
          (0x100 - g_abSpyroPersistentEulerBlock[1]) * 8;
    } else {
      g_nCameraScriptStickRequestY = 0;
    }
    n = 0;
    if (steps > 0) {
      seg = g_abSpyroHornStrikeSegmentBlock;
      map = g_abSpyroHornStrikeSlotMap;
      do {
        if (seg[0] < 8) {
          g_abSpyroHornStrikeSlotAge[(map + (seg[2] * 8))[seg[0]]] = steps - n;
          g_abSpyroHornStrikeSlotEndAge[(map + (seg[2] * 8))[seg[0]]] = 0x20;
          g_abSpyroHornStrikeSlotState[(map + (seg[2] * 8))[seg[0]]] = 0;
        }
        seg[0]++;
      } while ((++n) < steps);
    }
    if (((g_bSpyroHornStrikeSegmentIdx < 0x1e) &&
         (((*((int *)(&g_bSpyroAnimPrev))) & 0xffff0000) == 0x07070000)) &&
        (D_80078A78 == 4)) {
      g_abSpyroAnimLayer1SubstepBlock[0] = 0;
    }
    if (g_abSpyroHornStrikeAnchorModeBlock[0] != 0) {
      g_abSpyroHornStrikeAnchorEuler[0] = g_abSpyroPersistentEulerBlock[0];
      g_abSpyroHornStrikeAnchorEuler[1] = g_abSpyroPersistentEulerBlock[1];
      g_abSpyroHornStrikeAnchorEuler[2] = g_abSpyroPersistentEulerBlock[2];
      CopyWords(&g_abSpyroHornStrikeAnchorModeBlock[0xa],
                &g_abSpyroPersistentEulerBlock[0x1bc], 0x14);
      rec = (int *)((g_bSpyroFramePrev * 4) +
                    (*((int *)(((g_bSpyroAnimPrev * 4) +
                                ((int)g_apActorMeshTable)) +
                               0x38))));
      n = ((int *)((rec[9] & 0x1fffff) * 2))[4];
      anchor[0] = n >> 21;
      anchor[1] = (n << 11) >> 21;
      anchor[2] = (n << 22) >> 21;
      RotateVectorByMatrix((int *)(&g_abSpyroPersistentEulerBlock[0x28]),
                           anchor, anchor);
      AddVector((int *)(&g_abSpyroHornStrikeAnchorModeBlock[-0x9a]), anchor,
                (int *)(&g_abSpyroPersistentEulerBlock[-0xc]));
      if (g_bSpyroHornStrikeSegmentIdx < 8) {
        CopyVector(anchor, &g_anSpyroHornStrikeWindupAnchorOffsets
                               [(g_bSpyroHornStrikeSegmentIdx >> 1) * 3]);
      } else {
        CopyVector(anchor, g_anSpyroHornStrikeFinalAnchorOffset);
      }
      amtx = g_anSpyroHornStrikeAnchorMtxBlock;
      RotateVectorByMatrix(amtx, anchor, anchor);
      AddVector(&amtx[-0x29], &amtx[-0x29], anchor);
      SubtractVector(&amtx[0xa], &amtx[-0x29], wp);
    } else {
      AddVector((int *)(&g_abSpyroHornStrikeAnchorModeBlock[-0x9a]), wp,
                (int *)(&g_abSpyroHornStrikeAnchorModeBlock[0x32]));
    }
    i = 0;
    mtx = g_anSpyroHornStrikeAnchorMtxBlock;
    age = (unsigned char *)(&mtx[-0x21]);
    state = (unsigned char *)(&mtx[-0x1d]);
    pt = &mtx[0xd];
    do {
      if ((*age) != 0) {
        if (i < 4) {
          count = 0x18;
          limit = 0x20;
        } else {
          count = 0x20;
          limit = 0x28;
        }
        if ((*state) != 0) {
          *age += steps;
        }
        if ((*age) >= limit) {
          *age = 0;
        } else if ((*state) != 2) {
          if (i < 4) {
            n = i * count;
            path = g_anSpyroHornStrikeArcPathsShort;
          } else {
            n = (i - 4) * count;
            path = g_anSpyroHornStrikeArcPathsLong;
          }
          path += n * 4;
          if ((*age) < (count - 1)) {
            SVectorToVector(tip, &path[((*age) + 1) * 4]);
            RotateVectorByMatrix(mtx, tip, tip);
            AddVector(tip, tip, &mtx[-0x29]);
            if ((*state) == 0) {
              CopyVector(dir, wp);
              *state = 1;
            } else {
              CopyVector(dir, &pt[i * 3]);
            }
            CopyVector(&pt[i * 3], tip);
            mask = 0x10000;
            if ((*((volatile int *)(&pt[-0xf]))) != 0) {
              mask = 0x90000;
            }
            if ((DispatchActorContactAtSphere(tip, 0xa0, 0, mask, 0, 0) != 0) ||
                (CastRayWorldAndActors(dir, tip) != 0)) {
              *state = 2;
              g_abSpyroHornStrikeSlotEndAge[i] = *age;
              dir[0] = -0x10;
              dir[1] = (GetRandomU32() & 0x1f) - 0x10;
              dir[2] = 0;
              RotateVectorByMatrix(&pt[-0xd], dir, dir);
              dir[2] = 0;
              ((void (*)(int, int, int *,
                         int *))g_pfnLevelOverlayParticleSpawn)(1, 1, tip, dir);
              if ((*((volatile int *)(&pt[-0xf]))) == 0) {
                ((void (*)(int, int, int *,
                           int *))g_pfnLevelOverlayParticleSpawn)(4, 0x4e, tip,
                                                                  0);
              }
              dir[0] = 0x30;
              dir[1] = 0;
              dir[2] = 0;
              ApplyActiveGteRotation(dir, dir);
              ((void (*)(int, int, int *,
                         int *))g_pfnLevelOverlayParticleSpawn)(
                  ((*((volatile int *)(&pt[-0xf]))) * 5) + 5, 0x4f, tip, dir);
              if (sfxDone == 0) {
                PlaySoundEffect(
                    *((unsigned char *)(((int)g_pLevelSampleBankHeader) +
                                        0x28)),
                    wp, 4, 0);
                sfxDone = 1;
              }
            }
          } else if ((count < (*age)) && ((count + steps) >= (*age))) {
            SVectorToVector(tip, &path[(count - 1) * 4]);
            RotateVectorByMatrix(mtx, tip, tip);
            AddVector(tip, tip, &mtx[-0x29]);
            ZeroVector(dir);
            if (g_nSpyroHornStrikeVariant != 0) {
              ((void (*)(int, int, int *,
                         int *))g_pfnLevelOverlayParticleSpawn)(1, 1, tip, dir);
            } else {
              ((void (*)(int, int, int *,
                         int *))g_pfnLevelOverlayParticleSpawn)(1, 0, tip, dir);
            }
            if (g_nSpyroHornStrikeVariant == 0) {
              ((void (*)(int, int, int *,
                         int *))g_pfnLevelOverlayParticleSpawn)(4, 0x4e, tip,
                                                                0);
            }
            ApplyActiveGteRotation(&g_anSpyroHornStrikeEndBurstDirs[i * 3],
                                   dir);
            ((void (*)(int, int, int *, int *))g_pfnLevelOverlayParticleSpawn)(
                (g_nSpyroHornStrikeVariant * 5) + 5, 0x4f, tip, dir);
          }
        }
      } else {
        empty++;
      }
      age++;
      state++;
    } while ((++i) < 8);
    if (empty == 8) {
      g_bSpyroHornCollisionActive = 0;
    }
  }
}
