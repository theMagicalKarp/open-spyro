#include "globals.h"

extern void SetSpuDmaReadStateBits(void);
extern void SetSpuDmaWriteStateBits(void);

extern char *D_80073554;          /* SPU hardware register block base */
extern volatile int *D_80073558;  /* SPU DMA channel MADR register */
extern volatile int *D_8007355C;  /* SPU DMA channel BCR register */
extern volatile int *D_80073560;  /* SPU DMA channel CHCR register */
extern unsigned short D_8007356C; /* encoded SPU transfer address shadow */

/* gcc 2.7.2 stdarg (no system headers in this build): the `...` in the
   signature triggers the register-save prologue; va_arg is the standard
   pointer-bump expansion. */
#define VA_START(ap, last) ((ap) = (char *)__builtin_next_arg(last))
#define VA_ARG_U32(ap) ((ap) += 4, *(unsigned int *)((ap) - 4))

/* 0x8005c1c0 (656 bytes) — SPU DMA transfer controller. op 2 (addr) stamps the
   encoded transfer address into the SPU address register (+0x1a6); op 1 / op 0
   wait for that register to settle, then set the SPUCNT (+0x1aa) transfer-mode
   bits (write 0x20 / read 0x30) and the pending-direction flag; op 3
   (madr, size) waits for the mode bits, fires the direction's state-bit
   callback, then kicks the DMA channel through the MADR/BCR/CHCR shadows.
   Returns -2 if any wait spins past 0xF00 iterations, else 0.

   PARKED 2026-08-15 — re-derived from the asm (the 2026-07-25 permuter body is
   gone). 162/164 insns; the whole case-3 tail from the SetSpuDma*StateBits call
   pair to the epilogue is insn-for-insn exact, and the `break` + one shared
   trailing `return 0` is what puts `move v0,zero` AFTER the CHCR store (reorg
   then steals a copy of it into each arm's `j` delay slot — A186).

   Residue #1 (the 2 missing insns, now a WALL — see §B22): the original masks
   the ENTRY wait-test read in cases 1 and 0 with `andi v0,v0,0xFFFF` after an
   `lhu`, and the loop's re-read is NOT masked. gcc 2.7.2's combine always
   deletes a redundant 0xFFFF mask on a zero-extending load whose def has ONE
   use. Measured over 20 source forms in three probe batches (2026-08-15), all
   folded: explicit `& 0xFFFF`, `(unsigned short)` cast on either operand,
   `unsigned short` local (PROMOTE_MODE ⇒ no AND at all), signed `lh` + unsigned
   cast, non-volatile load, `(c ^ t) & 0xFFFF`, guard+do/while vs while-form,
   two defs of `cur`, a 16-bit bitfield in an int container (both halves), a
   `volatile unsigned short : 16` struct field, and a volatile-declared HW
   global. Making the intervening `g_nSpuPendingDmaDirection` store volatile
   does NOT block it either (tried via an allow_duplicated alias; `can_combine_p`
   only scans for intervening volatiles when the SOURCE is volatile-and-asm-ish,
   not here). The ONLY thing that keeps the mask is a second use of the loaded
   pseudo (probe v3) — and the original's data flow has none to give, so any
   spelling that reaches it costs +1 insn elsewhere. Not a permuter target.

   Residue #2: a whole-function caller-saved rotation that rides on #1 —
   hoisted constant 1 in a2 (ours v1, shared with the counter), base/target a1/a0
   (ours a0/a1) in cases 1 and 0, want/base a0/a1 (ours a1/a0) in case 3.
   Residue #3: in the case-3 kick block the original fills the `lw size` load
   bubble with the D_80073558 pointer load and sinks the g_dwSpuDmaMadrShadow
   reload down to the sltu/addu pair; ours does the reverse (2 insns, A164
   straggler order). */
int ControlSpuDmaTransfer(int op, ...) {
  char *ap;
  char *base;
  int cur;
  int target;
  unsigned short want;
  unsigned int n;
  unsigned int size;
  unsigned int blocks;
  unsigned int frac;
  int cmd;

  VA_START(ap, op);
  (void)(&op);

  switch (op) {
  case 2:
    cur = VA_ARG_U32(ap) >> g_nSpuAddrShift;
    base = D_80073554;
    D_8007356C = cur;
    *(volatile short *)(base + 0x1A6) = cur;
    break;

  case 1:
    base = D_80073554;
    target = D_8007356C;
    cur = *(volatile unsigned short *)(base + 0x1A6);
    g_nSpuPendingDmaDirection = 0;
    if ((unsigned short)cur != target) {
      n = 0;
      do {
        n += 1;
        if (n >= 0xF01) {
          return -2;
        }
        cur = *(volatile unsigned short *)(base + 0x1A6);
      } while (cur != target);
    }
    base = D_80073554;
    cur = *(volatile unsigned short *)(base + 0x1AA);
    *(volatile unsigned short *)(base + 0x1AA) = (cur & 0xFFCF) | 0x20;
    break;

  case 0:
    base = D_80073554;
    target = D_8007356C;
    cur = *(volatile unsigned short *)(base + 0x1A6);
    g_nSpuPendingDmaDirection = 1;
    if ((unsigned short)cur != target) {
      n = 0;
      do {
        n += 1;
        if (n >= 0xF01) {
          return -2;
        }
        cur = *(volatile unsigned short *)(base + 0x1A6);
      } while (cur != target);
    }
    base = D_80073554;
    cur = *(volatile unsigned short *)(base + 0x1AA);
    *(volatile unsigned short *)(base + 0x1AA) = cur | 0x30;
    break;

  case 3:
    want = 0x20;
    if (g_nSpuPendingDmaDirection == 1) {
      want = 0x30;
    }
    base = D_80073554;
    n = 0;
    while ((*(volatile unsigned short *)(base + 0x1AA) & 0x30) != want) {
      n += 1;
      if (n >= 0xF01) {
        return -2;
      }
    }

    if (g_nSpuPendingDmaDirection == 1) {
      SetSpuDmaReadStateBits();
    } else {
      SetSpuDmaWriteStateBits();
    }
    cmd = 0x1000201;
    g_dwSpuDmaMadrShadow = VA_ARG_U32(ap);
    size = VA_ARG_U32(ap);
    blocks = size >> 6;
    frac = (size & 0x3F) != 0;
    g_nSpuDmaBcrBlockCount = blocks + frac;
    *D_80073558 = *(volatile unsigned int *)(&g_dwSpuDmaMadrShadow);
    *D_8007355C = ((*(volatile int *)(&g_nSpuDmaBcrBlockCount)) << 16) | 0x10;
    if (g_nSpuPendingDmaDirection == 1) {
      cmd = 0x1000200;
    }
    *D_80073560 = cmd;
    break;
  }

  return 0;
}
