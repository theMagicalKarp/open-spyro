#include "globals.h"

typedef struct ActorSlot {
  unsigned char b[0x58];
} ActorSlot;

/* Test whether an actor is one of the "running kill" set and fully faded in
   (0x80038494): its slot index in the actor pool selects a bit in
   g_anRunningKillBitmap, and the actor only counts when its +0x53 byte has
   reached 0xFF. */
int func_80038494(unsigned char *actor) {
  int idx = (ActorSlot *)actor - (ActorSlot *)g_pActorListBase;
  int hit = 0;

  {
    int t = g_anRunningKillBitmap[idx >> 5] & (1 << (idx & 0x1F));
    if (t != 0) {
      hit = actor[0x53] == 0xFF;
    }
  }
  return hit;
}

/* PARKED at 2/34 (length-exact, 34/34; was the 2026-07-05 "F1 one-register
   cascade (ptr a2 vs a1)" park, re-attempted 2026-08-10-2 and re-classed).

   Solved here:
     * the index is a plain pointer subtraction over 0x58-byte slots — gcc
       expands the exact division as the shift/add chain times inv(11) with the
       >>3 after it, which is the whole `sll/subu/sll/addu/...` block;
     * the bit test must be assigned to a VALUE temp (`int t = word & mask; if
       (t != 0)`). Written directly as a condition, fold rewrites
       `(x & (1 << b)) != 0` into `(x >> b) & 1` and emits `srav` with the
       UNMASKED index (MIPS shifts mod 32), which also flips the v0/v1 parity of
       the whole multiply chain (29/34).

   Residue (F2): the two index insns `andi a0,a0,0x1f` (bit) and
   `sll v1,v1,0x2` (bitmap byte offset) are independent and come out in the
   opposite order; the `sll` feeds a `lw`, so its sched1 path is one longer.
   Source order does NOT move it — bit-first, word-first, and split-local forms
   all give byte-identical output. Needs a lever that changes the path length,
   not the statement order. */
