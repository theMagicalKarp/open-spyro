   optionally aborts an in-flight read (CdlPause + CdlSetloc) on the retry path,
   re-issues CdlSetmode, installs the sector-ready callback, then kicks CdlReadN
   via CdControlForce. On an open shell it reports and bails. Returns the busy
   flag D_8007515C (-1 on failure). (0x80065dbc, 532 bytes.) */
int CdReadStart(int param_1) {
  unsigned char sp10;
  int cfg;

  CdSyncCallback(0);
  CdReadyCallback(0);
  if (D_80075178[0] & 1) {
    FUN_80064050(0);
  }
  if (CdStatus() & 0x10) {
    if ((VSync(-1) & 0x3f) == 0) {
      WriteString(D_80011F28);
    }
    CdControlForce(1, 0);
    D_80075164 = VSync(-1);
    D_8007515C = -1;
  } else {
    if (param_1 != 0) {
      WriteString(D_80011F40);
      CdControl(9, 0, 0);
      if (CdControl(2, CdLastPos(), 0) == 0) {
        D_8007515C = -1;
        return D_8007515C;
      }
    }
    FUN_80063b38();
    sp10 = (unsigned char)D_80075154;
    cfg = D_80075154 & 0xff;
    if (((cfg == FUN_80063a9c()) && (param_1 == 0)) ||
        (CdControl(0xe, &sp10, 0) != 0)) {
      D_80075168 = CdPosToInt(CdLastPos());
      CdReadyCallback(D_800659F0);
      if (D_80075178[0] & 1) {
        FUN_80064050(&D_80065CC0);
      }
      D_80075150 = D_8007514C;
      CdControlForce(6, 0);
      D_8007515C = D_80075148;
      D_80075160 = VSync(-1);
    } else {
      D_8007515C = -1;
    }
  }
  return D_8007515C;
}

