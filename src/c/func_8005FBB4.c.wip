#include "globals.h"

extern char D_800118CC[];
extern char D_80074B20[];

/* PARKED: 76.1% match (11/46 differ), correct logic and length. Fixed via
   this session: (1) declare `n` (arg1/count) before `p` (arg0/pointer) to
   get the desired s0=p/s1=n callee-save mapping; (2) write the merged store
   as `(next & mask) | (*p & himask)` (mask-term first) to get the original's
   v1/a1/ori-a1/a2 constant-materialization order instead of a2-then-a1.
   Residue: inside the loop body, gcc always allocates v0="next"/v1="old
   word"/a0=scratch; original uses a0="next"/v0="old word"/v1=scratch — a
   full 3-register relabeling that no local reordering, temp naming, or
   type change (pointer vs plain uint) shifted. Same "whole-block regalloc
   tie" class as cookbook §H; permuter-or-never. */
/* 0x8005fbb4: links a run of `count` 4-byte GPU packet tags into an OT chain
   (word = (tag_byte<<24) | next_addr), terminating the chain at the fixed
   address D_80074B20. Debug-traces via g_pfnGpuDebugPrintf when
   g_bGpuDebugLevel >= 2. Returns the last linked packet. */
unsigned int *func_8005FBB4(unsigned int *arg0, int arg1) {
  int n = arg1;
  unsigned int *p = arg0;

  if ((unsigned char)g_bGpuDebugLevel >= 2) {
    ((void (*)(char *, unsigned int *, int))g_pfnGpuDebugPrintf)(D_800118CC, p,
                                                                 n);
  }
  n = n - 1;
  if (n != 0) {
    do {
      unsigned int next;
      unsigned int old;
      n -= 1;
      next = (unsigned int)p + 4;
      *((unsigned char *)p + 3) = 0;
      old = *p;
      *p = (next & 0xFFFFFF) | (old & 0xFF000000);
      p = (unsigned int *)next;
    } while (n != 0);
  }
  *p = (unsigned int)D_80074B20 & 0xFFFFFF;
  return p;
}
