#include "globals.h"

/* held-base view of g_nSpyroSpeedTarget (0x80078b20): [0] is the target,
   [0x14] (+0x50) is g_nSpyroMotionSpeed. */
extern int g_anSpyroSpeedBlock[];

/* PARKED 2026-08-15 at 21/19 insns (2 over, so it does not link) — a fresh
   decode, and the §B7 "shared-base, multiple offsets, NO call" wall is now
   HALF retired. With the alias reached as an INCOMPLETE int array (no pointer
   local) plus an empty `do { } while (0);` after the first access, both arm
   stores come out `sw v1,0x50(a3)` like the original; only the post-join clamp
   store still folds to `lui $at; sw %lo(sym+0x50)($at)` (+1), and a fresh
   destination local for the stepped speed (A167) fills the branch delay slot
   but costs a `move a3,a0` param copy (+1). Levers already ruled out here:
   pointer local for the whole block (reload's update_equiv_regs substitutes
   its REG_EQUIV constant function-globally — no cse barrier reaches it), a
   sized alias (A22), a second break before or inside the clamp `if`, a
   pointer local scoped to the clamp arm, and declaration-order permutation.
   Next idea: the clamp store is a JOIN block; find a form where the base is
   re-referenced there (B-i rule 3 wants ~9 refs to keep a base register).

   0x8003d92c (76 bytes) — move the motion speed one substep toward the target:
   accelerate by `accel` while under it, decelerate by `decel` while over it,
   and clamp to the target on the step that crosses it. */
void AdvanceSpyroSpeedTowardTarget(int accel, int decel) {
  int stepped;
  int crossed;
  int target;
  int speed;

  target = g_anSpyroSpeedBlock[0];
  do {
  } while (0);
  speed = g_anSpyroSpeedBlock[0x14];
  if (speed < target) {
    stepped = speed + accel;
    g_anSpyroSpeedBlock[0x14] = stepped;
    crossed = target < stepped;
  } else {
    stepped = speed - decel;
    g_anSpyroSpeedBlock[0x14] = stepped;
    crossed = stepped < target;
  }
  if (crossed) {
    int *q = g_anSpyroSpeedBlock;
    q[0x14] = target;
  }
}
