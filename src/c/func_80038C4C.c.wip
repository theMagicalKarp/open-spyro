#include "globals.h"

extern void SubtractVector(int *dst, int *a, int *b);
extern int abs(int n);

extern short g_anCosineLut[];

/* 0x80038c4c (0x108) — rotate the XY delta between `pos` and record `rec`
   into the record's frame using its yaw angle (+0x14, sine-LUT index), and
   return whether the rotated point lies inside the record's box extents
   (+0xC half-width, +0x10 half-depth). The rotated |x|/|y| pair is also
   written to a scratch pair (never read back). */
int func_80038C4C(int *pos, int *rec) {
  volatile int out[4];
  int delta[3];
  short *cosp;
  short *sinp;
  int angle;
  int dx;
  int dy;
  int rx;
  int ry;
  int ay;

  angle = rec[5];
  SubtractVector(delta, pos, rec);
  cosp = &g_anCosineLut[angle];
  sinp = &g_anSineLut[angle];
  dx = delta[0];
  dy = delta[1];

  rx = ((dx * *cosp) >> 12) - ((dy * *sinp) >> 12);
  out[0] = rx;
  ry = ((dx * *sinp) >> 12) + ((dy * *cosp) >> 12);
  rx = abs(rx);
  out[0] = rx;
  ay = abs(ry);
  out[1] = ry;
  out[1] = ay;

  if (rx < rec[3]) {
    return ay < rec[4];
  }
  return 0;
}

/* PARKED 2026-07-09 at 90.9% (66 insns, 6 differ — pure register renaming).
   Hard-won structure, all byte-exact: volatile out[4] keeps both dead stores
   per slot; abs() (not if/ternary) expands via single-insn abssi2 so the ry
   mult pipeline interleaves across the x-abs + store; ry statement placed
   between out[0] stores; early-return tail absorbs ret0 into the beqz delay;
   g_anCosineLut alias (sym at lut+0x80) stops cse deriving the sine base via
   addiu -0x80. Residue: ay in v1 (ours) vs a1 (original) + the two limit
   scratches shifted (v0/v0 vs v1/v0). dy-reuse and lim-birth-order both
   cascade worse. Single-decision local-alloc tie; permuter candidate.

   2026-07-25-1 unattended permuter session (~15m, ~78200 iterations, timed out
   at the 15m budget): base score 35 — the LOWEST base of the whole sweep — but
   best score also 35, i.e. the randomizer never found a single improving
   candidate (2 output dirs). The remaining ay v1-vs-a1 register tie appears to
   be isolated from anything source mutation perturbs: everything the permuter
   touches makes it worse, nothing makes it better. Still PARKED.

   2026-08-11: also tried a fresh local for the x-abs (`ax = abs(rx)` instead of
   reusing `rx`, which makes `rx` single-death and local-allocable) — BYTE-
   IDENTICAL, so the rx quantity split does not reach the ay tie. The three
   overlapping short quantities are ay, rec[3] and rec[4]: the original gets
   rec[3]->v1, rec[4]->v0, ay->a1, ours rec[3]/rec[4]->v0 and ay->v1, i.e. ours
   lets the two limit loads share v0 where the original does not.

   2026-08-31 — THE TIE IS THREE-WAY AND ITS GATE IS HARD-REG $2, NOT `ay`.
   `cc1 -dl` says `ay` is reg 81, "3 times across 7 insns" with NO block tag,
   i.e. it is already a GLOBAL allocno (it spans the `beqz`), so it is assigned
   AFTER local-alloc — and local-alloc has by then given rec[3] (2 refs/2 insns,
   block 0) and rec[4] (2/2, block 2) the SAME register, $v0, because the two
   are in different blocks and do not conflict.  `ay` then takes the lowest
   register left over its range, $v1.  For the original's map (rec[3] $v1,
   rec[4] $v0, ay $a1) local-alloc has to find $v0 UNAVAILABLE to rec[3], and
   the only thing in this function that can occupy $v0 there is the return
   value: `return 0;` expands straight into hard reg $2, so its live range
   starts at whatever position sched1 leaves the `move v0,zero` in.  So the
   objective is "make $2 live across the rec[3] load", not "re-rank ay".
   Measured and rejected 2026-08-31: routing the result through a pseudo
   (`r = 0; if (...) r = ay < rec[4]; return r;` and the if/else form) both
   LINKFAIL — the pseudo costs a `move` that the two-exit form does not; and
   re-using a dead local as the limit carrier to push it into global_alloc
   (`dx = rec[3]` 6/66 unchanged, `dy = rec[3]` 14, `dx = rec[4]` 7).
*/
