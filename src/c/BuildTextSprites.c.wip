#include "globals.h"

extern void FillWord(void *dst, unsigned int value, int byte_count);
extern void CopyVector(int *dst, int *src);

/* Read g_pSpriteRecordWriteCursor volatile-ly: the original re-loads the queue
   tail from the global at nearly every field access (no held base). */
#define CURSOR (*(void *volatile *)&g_pSpriteRecordWriteCursor)

/* Emit a glyph-sprite chain for a UI string, tracking per-glyph kerning: per
   non-space byte allocate a 0x58-byte SPRT slot at g_pSpriteRecordWriteCursor
   (queue tail, grows down), copy the pen from *param_2, map the byte to a font
   tile ('0'-'9', 'A'-'Z', and specials '!',',','?','.') and advance the pen by
   the digit-advance param_4 after digits / '!'/'?', else by the glyph width
   param_3->unk0. Spaces advance the pen by 3/4 of the glyph width.
   (0x800181ac, 0x2a0 bytes.) */
void *BuildTextSprites(unsigned char *param_1, int *param_2, int *param_3,
                       int param_4, int param_5) {
  unsigned char bVar1;
  int iVar1;
  int ch;
  int flag;

  bVar1 = *param_1;
  flag = 1;
  while (bVar1 != 0) {
    if ((bVar1 & 0xFF) != 0x20) {
      void *rec = (void *)((int)CURSOR - 0x58);
      CURSOR = rec;
      FillWord(rec, 0, 0x58);
      CopyVector((int *)((int)CURSOR + 0xc), param_2);
      bVar1 = *param_1;
      if (bVar1 == 0x21 || bVar1 == 0x3f) {
        flag = 1;
      }
      if (flag == 0) {
        void *r = CURSOR;
        *(int *)((int)r + 0x10) = *(int *)((int)r + 0x10) + param_3[1];
        *(int *)((int)r + 0x14) = param_3[2];
      }
      ch = *param_1;
      if ((unsigned int)(ch - 0x30) < 10) {
        *(unsigned short *)((int)CURSOR + 0x36) = ch + 0xd4;
      } else if ((unsigned int)(ch - 0x41) < 0x1a) {
        *(unsigned short *)((int)CURSOR + 0x36) = ch + 0x169;
      } else if ((ch & 0xFF) == 0x21) {
        *(unsigned short *)((int)CURSOR + 0x36) = 0x4b;
      } else if ((ch & 0xFF) == 0x2c) {
        *(unsigned short *)((int)CURSOR + 0x36) = 0x4c;
      } else if ((ch & 0xFF) == 0x3f) {
        *(unsigned short *)((int)CURSOR + 0x36) = 0x116;
      } else if ((ch & 0xFF) == 0x2e) {
        *(unsigned short *)((int)CURSOR + 0x36) = 0x147;
      } else {
        void *r = CURSOR;
        *(unsigned short *)((int)r + 0x36) = 0x4c;
        *(int *)((int)r + 0x10) =
            *(int *)((int)r + 0x10) - (param_3[0] * 2) / 3;
      }
      *(unsigned char *)((int)CURSOR + 0x47) = 0x7f;
      *(unsigned char *)((int)CURSOR + 0x4f) = param_5;
      *(unsigned char *)((int)CURSOR + 0x50) = 0xff;
      if (flag != 0) {
        iVar1 = *param_2 + param_4;
      } else {
        iVar1 = *param_2 + param_3[0];
      }
      *param_2 = iVar1;
      flag = (unsigned int)(*param_1 - 0x30) < 10;
    } else {
      iVar1 = param_3[0] * 3;
      flag = 1;
      if (iVar1 < 0) {
        iVar1 += 3;
      }
      *param_2 += iVar1 >> 2;
    }
    param_1 += 1;
    bVar1 = *param_1;
  }
  return CURSOR;
}

/* PARKED at 137/168 (81.5%), LENGTH-EXACT (168/168). Sibling of the parked
   BuildTextSpriteChain. Logic verified. Residue is a triple backend tie that no
   source form dislodged:
     (1) F1/F7 live-length inversion: param_2 and `flag` both have 6 refs / size
         1, so allocno_compare priority = 2*6/live_length decides purely on live
         range. gcc gives `flag`->s0 (shorter range), param_2->s2; the original
         gives param_2->s0, flag->s2. param_1->s1 WAS fixed by mirroring the
         original's shared pen store (both advance arms compute into one temp,
         one `*param_2 =` after) instead of a per-arm store. Advance-arm invert,
         ch/iVar1 split, and shared-store all tried; the s0/s2 pair won't flip.
     (2) F8 andi placement: the special-ladder `(ch & 0xFF)` mask lands one
         call-group early (letter-fail slot) vs the original's slot at the '!'
         compare. Declaring the classification char as a fresh `int ch` (not the
         `unsigned char` loop var) was REQUIRED to keep digit/letter on the raw
         char (`addiu v0,a0,-0x30`) and confine the andi to the ladder — a u8
         var makes gcc CSE-hoist the QImode->SImode extend into the digit check.
     (3) F8 FillWord a2=0x58 delay-slot: the original leaves the post-`lw a0`
         load-delay a nop and fills the `jal FillWord` slot with `li a2,0x58`;
         our sched2 fills the load-delay with the a2 li and nops the jal slot.
   Permuter candidate (§E main recipe): pure regalloc+schedule, length-exact. */
