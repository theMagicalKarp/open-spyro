#include "globals.h"

extern void FillWord(void *dst, unsigned int value, int byte_count);
extern void CopyVector(int *dst, int *src);

/* Read g_pSpriteRecordWriteCursor volatile-ly: the original re-loads the queue
   tail from the global at nearly every field access (no held base). */
#define CURSOR (*(void *volatile *)&g_pSpriteRecordWriteCursor)

/* Emit a glyph-sprite chain for a UI string, tracking per-glyph kerning: per
   non-space byte allocate a 0x58-byte SPRT slot at g_pSpriteRecordWriteCursor
   (queue tail, grows down), copy the pen from *param_2, map the byte to a font
   tile ('0'-'9', 'A'-'Z', and specials '!',',','?','.') and advance the pen by
   the digit-advance param_4 after digits / '!'/'?', else by the glyph width
   param_3->unk0. Spaces advance the pen by 3/4 of the glyph width.
   (0x800181ac, 0x2a0 bytes.) */
/* NOTE: the body below started as decomp-permuter output from the 2026-07-25
   sweep; the 2026-08-30-1 session rewrote the loop tail by hand (see the
   post-mortem at the bottom). Original hand-written body:
   git show 2d31462:src/c/BuildTextSprites.c.wip */

void *BuildTextSprites(unsigned char *param_1, int *param_2, int *param_3,
                       int param_4, int param_5) {
  unsigned char bVar1;
  int iVar1;
  int ch;
  int flag;
  bVar1 = *param_1;
  flag = 1;
  while (bVar1 != 0) {
    if ((bVar1 & 0xFF) != 0x20) {
      void *rec =
          (void *)(((int)(*((void *volatile *)(&g_pSpriteRecordWriteCursor)))) -
                   0x58);
      *((void *volatile *)(&g_pSpriteRecordWriteCursor)) = rec;
      FillWord(rec, 0, 0x58);
      CopyVector(
          (int *)(((int)(*((void *volatile *)(&g_pSpriteRecordWriteCursor)))) +
                  0xc),
          param_2);
      bVar1 = *param_1;
      if ((bVar1 == 0x21) || (bVar1 == 0x3f)) {
        flag = 1;
      }
      if (flag == 0) {
        void *r = *((void *volatile *)(&g_pSpriteRecordWriteCursor));
        *((int *)(((int)r) + 0x10)) =
            (*((int *)(((int)r) + 0x10))) + param_3[1];
        *((int *)(((int)r) + 0x14)) = param_3[2];
      }
      ch = *param_1;
      if (((unsigned int)(ch - 0x30)) < 10) {
        *((unsigned short *)(((int)(*(&g_pSpriteRecordWriteCursor))) + 0x36)) =
            ch + 0xd4;
      } else if (((unsigned int)(ch - 0x41)) < 0x1a) {
        *((unsigned short
               *)(((int)(*((void *volatile *)(&g_pSpriteRecordWriteCursor)))) +
                  0x36)) = ch + 0x169;
      } else if ((ch & 0xFF) == 0x21) {
        *((unsigned short
               *)(((int)(*((void *volatile *)(&g_pSpriteRecordWriteCursor)))) +
                  0x36)) = 0x4b;
      } else if ((ch & 0xFF) == 0x2c) {
        *((unsigned short
               *)(((int)(*((void *volatile *)(&g_pSpriteRecordWriteCursor)))) +
                  0x36)) = 0x4c;
      } else if ((ch & 0xFF) == 0x3f) {
        *((unsigned short
               *)(((int)(*((void *volatile *)(&g_pSpriteRecordWriteCursor)))) +
                  0x36)) = 0x116;
      } else if ((ch & 0xFF) == 0x2e) {
        *((unsigned short
               *)(((int)(*((void *volatile *)(&g_pSpriteRecordWriteCursor)))) +
                  0x36)) = 0x147;
      } else {
        void *r = *((void *volatile *)(&g_pSpriteRecordWriteCursor));
        *((unsigned short *)(((int)r) + 0x36)) = 0x4c;
        *((int *)(((int)r) + 0x10)) =
            (*((int *)(((int)r) + 0x10))) - ((param_3[0] * 2) / 3);
      }
      *((unsigned char
             *)(((int)(*((void *volatile *)(&g_pSpriteRecordWriteCursor)))) +
                0x47)) = 0x7f;
      *((unsigned char
             *)(((int)(*((void *volatile *)(&g_pSpriteRecordWriteCursor)))) +
                0x4f)) = param_5;
      *((unsigned char
             *)(((int)(*((void *volatile *)(&g_pSpriteRecordWriteCursor)))) +
                0x50)) = 0xff;
      if (flag != 0) {
        int adv = (*param_2) + param_4;
        do {
          do {
            do {
              do {
                do {
                  do {
                    *param_2 = adv;
                  } while (0);
                } while (0);
              } while (0);
            } while (0);
          } while (0);
        } while (0);
      } else {
        int adv = (*param_2) + param_3[0];
        do {
          do {
            do {
              do {
                do {
                  do {
                    *param_2 = adv;
                  } while (0);
                } while (0);
              } while (0);
            } while (0);
          } while (0);
        } while (0);
      }
      {
        int t = (*param_1) - 0x30;
        flag = ((unsigned int)t) < 10;
      }
    } else {
      iVar1 = param_3[0] * 3;
      flag = 1;
      if (iVar1 < 0) {
        iVar1 += 3;
      }
      *param_2 += iVar1 >> 2;
    }
    do {
      do {
        param_1 += 1;
      } while (0);
    } while (0);
    bVar1 = *param_1;
  }

  return *((void *volatile *)(&g_pSpriteRecordWriteCursor));
}

/* PARKED at 161/168 (95.8%), LENGTH-EXACT (168/168) -- was 137/168 (26 diffs)
   until 2026-08-30-1, which closed three of the four recorded residues.
   Sibling of the parked BuildTextSpriteChain. Logic verified.

   SOLVED 2026-08-30-1 (a) THE s0/s2 INVERSION (residue 1 below, ~15 insns) IS
   AN A238 REF DIAL, and the dial is TWO nests, not one. The old note said
   param_2 and `flag` "both have 6 refs" and called it an unbreakable
   live-length tie; the real numbers off `cc1 -dg` are three-way, because
   param_1 sits between them:
       80 (flag)    15 refs / 109 insns -> floor_log2(15)*15*4/109 = 1.65
       72 (param_1) 14 refs / 118       -> 1.42
       73 (param_2) 13 refs / 118       -> 1.32
   global.c hands out registers in numeric order, so that allocation order is
   exactly flag->s0, param_1->s1, param_2->s2 and the original wants
   param_2->s0, param_1->s1, flag->s2. BOTH params therefore have to be lifted
   over `flag`, and floor_log2 is a step function (14 -> 15 refs barely moves
   the number, 15 -> 16 doubles it), so param_1's target is 16 and param_2 then
   has to clear param_1's new 2.169. In this loop a reference costs 2 (flow.c
   weights REG_N_REFS by loop depth), so the dial is:
       `param_1 += 1;`      wrapped in a 2-deep do/while(0) nest  (+2 -> 16)
       `*param_2 = adv;`    wrapped in a 6-deep nest              (+6 -> 19,
                            which is the first depth that clears param_1 --
                            5 leaves the two tied and the lower allocno,
                            param_1, wins)
   Measured: depth 5 = param_1 s0, depth 6/7 = param_2 s0. The nest SITE does
   not matter (the `flag != 0` arm's read gives the identical 14/168); the
   space arm's `*param_2 += ...` does not work because it carries two refs, so
   its depths land on the wrong parity.
   (b) THE PEN-ADVANCE v0/v1 ROTATION (5 insns) is A201: write `*param_2 = adv;`
   ONCE PER ARM with a block-scoped `int adv` in each, and let jump.c cross-jump
   the two stores back together. The shared `iVar1` carrier made it a global
   allocno that could only reach v1; per-arm block-scoped temps are local qtys
   and take v0. A single block-scoped temp around the whole if/else is only
   half the win (12/168 vs 9/168).
   (c) THE `flag = (unsigned)(*param_1 - 0x30) < 10;` PAIR (2 insns) wants its
   subtraction in a BLOCK-SCOPED temp: `{ int t = (*param_1) - 0x30;
   flag = ((unsigned int)t) < 10; }`. Reusing `ch` or `iVar1` as the temp is
   byte-identical to no temp at all (the intermediate coalesces into flag's s2);
   only a fresh block-scoped pseudo gets its own v0.

   RESIDUE (7 insns, two clusters, both F8 delay-slot fills):
   R1 (2) `li a2,0x58` for FillWord: the original leaves the post-`lw a0`
      load-delay a nop and puts the `li` in the `jal` delay slot; our sched2
      fills the load-delay hole with it and nops the jal slot. The `li` is a
      dep-free priority-1 straggler with no in-block call ahead of it, so there
      is nothing to raise its priority with. Every A200/A232 barrier around the
      call or the cursor store costs an insn and will not link.
   R2 (5) the special-ladder `andi v1,ch,0xff`: reorg steals it from the head of
      the ladder into the letter-test's `beqz` delay slot, where the original
      instead takes `addiu v0,a0,361` from the fall-through arm. The two builds
      are INSTRUCTION-IDENTICAL either side of this branch -- it is purely
      reorg's fill_eager_delay_slots choosing the taken thread where the
      original chose the fall-through -- so this is not a CSE-placement problem
      and the old note's reading ("the mask lands one call-group early") is
      about the symptom. Measured inert: restructuring the ladder into a nested
      block with its own `int m = ch & 0xFF;` (9), and an A200 barrier before
      that mask at depths 1 and 2 (9).

   For the record, the FOUR residues this park carried before this session, and
   which of them survive:
     (1) F1/F7 param_2<->flag live-length inversion -- SOLVED, see (a).
     (2) F8 andi placement -- survives as R2 (re-diagnosed: it is reorg, not
         scheduling).
     (3) F8 FillWord a2=0x58 delay-slot -- survives as R1.
     (4) the pen-advance rotation and the digit-flag pair -- SOLVED, see (b)/(c).
   `param_1->s1` is still owed to mirroring the original's shared pen store, and
   the `int ch` classification reload is still REQUIRED (A115): making it the
   `unsigned char` loop var makes gcc CSE-hoist the QImode->SImode extend into
   the digit check.

   2026-07-25-1 unattended permuter session (~15m, ~57700 iterations, timed out
   at the 15m budget): best score 360 vs base score 565. No byte-perfect
   candidate found; still PARKED (see above). */
