#include "globals.h"

extern void RotateVectorByMatrix();
extern void AddVector(int *dst, int *a, int *b);
extern void CopyVector(int *dst, int *src);
extern int FindGroundHeightBelow(int *pt, int range);

/* shared-base view of g_anSpyroBodyMtx (0x80078a8c): matrix call arg and
   -0x34 g_anSpyroWorldPos AddVector arg share one register. */
extern unsigned char g_anSpyroBodyMtxBlock[];
/* shared-base view of g_nSpyroShadowRingIndex (0x8007aa30): the index RMW
   plus the -0x18 no-ground-flag / -0x20 height ring byte arrays. */
extern int g_anSpyroShadowRingIndexBlock[];

/* 0x80049fac (596 bytes) — per-tick Spyro shadow-ring sampler. Computes the
   shadow center ((0,0,-0x164) through the body matrix + world pos) into
   g_anSpyroShadowPos with Z = ground height, refreshes the shadow OT-bin
   biases and hidden flag, then advances the 8-slot ring index and probes ONE
   ring vertex: ground within +/-0x80 of the probe Z stores the scaled height
   (diff * 0xC2 / 0x200), else sets the no-ground flag. probe == 0 clears
   both slots without sampling. Consumed by DrawSpyroDropShadow. */
void SampleSpyroShadowRingHeights(int probe) {
  int v[3];
  unsigned char *mtx;
  int *ring;
  int gz;
  int idx;
  int ground;
  char *flags;
  char *heights;
  int d;

  mtx = g_anSpyroBodyMtxBlock;
  v[0] = 0;
  v[1] = 0;
  v[2] = -0x164;
  RotateVectorByMatrix(mtx, v, v);
  AddVector(v, v, (int *)(mtx - 0x34));
  CopyVector(g_anSpyroShadowPos, v);
  gz = g_nSpyroGroundHeightZ;
  g_anSpyroShadowPos[2] = gz;
  if (g_bSpyroOtBinBias < 0x7F) {
    g_bSpyroOtBinBias = 5;
  }
  g_nSpyroShadowOtBinBias = 3;
  if (g_anSpyroWorldPos[2] - gz >= 0x365) {
    g_nSpyroShadowOtBinBias = 5;
  }
  g_nSpyroShadowHiddenFlag = 0;
  if (g_anLevelDeathPlaneZTable[g_nLevelIntroIndex] >= gz ||
      *(int *)(mtx + 0x13C) != 0) {
    g_nSpyroShadowHiddenFlag = 1;
  }
  ring = g_anSpyroShadowRingIndexBlock;
  idx = (ring[0] + 1) & 7;
  ring[0] = idx;
  if (probe != 0) {
    mtx = g_anSpyroBodyMtxBlock;
    RotateVectorByMatrix(mtx, idx * 12 + (int)g_anSpyroShadowProbeOffsetTable,
                         v);
    AddVector(v, v, (int *)(mtx - 0x34));
    v[2] += 0x200;
    ground = FindGroundHeightBelow(v, 0x400);
    v[2] -= 0x200;
    flags = (char *)ring - 0x18;
    if ((unsigned int)(v[2] - ground + 0x80) >= 0x100) {
      *(unsigned char *)(g_nSpyroShadowRingIndex + (int)flags) = 1;
    } else {
      *(unsigned char *)(g_nSpyroShadowRingIndex + (int)flags) = 0;
      heights = (char *)ring - 0x20;
      d = (g_anSpyroShadowPos[2] - ground) * 0xC2;
      *(unsigned char *)(g_nSpyroShadowRingIndex + (int)heights) = d / 0x200;
      return;
    }
  } else {
    flags = (char *)ring - 0x18;
    *(unsigned char *)(g_nSpyroShadowRingIndex + (int)flags) = 0;
  }
  heights = (char *)ring - 0x20;
  *(unsigned char *)(g_nSpyroShadowRingIndex + (int)heights) = 0;
}

/* PARK NOTE (2026-07-15-1, 41.6%): blocked by the §Y held-base fold on the
   `lw v0,316(s0)` trigger read (g_anSpyroBodyMtx+0x13C). Root cause now fully
   mechanised by reading gcc 2.7.2 cse.c with RTL dumps:
   - cse_main's path DFS (cse_end_of_basic_block flips TAKEN->NOT_TAKEN and
     reprocesses) means EVERY branch variant of the entry ebb is processed,
     including the all-fallthrough one where the base's const def is visible
     at the read -> find_best_addr's fold_rtx replaces (plus reg 316) with the
     absolute symbol form. No cost check; sized-alias/sdata is irrelevant here.
   - A volatile MEM does NOT protect: find_best_addr's addr_volatile check
     guards volatile ADDRESSES, not volatile mems; the fold runs first anyway.
   - A pointer local (trig = mtx + 0x13C; *trig) gets rewritten by cse1's
     ADDRESS_COST loop (higher-rtx-cost tie-break pulls the (plus) INTO the
     mem), re-exposing it for cse2's fold. Combine can't help (def/use are in
     different basic blocks).
   Same wall as ProbeSpyroLedgeForward (+4). Remaining residue besides this:
   hidden=0 store position (§K load-hoist), flags/ground/heights/d register
   roles (v1/a0/v0/a0 vs a0/a1/a0/v0), li/addu order in the out-of-range arm.

   2026-07-25-1 unattended permuter session (~15m, ~68000 iterations, timed out
   at the 15m budget): best score 625 vs base score 1200. No byte-perfect
   candidate found; still PARKED. NB the "same wall as ProbeSpyroLedgeForward"
   note above: that sibling MATCHED in this same sweep (iteration 212), so the
   cse address-fold wall is not actually impassable — see
   build/permuter/nonmatchings/ProbeSpyroLedgeForward/output-0-1/source.c for
   the shape that beat it, and consider transplanting it here. */
