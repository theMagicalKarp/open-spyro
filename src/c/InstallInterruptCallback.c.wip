#include "globals.h"

/* PSY-Q InterruptCallback: install (param_2 != 0) or uninstall (NULL) a per-IRQ
   callback at g_apfnIrqHandlers[irq]. Toggles the irq bit in the I_MASK shadow
   and the g_nIrqEnableMask enable shadow, inside an I_MASK=0 critical section.
   Special cases: irq 0 (VBlank) also ChangeClearPAD + root-counter 3; irq 4/5/6
   (RCnt0/1/2) also ChangeClearRCnt. Returns the previous callback.
   (0x8005e224, 340 bytes.) */

extern void ChangeClearPAD();
extern void ChangeClearRCnt();
extern unsigned char g_abIrqDispatchBlock[]; /* alias view of g_apfnIrqHandlers */

int InstallInterruptCallback(unsigned int param_1, int param_2) {
  unsigned char *base;
  void **slot;
  void *prev;
  unsigned short imask;
  unsigned short bit;

  base = g_abIrqDispatchBlock;
  slot = (void **)&base[param_1 << 2];
  prev = *slot;
  if ((param_2 != (int)prev) && (*(short *)&base[-4] != 0)) {
    imask = *(unsigned short *)g_pIMaskReg;
    *(unsigned short *)g_pIMaskReg = 0;
    if (param_2 == 0) {
      bit = ~(unsigned short)(1 << param_1);
      *slot = 0;
      imask = imask & bit;
      g_nIrqEnableMask = g_nIrqEnableMask & bit;
    } else {
      *slot = (void *)param_2;
      bit = (unsigned short)(1 << param_1);
      imask = imask | bit;
      *(unsigned short *)&base[0x2c] =
          *(unsigned short *)&base[0x2c] | bit;
    }
    if (param_1 == 0) {
      ChangeClearPAD(param_2 == 0);
      ChangeClearRCnt(3, param_2 == 0);
    }
    if (param_1 == 4) {
      ChangeClearRCnt(0, param_2 == 0);
    }
    if (param_1 == 5) {
      ChangeClearRCnt(1, param_2 == 0);
    }
    if (param_1 == 6) {
      ChangeClearRCnt(2, param_2 == 0);
    }
    *(unsigned short *)g_pIMaskReg = imask;
  }
  return (int)prev;
}

/* PARKED — §B8/§B14 held-base wall. Logic complete. The original holds
   g_apfnIrqHandlers in one reg (a1) across the slot (a1+irq*4),
   g_nLibapiCallbackInstalled (a1-4) and the install-arm g_nIrqEnableMask
   (a1+0x2c); our gcc 2.7.2 re-materializes the base per distinct offset
   (fresh lui each) because no call sits between the accesses to force the
   register — incomplete-array alias and pointer-local both fold per-access
   (+2 insns, overflows the slot). Permuter-or-never. Resuming needs the
   g_abIrqDispatchBlock alias re-added to config/symbol_addrs.txt. */
