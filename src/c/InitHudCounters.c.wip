/* PARK 91.6% (226/226 length-exact, 19 insns; 2026-10-04-2 rework).
 * Residue (one class, F1 local-alloc qty priority): the original loads
 * g_nExtraLives into v1 AFTER the gems array load and keeps the dragon count
 * in v0; ours allocates the short-lived `lives` qty first, it takes v0, the
 * dragon count is pushed to t0 (whole counter batch rotates t0..t3 instead of
 * v0,t0..t2) and sched2 then hoists the lives load above the sll/gems pair.
 * Invariant across: lives load position (3 spellings), direct
 * `g_nHudLivesCachedCount = VOL(g_nExtraLives)`, every volatility combination
 * of the anchor/display/counter/roll/hold/lives/idx groups (128 measured; a
 * non-volatile idx fixes lives->v1 but sinks the idx load below the display
 * stores, 31 linked), and reusing lives/gems/dragons/food as the loop count.
 * What SOLVED the rest (do not re-derive):
 *  - frame 0x38: an unreferenced 8-byte local (`pad[2]`);
 *  - source order of the whole straight-line block is enforced by gcc 2.7.2
 *    true_dependence's "both MEMs volatile" clause: the anchor/display/roll/
 *    hold stores and the idx/counter/lives loads are VOL(); the cached-count
 *    stores must NOT be (else li a3,1 leaves the jal slot, +1 insn);
 *  - anchor = (short *)&g_abHudIconActorRecords[0x196] (not the alias block):
 *    cse turns the volatile anchor stores into anchor-relative addresses that
 *    later fold back to direct `lui at` stores; with the alias symbol the first
 *    volatile store kept a `la` base;
 *  - butterfly loop: its own `dst`/`count` vars (not the copy loop's `rect`),
 *    `x = icon[0]` / `x = icon[1]` temps, and an explicit `size = 8` between
 *    the icon and ring inits (preheader LUID order).
 */
#define VOL(x) (*(volatile __typeof__(x) *)&(x))
#include "globals.h"

/* HUD init for entering a gameplay-with-HUD state (0x80054600, 0x388).

   Wipes the 12 big-icon actor records, then per slot hides the render record,
   seeds its rest position from g_anHudIconRestPos and writes the default
   render bytes (+0x47 scale, +0x49/+0x50 colour, +0x4F flags). Wipes the
   sprite-rect table and copies the 12 digit rest rects into it. Places the
   four fixed HUD anchors, arms all five counter state machines (phase and
   hold timer cleared), snapshots the live gem/dragon/life/egg/butterfly
   counts, and draws the initial digits for the gem, dragon and life counters.

   With `layout_butterflies` set it also clears the world-egg roll request and
   lays the sparx-food butterflies out around icon record 10's screen position
   (records +0x37C/+0x380) using the g_abHudButterflyRingXY ring offsets. */
extern void FillWord(void *dst, unsigned int value, int byte_count);
extern void HideActorRenderRecord(int rec);
extern void CopyVector(int *dst, int *src);
extern void SetHudCounterDigits(int slot, int digits, int value, int flag);

extern short g_anHudIconAnchorBlock[]; /* &g_abHudIconActorRecords[0x196] */

void InitHudCounters(int layout_butterflies) {
  short *anchor;
  int *icon;
  byte *rec;
  int *pos;
  int i;
  int off;
  int vec;
  int rect;
  int ring;
  int food;
  int white;
  int idx;
  int gems;
  int lives;
  int new_var;
  int dragons;
  int worldEggs;
  int levelEggs;
  int count;
  int size;
  int dst;
  int pad[2];
  FillWord(g_abHudIconActorRecords, 0, 0x420);
  i = 0;
  white = 0xFF;
  pos = (int *)(g_abHudIconActorRecords + 0xC);
  rec = g_abHudIconActorRecords;
  off = 0;
  vec = 0;
icon_slot:
  HideActorRenderRecord((int)rec);

  CopyVector(pos, (int *)(((char *)g_anHudIconRestPos) + vec));
  pos = (int *)(((char *)pos) + 0x58);
  rec += 0x58;
  g_abHudIconActorRecords[off + 0x47] = 0x20;
  g_abHudIconActorRecords[off + 0x50] = white;
  g_abHudIconActorRecords[off + 0x49] = white;
  g_abHudIconActorRecords[off + 0x4F] = 0x0B;
  off += 0x58;
  i += 1;
  vec += 0xC;
  if (i < 12) {
    goto icon_slot;
  }
  FillWord(g_anHudSpriteRects, 0, 0x100);
  rect = 0;
  do {
    *((short *)(((char *)g_anHudSpriteRects) + rect)) =
        *((short *)(((char *)g_anHudDigitRestRects) + rect));
    *((short *)((((char *)g_anHudSpriteRects) + rect) + 2)) =
        *((short *)((((char *)g_anHudDigitRestRects) + rect) + 2));
    *((short *)((((char *)g_anHudSpriteRects) + rect) + 4)) =
        *((short *)((((char *)g_anHudDigitRestRects) + rect) + 4));
    *((short *)((((char *)g_anHudSpriteRects) + rect) + 6)) =
        *((short *)((((char *)g_anHudDigitRestRects) + rect) + 6));
    rect += 8;
  } while (rect < 0x60);
  anchor = (short *)&g_abHudIconActorRecords[0x196];
  idx = VOL(g_nLevelIntroIndex);
  VOL(anchor[0]) = 0x1D7;
  VOL(*(short *)&g_abHudIconActorRecords[0x29E]) = 0x1FA;
  VOL(*(short *)&g_abHudIconActorRecords[0x3A6]) = 0x3A;
  VOL(*(short *)&g_abHudIconActorRecords[0x3FE]) = 0xAD;
  VOL(g_abHudIconActorRecords[0x40E]) = 0x40;
  VOL(g_abHudCounterDisplayState[0]) = 1;
  VOL(g_abHudCounterDisplayState[1]) = 1;
  VOL(g_abHudCounterDisplayState[2]) = 1;
  VOL(g_abHudCounterDisplayState[3]) = 1;
  VOL(g_abHudCounterDisplayState[4]) = 1;
  dragons = VOL(g_nWorldDragonsRescued);
  worldEggs = VOL(g_nWorldEggsRecovered);
  levelEggs = VOL(g_nLevelEggCount);
  food = VOL(g_nSparxFoodCount);
  VOL(g_bHudLevelGemRollPhase) = 0;
  VOL(g_bHudDragonRollPhase) = 0;
  VOL(g_bHudLivesRollPhase) = 0;
  VOL(g_bHudWorldEggRollPhase) = 0;
  VOL(g_bHudLevelEggRollPhase) = 0;
  VOL(g_nHudLevelGemHoldTimer) = 0;
  VOL(g_nHudDragonHoldTimer) = 0;
  VOL(g_nHudLivesHoldTimer) = 0;
  VOL(g_nHudWorldEggHoldTimer) = 0;
  VOL(g_nHudLevelEggHoldTimer) = 0;
  gems = g_anLevelGemsCollected[idx];
  lives = VOL(g_nExtraLives);
  g_nHudDragonCachedCount = dragons;
  g_nHudWorldEggCachedCount = worldEggs;
  g_nHudLevelEggCachedCount = levelEggs;
  g_nHudButterflyCachedCount = food;
  g_nHudLivesCachedCount = lives;
  g_nHudLevelGemCachedCount = gems;
  SetHudCounterDigits(0, 4, gems, 1);
  SetHudCounterDigits(5, 2, g_nHudDragonCachedCount, 1);
  SetHudCounterDigits(8, 2, g_nHudLivesCachedCount, 1);
  if (layout_butterflies != 0) {
    g_nHudWorldEggRollRequest = 0;
    i = 0;
    count = g_nSparxFoodCount;
    if (count > 0) {
      icon = (int *)(anchor + 0xF3);
      size = 8;
      ring = 0;
      dst = 0x60;
      do {
        int x = icon[0];
        i += 1;
        *((short *)(((char *)g_anHudSpriteRects) + dst)) =
            (g_abHudButterflyRingXY[ring] + x) - 0x1D;
        x = icon[1];
        new_var = (g_abHudButterflyRingXY[ring + 1] + x) - 0x1C;
        *((short *)((((char *)g_anHudSpriteRects) + dst) + 4)) = size;
        *((short *)((((char *)g_anHudSpriteRects) + dst) + 6)) = size;
        *((short *)((((char *)g_anHudSpriteRects) + dst) + 2)) = new_var;
        ring += 2;
        dst += 8;
      } while (i < count);
    }
  }
}
